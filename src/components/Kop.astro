---
// Bovenbalk met de beloftes, daaronder een zwevende witte menubalk die meescrolt. Op de homepage schuift de hero er
// onder door, zodat de foto tot bovenaan het scherm loopt.
import { url, waHoi, site } from '../data/site';
import { groepen, categorieHref, eersteFoto, opWit, breedtes } from '../data/catalogus';
import { Image } from 'astro:assets';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';

interface Props { onderbalk?: boolean }
const { onderbalk = true } = Astro.props;
const pad = Astro.url.pathname;
const actief = (p: string) => pad.startsWith(url(p));
const nav: [string, string][] = [[url('collecties/'), 'Collecties'], [url('maatwerk/'), 'Maatwerk'], [url('over-ons/'), 'Over ons'], [url('contact/'), 'Contact']];
// Liefst een vrijstaande foto (op wit); anders de eerste sfeerfoto, zodat geen categorie een leeg vak krijgt.
const omslag = (g: (typeof groepen)[number]) => g.hoofd.foto ?? g.producten.map(eersteFoto).find((f) => f && opWit(f)) ?? g.producten.map(eersteFoto).find(Boolean);
---
<div class="bg-nacht text-as">
  <div class="wrap flex h-9 items-center justify-between gap-6 text-xs font-semibold">
    <ul class="flex min-w-0 items-center gap-x-7 overflow-hidden">
      {site.usps.map((u, i) => (
        <li class={`flex flex-none items-center gap-2 ${i ? 'max-md:hidden' : ''}`}><Icoon naam="vink" class="h-3.5 w-3.5 text-blad-licht" /><span class="text-wit">{u}</span></li>
      ))}
    </ul>
    <a href={site.telHref} class="num flex flex-none items-center gap-2 text-wit no-underline hover:text-blad-licht max-sm:hidden"><Icoon naam="tel" class="h-3.5 w-3.5" />{site.tel}</a>
  </div>
</div>

<header class="sticky top-0 z-40 px-3 pt-3 md:px-6" data-kop>
  <div class="relative mx-auto flex h-16 max-w-[82rem] items-center justify-between gap-3 rounded-full bg-wit/95 pl-2 pr-2 shadow-kaart ring-1 ring-lijn backdrop-blur-md lg:h-[4.5rem] lg:pl-3">
    <div class="flex min-w-0 items-center gap-3">
      <Merk />
      <span class="font-kop text-[.95rem] font-extrabold leading-none tracking-tight [font-stretch:112%] max-[379px]:hidden">Teakhuis<span class="mt-1 block text-[.68rem] font-semibold tracking-[.12em] text-grijs uppercase">Teak op maat</span></span>
    </div>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex items-center gap-1 font-kop text-[.95rem] font-bold [font-stretch:105%]">
        <li data-mega-li>
          <button type="button" class={`flex items-center gap-1.5 whitespace-nowrap rounded-full px-3 py-2.5 transition-colors hover:bg-zand xl:px-4 ${actief('collectie/') || actief('product/') ? 'bg-zand' : ''}`} aria-expanded="false" aria-controls="mega" data-mega-knop>
            Producten
            <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 text-grijs transition-transform" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>
        </li>
        {nav.map(([href, t]) => {
          const aan = actief(href.replace(url(''), ''));
          return <li><a href={href} class={`block whitespace-nowrap rounded-full px-3 py-2.5 no-underline transition-colors hover:bg-zand xl:px-4 ${aan ? 'bg-zand' : ''}`} aria-current={aan ? 'page' : undefined}>{t}</a></li>;
        })}
      </ul>
    </nav>
    <div class="flex flex-none items-center gap-1.5">
      <a href={url('collectie/#zoeken')} class="grid h-11 w-11 place-items-center rounded-full text-inkt transition-colors hover:bg-zand max-sm:hidden" aria-label="Zoeken in de collectie">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
      </a>
      <a href={url('offerte/')} class="relative grid h-11 w-11 place-items-center rounded-full text-inkt ring-1 ring-lijn transition-colors hover:bg-zand" data-offerte-link>
        <Icoon naam="lijst" class="h-5 w-5" />
        <span class="sr-only">Mijn offerteaanvraag</span>
        <span class="num absolute -right-1 -top-1 grid h-5 min-w-5 place-items-center rounded-full bg-blad px-1 text-[.7rem] font-extrabold text-inkt ring-2 ring-wit" data-offerte-teller hidden>0</span>
        <span class="sr-only" data-offerte-sr></span>
      </a>
      <a href={site.telHref} class="knop min-h-11 px-4 text-sm ring-1 ring-lijn hover:bg-zand max-xl:hidden"><Icoon naam="tel" /><span class="num">{site.tel}</span></a>
      <a href={url('collectie/')} class="knop knop-blad min-h-11 px-5 text-sm max-md:hidden lg:max-xl:hidden">Kies je meubel</a>
      <button type="button" class="flex h-11 items-center gap-2 rounded-full bg-nacht px-4 font-kop text-sm font-bold text-wit lg:hidden" aria-expanded="false" aria-controls="menu-nav" data-menu-knop>
        <svg viewBox="0 0 24 24" class="h-[1.1rem] w-[1.1rem]" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <span class="max-[379px]:sr-only">Menu</span>
      </button>
    </div>

    <!-- Megamenu (desktop): categorieen met foto en soorten -->
    <div id="mega" class="absolute inset-x-0 top-full mt-3 overflow-hidden rounded-[var(--radius-xl)] bg-wit shadow-kaart ring-1 ring-lijn" hidden data-mega>
      <div class="grid grid-cols-12">
        <div class="col-span-9 grid grid-cols-4 gap-x-6 gap-y-6 p-7">
          {groepen.map((g) => {
            const f = omslag(g);
            return (
              <div>
                <a href={categorieHref(g.hoofd)} class="group flex items-center gap-3 no-underline">
                  <span class="grid h-12 w-12 flex-none place-items-center overflow-hidden rounded-[var(--radius-sm)] bg-zand">
                    {f && <Image src={f} alt="" widths={breedtes(f, [96])} sizes="48px" quality={60} class={`h-full w-full ${opWit(f) ? 'object-contain p-1 mix-blend-multiply' : 'object-cover'}`} />}
                  </span>
                  <span class="font-kop text-[.95rem] font-extrabold leading-tight group-hover:text-blad-diep">{g.hoofd.naam}</span>
                </a>
                {g.subs.length > 0 && (
                  <ul class="mt-2 space-y-0.5 pl-[3.75rem] text-sm">
                    {g.subs.slice(0, 5).map((s) => <li><a href={categorieHref(s.cat)} class="text-grijs no-underline hover:text-inkt">{s.cat.naam}</a></li>)}
                    {g.subs.length > 5 && <li><a href={categorieHref(g.hoofd)} class="font-bold text-blad-diep no-underline hover:underline">Alles bekijken</a></li>}
                  </ul>
                )}
              </div>
            );
          })}
        </div>
        <div class="col-span-3 flex flex-col justify-between bg-nacht p-7 text-wit">
          <div>
            <p class="label text-blad-licht">Op maat</p>
            <p class="mt-3 font-kop text-2xl font-extrabold leading-tight">Staat het er niet tussen? Wij tekenen het voor je.</p>
          </div>
          <div class="mt-8 grid gap-2">
            <a href={url('maatwerk/')} class="knop knop-blad w-full">Maatwerk aanvragen</a>
            <a href={url('collectie/')} class="knop knop-glas w-full">Alle producten</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Menu (mobiel en tablet) -->
  <nav id="menu-nav" aria-label="Menu" class="mx-auto mt-2 max-h-[calc(100dvh-11rem)] max-w-[82rem] md:max-h-[calc(100dvh-6.5rem)] overflow-y-auto rounded-[var(--radius-xl)] bg-wit p-4 shadow-kaart ring-1 ring-lijn lg:hidden" hidden data-menu>
    <form action={url('collectie/')} role="search" class="relative mb-2">
      <label for="menu-zoek" class="sr-only">Zoek in de collectie</label>
      <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-grijs" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
      <input id="menu-zoek" name="q" type="search" enterkeyhint="search" autocomplete="off" placeholder="Zoek een meubel, bijv. eettafel" class="veld pl-12" />
    </form>
    <details class="group border-b border-lijn" open>
      <summary class="flex cursor-pointer list-none items-center justify-between py-3 font-kop text-xl font-extrabold [&::-webkit-details-marker]:hidden">
        <span>Producten <span class="ml-1 font-sans text-sm font-normal text-grijs">{groepen.length} categorieën</span></span>
        <span class="grid h-8 w-8 place-items-center rounded-full ring-1 ring-lijn transition-transform group-open:rotate-180"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></span>
      </summary>
      <ul class="grid grid-cols-2 gap-x-3 pb-4">
        {groepen.map((g) => <li class="min-w-0"><a href={categorieHref(g.hoofd)} class="block py-2 text-[.9375rem] font-semibold text-inkt no-underline hyphens-auto" lang="nl">{g.hoofd.naam}</a></li>)}
        <li class="col-span-2 pt-1"><a href={url('collectie/')} class="font-bold text-blad-diep underline">Alle producten</a></li>
      </ul>
    </details>
    <ul class="font-kop text-xl font-extrabold">
      {nav.map(([href, t]) => <li class="border-b border-lijn"><a href={href} class="block py-3 text-inkt no-underline">{t}</a></li>)}
      <li class="border-b border-lijn"><a href={url('offerte/')} class="block py-3 text-inkt no-underline">Mijn offerte</a></li>
    </ul>
    <div class="mt-4 grid gap-2 sm:grid-cols-2">
      <a href={waHoi} class="knop knop-blad"><Icoon naam="wa" />WhatsApp</a>
      <a href={site.telHref} class="knop ring-1 ring-lijn-2"><Icoon naam="tel" /><span class="num">{site.tel}</span></a>
    </div>
  </nav>
</header>

<!-- Onderbalk op mobiel: bellen en appen altijd binnen bereik -->
{onderbalk && <div class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-2 gap-2 border-t border-lijn bg-wit/95 p-2 pb-[max(.5rem,env(safe-area-inset-bottom))] backdrop-blur-sm md:hidden">
  <a href={site.telHref} class="knop min-h-11 text-sm ring-1 ring-lijn-2"><Icoon naam="tel" />Bellen</a>
  <a href={waHoi} class="knop knop-blad min-h-11 text-sm"><Icoon naam="wa" />WhatsApp</a>
</div>}

<script>
  import { aantal, opWijziging } from '../scripts/offerte';

  // Teller in de offerte-knop, ook bijgewerkt als je in een ander tabblad iets toevoegt.
  const teller = document.querySelector<HTMLElement>('[data-offerte-teller]');
  const sr = document.querySelector<HTMLElement>('[data-offerte-sr]');
  const zet = () => {
    const n = aantal();
    if (teller) { teller.textContent = String(n); teller.hidden = n === 0; }
    if (sr) sr.textContent = n ? `, ${n} ${n === 1 ? 'product' : 'producten'}` : '';
  };
  zet();
  opWijziging(zet);

  // Mobiel menu
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    const zetMenu = (o: boolean) => { k.setAttribute('aria-expanded', String(o)); m.hidden = !o; };
    k.addEventListener('click', () => zetMenu(k.getAttribute('aria-expanded') !== 'true'));
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => zetMenu(false)));
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && !m.hidden) { zetMenu(false); k.focus(); } });
  }

  // Megamenu: opent bij hover (met korte vertraging) en bij klik/Enter; Escape of klik erbuiten sluit.
  const knop = document.querySelector<HTMLButtonElement>('[data-mega-knop]');
  const mega = document.querySelector<HTMLElement>('[data-mega]');
  const li = document.querySelector<HTMLElement>('[data-mega-li]');
  if (knop && mega && li) {
    let t: number | undefined;
    const open = (o: boolean) => {
      knop.setAttribute('aria-expanded', String(o));
      mega.hidden = !o;
      knop.querySelector('svg')!.style.transform = o ? 'rotate(180deg)' : '';
    };
    knop.addEventListener('click', () => open(mega.hidden));
    const fijn = matchMedia('(hover: hover)');
    [li, mega].forEach((el) => {
      el.addEventListener('mouseenter', () => { if (!fijn.matches) return; clearTimeout(t); t = window.setTimeout(() => open(true), 80); });
      el.addEventListener('mouseleave', () => { if (!fijn.matches) return; clearTimeout(t); t = window.setTimeout(() => open(false), 220); });
    });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && !mega.hidden) { open(false); knop.focus(); } });
    document.addEventListener('click', (e) => { if (!mega.hidden && !mega.contains(e.target as Node) && !knop.contains(e.target as Node)) open(false); });
  }
</script>
