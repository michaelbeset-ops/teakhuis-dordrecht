---
// Kop voor de informatiepagina's (Maatwerk, Over ons, Duurzaam, Contact), in dezelfde opzet als de homepage: links de
// tekst op een effen vlak, rechts de sfeerfoto, altijd helemaal zichtbaar (nooit bijgesneden, ingezoomd of vervaagd).
// Op verzoek van Han (nov 2026): de groene regel is de belangrijkste en dus groot, de titel eronder iets kleiner.
// Op mobiel staat de foto boven de tekst.
import { Image } from 'astro:assets';
import { breedte, hoogte, breedtes } from '../data/catalogus';
interface Props { foto: ImageMetadata; pos?: string; label: string; titel: string; id: string }
const { foto, label, titel, id } = Astro.props;
---
<section class="relative -mt-[4.75rem] bg-nacht text-wit lg:-mt-[5.25rem]" aria-labelledby={id}>
  <div class="pt-[4.75rem] lg:grid lg:grid-cols-12 lg:items-center lg:pb-10 lg:pt-[6.75rem]">
    <div class="relative w-full bg-nacht lg:order-2 lg:col-span-7" style={`aspect-ratio: ${breedte(foto)} / ${hoogte(foto)}`} aria-hidden="true">
      <Image src={foto} alt="" quality={90} widths={breedtes(foto, [828, 1280, 1680, 2200, 2880, 3840])} sizes="(min-width: 1024px) 58vw, 100vw" loading="eager" fetchpriority="high" class="h-full w-full object-contain" />
    </div>
    <div class="px-5 pb-12 pt-8 md:px-10 lg:order-1 lg:col-span-5 lg:py-8 lg:pl-[max(2.5rem,calc((100vw-84rem)/2+2.5rem))] lg:pr-12">
      <p class="hero-op font-kop text-[clamp(1.6rem,2.2vw,2.4rem)] font-extrabold leading-[1.08] text-blad-licht">{label}</p>
      <h1 id={id} class="hero-op mt-3 text-[clamp(1.5rem,2.4vw,2.3rem)] font-semibold leading-[1.1] [font-stretch:100%]" style="--d:.08s">{titel}</h1>
      <div class="hero-op" style="--d:.18s"><slot /></div>
    </div>
  </div>
</section>
