---
// Kop met grote sfeerfoto voor de informatiepagina's (Maatwerk, Over ons, Duurzaam, Contact), zodat die dezelfde sfeer
// hebben. Op verzoek van Han (nov 2026): de groene regel is de belangrijkste en dus groot, de titel eronder iets kleiner.
// De foto is altijd helemaal zichtbaar (nooit bijgesneden of ingezoomd); een vage versie van de foto vult de rest.
// Op een groot scherm staat de foto onder de zwevende menubalk en loopt de tekst er links overheen; op mobiel eronder.
// De donkere laag over de foto gebruikt de kleur 'nacht' en is gemarkeerd met data-tint (zie de sfeer in global.css).
import { Image, getImage } from 'astro:assets';
import { breedtes } from '../data/catalogus';
interface Props { foto: ImageMetadata; pos?: string; label: string; titel: string; id: string }
const { foto, label, titel, id } = Astro.props;
const vaag = (await getImage({ src: foto, width: 64, quality: 40, format: 'webp' })).src;
---
<section class="relative -mt-[4.75rem] flex flex-col overflow-hidden bg-nacht text-wit lg:-mt-[5.25rem] lg:min-h-[78svh] lg:justify-end" aria-labelledby={id}>
  <div class="relative mt-[4.75rem] aspect-[3/2] w-full overflow-hidden lg:absolute lg:inset-x-0 lg:bottom-0 lg:top-[5.75rem] lg:mt-0 lg:aspect-auto" aria-hidden="true">
    <img src={vaag} alt="" decoding="async" class="absolute inset-0 h-full w-full scale-110 object-cover opacity-70 blur-2xl" />
    <Image src={foto} alt="" quality={90} widths={breedtes(foto, [828, 1280, 1680, 2200, 2880, 3840])} sizes="(min-width: 1024px) 90vw, 100vw" loading="eager" fetchpriority="high" class="relative h-full w-full object-contain lg:object-right" />
  </div>
  <div aria-hidden="true" data-tint class="absolute inset-0 bg-gradient-to-t from-nacht/90 via-nacht/20 to-transparent max-lg:hidden"></div>
  <div aria-hidden="true" data-tint class="absolute inset-0 bg-gradient-to-r from-nacht/80 via-nacht/30 to-transparent max-lg:hidden"></div>
  <div class="wrap relative pb-12 pt-8 lg:pb-16 lg:pt-36">
    <p class="hero-op max-w-[26ch] font-kop text-[clamp(1.6rem,3vw,2.8rem)] font-extrabold leading-[1.08] text-blad-licht">{label}</p>
    <h1 id={id} class="hero-op mt-3 max-w-[20ch] text-[clamp(1.5rem,2.4vw,2.3rem)] font-semibold leading-[1.1] [font-stretch:100%]" style="--d:.08s">{titel}</h1>
    <div class="hero-op" style="--d:.18s"><slot /></div>
  </div>
</section>
