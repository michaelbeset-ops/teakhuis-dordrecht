---
import { site, url, waHoi } from '../data/site';
import { groepen, categorieHref } from '../data/catalogus';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-nacht text-as">
  <div class="wrap grid gap-x-10 gap-y-12 pb-14 pt-16 text-sm md:grid-cols-12 md:pt-24">
    <div class="md:col-span-4">
      <Merk klein />
      <p class="mt-6 max-w-xs font-kop text-2xl leading-snug text-wit">Teakhouten meubels, met de hand gemaakt en op jouw maat.</p>
      <div class="mt-7 flex gap-2">
        <a href={site.facebook} class="grid h-10 w-10 place-items-center rounded-full border border-lijn-d text-wit transition-colors hover:border-blad-licht hover:text-blad-licht" aria-label="Teakhuis op Facebook"><Icoon naam="fb" class="h-5 w-5" /></a>
        <a href={site.instagram} class="grid h-10 w-10 place-items-center rounded-full border border-lijn-d text-wit transition-colors hover:border-blad-licht hover:text-blad-licht" aria-label="Teakhuis op Instagram"><Icoon naam="insta" class="h-5 w-5" /></a>
      </div>
    </div>
    <div class="md:col-span-4">
      <p class="font-bold text-wit"><a href={url('collectie/')} class="no-underline hover:text-blad-licht">Collectie</a></p>
      <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2">
        {groepen.map((g) => <li class="min-w-0"><a href={categorieHref(g.hoofd)} class="break-words no-underline transition-colors hover:text-wit [hyphens:auto]" lang="nl">{g.hoofd.naam}</a></li>)}
      </ul>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Teakhuis</p>
      <ul class="mt-4 space-y-2">
        <li><a href={url('maatwerk/')} class="no-underline transition-colors hover:text-wit">Maatwerk</a></li>
        <li><a href={url('over-ons/')} class="no-underline transition-colors hover:text-wit">Over ons</a></li>
        <li><a href={url('contact/')} class="no-underline transition-colors hover:text-wit">Contact</a></li>
        <li><a href={url('offerte/')} class="no-underline transition-colors hover:text-wit">Mijn offerte</a></li>
      </ul>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num no-underline transition-colors hover:text-wit">{site.tel}</a></li>
        <li><a href={waHoi} class="no-underline transition-colors hover:text-wit">WhatsApp</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline transition-colors hover:text-wit">{site.mail}</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-d py-7 text-xs">
    <p>© {jaar} {site.bv}{site.kvk && <> · KvK {site.kvk}</>}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-1"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><a href="https://www.sitefront.nl" class="no-underline hover:text-wit">Website door Sitefront</a></p>
  </div>
</footer>
