---
// Maattekening op de productpagina: laat zien wat breedte, diepte en hoogte op het meubel zijn. De getallen ernaast
// volgen de gekozen maat (of de eigen maat) via het script van de productpagina (data-mt="b|d|h").
// Baymard: twijfel over afmetingen is bij meubels de belangrijkste reden om af te haken.
export type Soort = 'tafel' | 'kast' | 'zit' | 'bed';
interface Props { soort: Soort }
const { soort } = Astro.props;

// Schuine projectie: voorvlak recht, diepte 44 naar rechts en 30 omhoog.
const vormen: Record<Soort, { lijnen: string; zacht?: string; b: number[]; h: number[]; d: number[] }> = {
  kast: {
    lijnen: 'M50 55h150v110H50zM50 55l44-30h150l-44 30M200 165l44-30V25M125 55v110',
    zacht: 'M118 104v12M132 104v12',
    b: [50, 200, 182], h: [55, 165, 34], d: [208, 173],
  },
  tafel: {
    lijnen: 'M50 70h150v10H50zM50 70l44-30h150l-44 30M200 80l44-30V40M56 80h8v85h-8zM186 80h8v85h-8zM230 50h8v85h-8z',
    b: [50, 200, 182], h: [70, 165, 34], d: [208, 173],
  },
  zit: {
    lijnen: 'M94 30h150v45H94zM50 105h150v35H50zM50 105l44-30M200 105l44-30M200 140l44-30V75M54 140h8v18h-8zM188 140h8v18h-8z',
    b: [50, 200, 176], h: [30, 158, 34], d: [208, 167],
  },
  bed: {
    lijnen: 'M84 45h170v50H84zM40 125h170v25H40zM40 125l44-30M210 125l44-30M210 150l44-30V95',
    zacht: 'M52 121l36-24h150',
    b: [40, 210, 168], h: [45, 150, 24], d: [218, 160],
  },
};
const v = vormen[soort];
const [bx1, bx2, by] = v.b;
const [hy1, hy2, hx] = v.h;
const [dx, dy] = v.d;
const label = (x: number, y: number, t: string) => ({ x, y, t });
const labels = [label((bx1 + bx2) / 2, by, 'B'), label(hx, (hy1 + hy2) / 2, 'H'), label(dx + 22, dy - 15, 'D')];
---
<div class="mt-3 flex items-center gap-4 rounded-[var(--radius-md)] border border-lijn bg-wit p-3 sm:gap-5 sm:p-4" data-maattekening>
  <svg viewBox="0 0 290 195" class="w-36 flex-none sm:w-48" role="img" aria-label="Tekening: wat breedte (B), diepte (D) en hoogte (H) zijn op dit meubel">
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" class="text-inkt">
      <path d={v.lijnen} />
      {v.zacht && <path d={v.zacht} class="opacity-35" />}
    </g>
    <g fill="none" stroke="#36641a" stroke-width="1.5">
      <path d={`M${bx1} ${by}H${bx2}M${bx1} ${by - 5}v10M${bx2} ${by - 5}v10`} />
      <path d={`M${hx} ${hy1}V${hy2}M${hx - 5} ${hy1}h10M${hx - 5} ${hy2}h10`} />
      <path d={`M${dx} ${dy}l44-30M${dx - 4} ${dy - 5}l8 10M${dx + 40} ${dy - 35}l8 10`} />
    </g>
    {labels.map((l) => (
      <g>
        <circle cx={l.x} cy={l.y} r="12" fill="#36641a" />
        <text x={l.x} y={l.y + 4.5} text-anchor="middle" fill="#fff" font-size="13" font-weight="800" font-family="Archivo Variable, sans-serif">{l.t}</text>
      </g>
    ))}
  </svg>
  <div class="min-w-0">
    <dl class="grid grid-cols-[auto_1fr] items-baseline gap-x-3 gap-y-1.5 text-sm">
      <dt class="text-grijs"><b class="text-blad-diep">B</b> Breedte</dt><dd class="num font-bold" data-mt="b">-</dd>
      <dt class="text-grijs"><b class="text-blad-diep">D</b> Diepte</dt><dd class="num font-bold" data-mt="d">-</dd>
      <dt class="text-grijs"><b class="text-blad-diep">H</b> Hoogte</dt><dd class="num font-bold" data-mt="h">-</dd>
    </dl>
    <p class="mt-2 text-xs text-grijs" data-mt-leeg hidden></p>
  </div>
</div>
