---
// Eén review als rustige kaart: bron (Google of klant), de tekst, en wie het schreef. Gebruikt op de productpagina en Over ons.
import { site, type Review } from '../data/site';
interface Props { review: Review; class?: string }
const { review, class: klas = '' } = Astro.props;
const initialen = (n: string) => (n.match(/\b\p{Lu}/gu) ?? [n[0]]).slice(0, 2).join('');
---
<figure class={`flex flex-col rounded-[var(--radius-xl)] bg-wit p-5 ring-1 ring-lijn ${klas}`}>
  <div class="flex items-center justify-between gap-3 text-xs font-bold text-grijs">
    {review.bron === 'google'
      ? <span class="flex items-center gap-1.5"><svg viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true"><path fill="#4285F4" d="M22.6 12.2c0-.8-.1-1.5-.2-2.2H12v4.2h5.9a5 5 0 0 1-2.2 3.3v2.7h3.6c2.1-1.9 3.3-4.8 3.3-8Z"/><path fill="#34A853" d="M12 23c3 0 5.5-1 7.3-2.7l-3.6-2.8c-1 .7-2.2 1.1-3.7 1.1-2.9 0-5.3-1.9-6.2-4.5H2.1v2.8A11 11 0 0 0 12 23Z"/><path fill="#FBBC05" d="M5.8 14.1a6.6 6.6 0 0 1 0-4.2V7.1H2.1a11 11 0 0 0 0 9.8l3.7-2.8Z"/><path fill="#EA4335" d="M12 5.4c1.6 0 3.1.6 4.2 1.7l3.2-3.2A11 11 0 0 0 2.1 7.1l3.7 2.8C6.7 7.3 9.1 5.4 12 5.4Z"/></svg>Review op Google</span>
      : <span>Ervaring van een klant</span>}
    {review.sterren ? <span class="text-[#f4b400]" aria-label={`${review.sterren} van 5 sterren`}>{'★'.repeat(review.sterren)}</span> : null}
  </div>
  <blockquote class="mt-3 flex-1 text-[.95rem] leading-relaxed text-inkt">“{review.tekst}”</blockquote>
  <figcaption class="mt-4 flex min-h-[3.75rem] items-center gap-3 border-t border-lijn pt-4 text-sm">
    <span class="grid h-9 w-9 flex-none place-items-center rounded-full bg-zand text-xs font-extrabold text-blad-diep">{initialen(review.naam)}</span>
    <span class="min-w-0 flex-1"><span class="block font-bold">{review.naam}</span>{review.over && <span class="block text-xs text-grijs">Over een {review.over}</span>}</span>
    {review.bron === 'google' && <a href={site.google} target="_blank" class="text-xs font-bold text-blad-diep underline underline-offset-2" rel="noopener">Bekijk op Google</a>}
  </figcaption>
</figure>
