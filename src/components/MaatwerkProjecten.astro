---
// Eigen maatwerkprojecten van Teakhuis: sleep van de tekening voor de werkplaats naar het meubel dat ervan gemaakt is.
// De schuif is een gewone range-input (toetsenbord, schermlezer), met de tekening als bovenste laag die wordt afgeknipt.
import { Image } from 'astro:assets';
const mwFotos = import.meta.glob<{ default: ImageMetadata }>('../assets/mw-*.jpg', { eager: true });
const mw = (n: string) => mwFotos[`../assets/mw-${n}.jpg`].default;
const projecten = [
  { id: 'kledingkast', naam: 'Kledingkast', maat: 'binnenkant met hang- en leggedeelte, lades op metalen rails', pos: 'object-[50%_35%]' },
  { id: 'tv', naam: 'Tv-meubel', maat: '210 cm, drie lades op metalen rails, smoke white', pos: 'object-[50%_50%]' },
  { id: 'wand', naam: 'Wandmeubel', maat: 'lage kast van 216 cm met hoge kast van 114 cm', pos: 'object-[60%_50%]' },
  { id: 'bureau', naam: 'Hoekbureau', maat: 'vier delen, 220 en 180 cm', pos: 'object-[50%_55%]' },
];
---
<div data-mw>
  <div class="rijs mt-12" style="--d:.1s">
    <div role="tablist" aria-label="Maatwerkprojecten" class="flex gap-x-5 overflow-x-auto border-b border-lijn-2 [scrollbar-width:none] md:gap-x-8">
      {projecten.map((p, i) => (
        <button type="button" role="tab" id={`tab-${p.id}`} aria-controls={`paneel-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="-mb-px flex-none whitespace-nowrap border-b-2 border-transparent py-3 font-kop text-lg text-grijs transition-colors hover:text-inkt aria-selected:border-blad aria-selected:text-inkt md:text-xl" data-tab={p.id}>{p.naam}</button>
      ))}
    </div>
    {projecten.map((p, i) => (
      <div role="tabpanel" id={`paneel-${p.id}`} aria-labelledby={`tab-${p.id}`} class={`mt-8 ${i ? 'hidden' : ''}`} data-paneel={p.id}>
        <figure class="grid gap-6 lg:grid-cols-12 lg:items-center lg:gap-12">
          <div class="vergelijk relative aspect-[4/3] overflow-hidden rounded-[var(--radius-md)] bg-wit lg:col-span-8" style="--pos:50%" data-vergelijk>
            <Image src={mw(`${p.id}-meubel`)} alt={`De ${p.naam.toLowerCase()} van teak, gemaakt naar de tekening`} quality={76} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1344px) 820px, (min-width: 1024px) 62vw, 92vw" loading="lazy" class={`absolute inset-0 h-full w-full object-cover ${p.pos}`} />
            <div class="vergelijk-boven absolute inset-0 bg-wit" aria-hidden="true">
              <Image src={mw(`${p.id}-tekening`)} alt="" quality={78} widths={[640, 960, 1280]} sizes="(min-width: 1344px) 820px, (min-width: 1024px) 62vw, 92vw" loading="lazy" class="h-full w-full object-contain p-4 md:p-8" />
            </div>
            <span class="pointer-events-none absolute left-3 top-3 rounded-full bg-inkt/80 px-3 py-1 text-xs font-bold text-wit backdrop-blur-sm" aria-hidden="true">Tekening</span>
            <span class="pointer-events-none absolute right-3 top-3 rounded-full bg-blad px-3 py-1 text-xs font-bold text-inkt" aria-hidden="true">Het meubel</span>
            <div class="vergelijk-lijn pointer-events-none absolute inset-y-0" aria-hidden="true">
              <span class="vergelijk-greep"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6-6 6 6 6M15 6l6 6-6 6" /></svg></span>
            </div>
            <input type="range" min="0" max="100" value="50" step="1" class="vergelijk-schuif absolute inset-0 h-full w-full cursor-ew-resize opacity-0" aria-label={`Schuif van de tekening naar het meubel: ${p.naam.toLowerCase()}`} data-schuif />
          </div>
          <figcaption class="lg:col-span-4">
            <p class="flex items-center gap-2 text-sm font-semibold text-blad-diep"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6-6 6 6 6M15 6l6 6-6 6" /></svg>Sleep van tekening naar meubel</p>
            <p class="mt-3 font-kop text-2xl">{p.naam}</p>
            <p class="mt-2 text-grijs">{p.maat.charAt(0).toUpperCase() + p.maat.slice(1)}.</p>
            <p class="mt-4 text-sm text-grijs">Eerst tekenen we het meubel met jouw maten. Klopt alles, dan maken onze vakmensen het precies zo.</p>
          </figcaption>
        </figure>
      </div>
    ))}
  </div>
</div>

<script>
  // Tabs (pijltjestoetsen) en de vergelijkschuif. De eerste keer in beeld schuift de greep even heen en weer,
  // zodat duidelijk is dat je eraan kunt trekken (niet bij "minder beweging").
  document.querySelectorAll<HTMLElement>('[data-mw]').forEach((mwSec) => {
    const tabs = [...mwSec.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const kies = (t: HTMLButtonElement) => {
      tabs.forEach((b) => { const aan = b === t; b.setAttribute('aria-selected', String(aan)); b.tabIndex = aan ? 0 : -1; mwSec.querySelector(`[data-paneel="${b.dataset.tab}"]`)!.classList.toggle('hidden', !aan); });
    };
    tabs.forEach((b, i) => {
      b.addEventListener('click', () => kies(b));
      b.addEventListener('keydown', (e) => { const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0; if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; kies(n); n.focus(); } });
    });

    const rustig = matchMedia('(prefers-reduced-motion: reduce)').matches;
    mwSec.querySelectorAll<HTMLElement>('[data-vergelijk]').forEach((v) => {
      const s = v.querySelector<HTMLInputElement>('[data-schuif]')!;
      const zet = (n: number) => v.style.setProperty('--pos', `${n}%`);
      let aangeraakt = false;
      s.addEventListener('input', () => { aangeraakt = true; v.classList.remove('hint'); zet(+s.value); });
      if (rustig) return;
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        if (aangeraakt) return;
        // Korte uitleg-beweging: 50 -> 72 -> 30 -> 50 procent.
        const stappen = [50, 72, 30, 50];
        const t0 = performance.now(), duur = 2200;
        const tik = (t: number) => {
          if (aangeraakt) return;
          const f = Math.min(1, (t - t0) / duur), seg = f * (stappen.length - 1), k = Math.floor(seg), r = seg - k;
          const a = stappen[k], z = stappen[Math.min(k + 1, stappen.length - 1)];
          const n = a + (z - a) * (0.5 - Math.cos(r * Math.PI) / 2);
          zet(n); s.value = String(Math.round(n));
          if (f < 1) requestAnimationFrame(tik);
        };
        setTimeout(() => requestAnimationFrame(tik), 500);
      }, { threshold: 0.6 });
      io.observe(v);
    });
  });
</script>

<style>
  .vergelijk-boven { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .vergelijk-lijn { left: var(--pos); width: 2px; margin-left: -1px; background: #fff; box-shadow: 0 0 0 1px rgb(23 32 27 / .15); }
  .vergelijk-greep {
    position: absolute; top: 50%; left: 50%; display: grid; place-items: center; width: 2.75rem; height: 2.75rem;
    transform: translate(-50%, -50%); border-radius: 999px; background: #fff; color: var(--color-inkt);
    box-shadow: 0 6px 20px -6px rgb(23 32 27 / .45); transition: transform .2s;
  }
  .vergelijk:hover .vergelijk-greep, .vergelijk:has(.vergelijk-schuif:focus-visible) .vergelijk-greep { transform: translate(-50%, -50%) scale(1.08); }
  /* Verticaal scrollen over de foto blijft werken op telefoons; alleen horizontaal slepen bedient de schuif. */
  .vergelijk-schuif { touch-action: pan-y; }
  .vergelijk:has(.vergelijk-schuif:focus-visible) { outline: 2px solid var(--color-blad-diep); outline-offset: 3px; }
</style>
