---
// Hun logo nagetekend: groen vlak, huisje, TEAK / HUIS in witte kapitalen.
import { url } from '../data/site';
interface Props { klein?: boolean }
const { klein = false } = Astro.props;
---
<a href={url('')} class="group inline-flex items-center gap-3 no-underline" aria-label="Teakhuis, naar de homepage">
  <svg viewBox="0 0 100 100" class={`flex-none ${klein ? 'h-11 w-11' : 'h-12 w-12 md:h-14 md:w-14'}`} aria-hidden="true">
    <rect width="100" height="100" fill="#6aab35" />
    <path d="M38 27.5 50 18l12 9.5M42 24.5V31h16v-6.5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round" />
    <text x="50" y="56" text-anchor="middle" fill="#fff" font-family="Mulish Variable, Segoe UI, system-ui, sans-serif" font-weight="800" font-size="21" letter-spacing=".5">TEAK</text>
    <text x="50" y="80" text-anchor="middle" fill="#fff" font-family="Mulish Variable, Segoe UI, system-ui, sans-serif" font-weight="800" font-size="24" letter-spacing=".5">HUIS</text>
  </svg>
</a>
