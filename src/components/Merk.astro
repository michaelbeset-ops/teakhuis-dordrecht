---
// Het logo van Teakhuis nagetekend als vector: groen vierkant, huisje met penseelstreek, TEAK / HUIS in witte kapitalen.
import { url } from '../data/site';
interface Props { klein?: boolean }
const { klein = false } = Astro.props;
---
<a href={url('')} class="group inline-flex items-center gap-3 no-underline" aria-label="Teakhuis, naar de homepage">
  <svg viewBox="0 0 100 100" class={`flex-none ${klein ? 'h-12 w-12' : 'h-11 w-11 lg:h-[3.25rem] lg:w-[3.25rem]'}`} aria-hidden="true">
    <rect width="100" height="100" rx="2" fill="#6aab35"/>
    <g fill="none" stroke="#fff" stroke-linejoin="round" stroke-linecap="round" stroke-width="1.8">
      <path d="M42.4 18.4 50 11.8l7.6 6.6"/>
      <path d="M44.6 16.6v8.2M55.4 16.6v8.2"/>
    </g>
    <path d="M30.6 25.4c-0.5-0.5-0.4-0.9 0.4-0.8 9.2 1.6 24.2 1.3 39.2-1.9-0.3 0.8-0.9 1.3-1.8 1.6-13 3-28 3.2-37.8 1.1z" fill="#fff"/>
    <text x="50" y="52.5" text-anchor="middle" fill="#fff" font-family="Mulish Variable, Mulish, Segoe UI, sans-serif" font-weight="700" font-size="20" letter-spacing="0.2">TEAK</text>
    <text x="50" y="74.5" text-anchor="middle" fill="#fff" font-family="Mulish Variable, Mulish, Segoe UI, sans-serif" font-weight="700" font-size="24.5" letter-spacing="0.6">HUIS</text>
  </svg>
</a>
