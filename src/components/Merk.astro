---
// Hun logo nagetekend: groen vlak, huisje, TEAK / HUIS in witte kapitalen.
import { url } from '../data/site';
interface Props { klein?: boolean }
const { klein = false } = Astro.props;
---
<a href={url('')} class="group inline-flex items-center gap-3 no-underline" aria-label="Teakhuis, naar de homepage">
  <svg viewBox="0 0 100 100" class={`flex-none ${klein ? 'h-12 w-12' : 'h-11 w-11 lg:h-[3.25rem] lg:w-[3.25rem]'}`} aria-hidden="true">
    <rect width="100" height="100" rx="50" fill="#6aab35" />
    <path d="M40 30 50 22l10 8M43.5 27.5V33h13v-5.5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round" />
    <text x="50" y="56" text-anchor="middle" fill="#fff" font-family="Mulish Variable, Segoe UI, system-ui, sans-serif" font-weight="800" font-size="18" letter-spacing=".5">TEAK</text>
    <text x="50" y="76" text-anchor="middle" fill="#fff" font-family="Mulish Variable, Segoe UI, system-ui, sans-serif" font-weight="800" font-size="20" letter-spacing=".5">HUIS</text>
  </svg>
</a>
