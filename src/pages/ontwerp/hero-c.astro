---
// TESTPAGINA (niet committen): hero-ontwerp C, "Winkel eerst".
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Kop from '../../components/Kop.astro';
import Icoon from '../../components/Icoon.astro';
import { url } from '../../data/site';
import { groepen, categorieHref, sfeerFoto, opWit } from '../../data/catalogus';
import woon from '../../assets/home-woonkamer.jpg';
const cats = groepen.filter((g) => g.hoofd.slug !== 'onderhoudsmiddelen').slice(0, 6).map((g) => ({ g, f: sfeerFoto(g.hoofd.foto, g.producten) }));
---
<Base title="Ontwerp C" description="test">
  <Kop />
  <main>
    <section class="-mt-[4.75rem] bg-papier">
      <div class="relative h-[47svh] min-h-[20rem] overflow-hidden">
        <Image src={woon} alt="" widths={[828, 1280]} sizes="100vw" loading="eager" class="absolute inset-0 h-full w-full object-cover object-[30%_60%]" />
        <div class="absolute inset-0 bg-gradient-to-t from-nacht/85 via-nacht/10 to-nacht/40" aria-hidden="true"></div>
        <div class="wrap absolute inset-x-0 bottom-12 text-wit">
          <p class="label text-blad-licht">Sinds 2007</p>
          <h1 class="mt-2 max-w-[16ch] font-kop text-[2.1rem] font-extrabold leading-[1.02] [font-stretch:108%]">Teak op maat, zonder meerprijs.</h1>
        </div>
      </div>
      <div class="relative -mt-7 rounded-t-[1.6rem] bg-papier px-5 pb-8 pt-6">
        <div class="flex items-baseline justify-between">
          <p class="font-kop text-xl font-extrabold">Waar zoek je naar?</p>
          <a href={url('webshop/')} class="text-sm font-bold text-blad-diep">Alles</a>
        </div>
        <ul class="mt-4 grid grid-cols-2 gap-2">
          {cats.map(({ g, f }) => (
            <li class="min-w-0"><a href={categorieHref(g.hoofd)} class="flex items-center gap-2.5 rounded-[var(--radius-md)] bg-wit p-1.5 pr-2 no-underline ring-1 ring-lijn">
              <span class="block h-14 w-14 flex-none overflow-hidden rounded-[10px] bg-zand">
                {f && <Image src={f} alt="" widths={[120]} sizes="56px" class={`h-full w-full ${opWit(f) ? 'object-contain p-1' : 'object-cover'}`} />}
              </span>
              <span class="min-w-0 text-[.82rem] font-bold leading-tight [overflow-wrap:anywhere]">{g.hoofd.naam.replace('Slaapkamermeubels', 'Slaapkamer').replace('Badkamermeubelen', 'Badkamer').replace('Teak zitmeubelen', 'Stoelen en banken')}</span>
            </a></li>
          ))}
        </ul>
        <a href={url('maatwerk/')} class="mt-5 flex items-center justify-between gap-3 rounded-[var(--radius-md)] bg-nacht px-4 py-3.5 text-wit no-underline">
          <span><span class="block font-kop font-extrabold">Iets op maat laten maken?</span><span class="block text-xs text-as">Geef je maten door, zonder meerprijs</span></span>
          <Icoon naam="pijl" class="h-5 w-5 flex-none text-blad-licht" />
        </a>
      </div>
    </section>
  </main>
</Base>
