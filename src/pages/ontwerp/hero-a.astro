---
// TESTPAGINA (niet committen): hero-ontwerp A, "Foto eerst".
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Kop from '../../components/Kop.astro';
import Icoon from '../../components/Icoon.astro';
import { url } from '../../data/site';
import woon from '../../assets/home-woonkamer.jpg';
import slaap from '../../assets/home-slaapkamer.jpg';
import eet from '../../assets/home-eetkamer.jpg';
const dias = [{ f: woon, n: 'Woonkamer', pos: 'object-[30%_60%]' }, { f: slaap, n: 'Slaapkamer', pos: 'object-[55%_55%]' }, { f: eet, n: 'Eetkamer', pos: 'object-[70%_50%]' }];
---
<Base title="Ontwerp A" description="test">
  <Kop />
  <main>
    <section class="-mt-[4.75rem] bg-papier">
      <div class="relative h-[44svh] min-h-[19rem] overflow-hidden">
        {dias.map((d, i) => <Image src={d.f} alt="" widths={[828, 1280]} sizes="100vw" loading="eager" class:list={['absolute inset-0 h-full w-full object-cover transition-opacity duration-700', d.pos, i ? 'opacity-0' : '']} data-a-dia />)}
        <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-nacht/45 to-transparent" aria-hidden="true"></div>
        <div class="absolute inset-x-5 bottom-4 flex gap-2" role="tablist" aria-label="Kies een kamer">
          {dias.map((d, i) => (
            <button type="button" class:list={['flex items-center gap-2 rounded-full py-1 pl-1 pr-3 text-xs font-bold backdrop-blur-md transition-colors', i ? 'bg-wit/70 text-inkt' : 'bg-wit text-inkt ring-2 ring-blad']} data-a-tab={i}>
              <Image src={d.f} alt="" widths={[64]} sizes="28px" class="h-7 w-7 rounded-full object-cover" />{d.n}
            </button>
          ))}
        </div>
      </div>
      <div class="wrap pb-10 pt-6">
        <p class="label flex items-center gap-2 text-blad-diep"><span class="h-px w-6 bg-blad-diep"></span>Maatwerk zonder meerprijs, sinds 2007</p>
        <h1 class="mt-3 font-kop text-[2.05rem] font-extrabold leading-[1.02] [font-stretch:108%]">Teak op bestelling, met de hand gemaakt.</h1>
        <p class="mt-3 text-grijs">Zonder winkel en voorraad, dus voordeliger.</p>
        <div class="mt-6 grid gap-2.5">
          <a href={url('webshop/')} class="knop knop-blad">Kies je meubel<Icoon naam="pijl" /></a>
          <a href={url('maatwerk/')} class="knop knop-rand">Iets op maat laten maken</a>
        </div>
      </div>
    </section>
  </main>
  <script>
    const d = [...document.querySelectorAll<HTMLElement>('[data-a-dia]')];
    const t = [...document.querySelectorAll<HTMLElement>('[data-a-tab]')];
    t.forEach((b, i) => b.addEventListener('click', () => {
      d.forEach((x, j) => x.classList.toggle('opacity-0', j !== i));
      t.forEach((x, j) => { x.classList.toggle('ring-2', j === i); x.classList.toggle('ring-blad', j === i); x.classList.toggle('bg-wit', j === i); x.classList.toggle('bg-wit/70', j !== i); });
    }));
  </script>
</Base>
