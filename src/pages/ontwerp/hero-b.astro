---
// TESTPAGINA (niet committen): hero-ontwerp B, "Han en grote letters".
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Kop from '../../components/Kop.astro';
import Icoon from '../../components/Icoon.astro';
import { url, site, waHoi } from '../../data/site';
import woon from '../../assets/home-woonkamer.jpg';
import slaap from '../../assets/home-slaapkamer.jpg';
import eet from '../../assets/home-eetkamer.jpg';
import han from '../../assets/han.jpg';
const fotos = [{ f: eet, pos: 'object-[75%_50%]' }, { f: woon, pos: 'object-[35%_60%]' }, { f: slaap, pos: 'object-[55%_55%]' }];
---
<Base title="Ontwerp B" description="test">
  <Kop />
  <main>
    <section class="-mt-[4.75rem] overflow-hidden bg-nacht pb-8 pt-[6rem] text-wit">
      <div class="wrap">
        <h1 class="font-kop text-[2.6rem] font-extrabold uppercase leading-[.92] [font-stretch:112%]">
          <span class="block text-blad-licht">Maatwerk</span>
          <span class="block">zonder</span>
          <span class="block">meerprijs.</span>
        </h1>
        <p class="mt-5 max-w-[30ch] text-lg leading-snug text-as">Teakhouten meubels, op bestelling met de hand gemaakt. Sinds 2007.</p>
      </div>
      <ul class="mt-6 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 [scrollbar-width:none]">
        {fotos.map((x) => (
          <li class="w-[70%] flex-none snap-start"><Image src={x.f} alt="" widths={[640, 900]} sizes="78vw" loading="eager" class={`aspect-[5/4] w-full rounded-[var(--radius-md)] object-cover ${x.pos}`} /></li>
        ))}
      </ul>
      <div class="wrap mt-7 grid gap-2.5">
        <a href={url('webshop/')} class="knop knop-blad">Kies je meubel<Icoon naam="pijl" /></a>
        <a href={waHoi} class="flex items-center gap-3 rounded-[var(--radius-md)] bg-nacht-2 p-3 text-wit no-underline ring-1 ring-lijn-d">
          <Image src={han} alt="" widths={[112]} sizes="52px" class="h-[3.25rem] w-[3.25rem] flex-none rounded-full object-cover object-[50%_45%] ring-2 ring-blad" />
          <span class="min-w-0 flex-1"><span class="block text-xs text-as">Twijfel je? App of bel Han, eigenaar</span><span class="num block font-kop text-lg font-extrabold">{site.tel}</span></span>
          <span class="grid h-10 w-10 flex-none place-items-center rounded-full bg-blad text-inkt"><Icoon naam="wa" /></span>
        </a>
      </div>
    </section>
  </main>
</Base>
