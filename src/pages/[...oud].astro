---
// Doorverwijzingen van de oude teakhuis.nl-adressen naar de nieuwe pagina's. GitHub Pages kent geen serverredirects,
// daarom een kleine pagina met meta refresh en canonical: Google volgt die en geeft de waarde door aan de nieuwe pagina.
import { url, absoluut } from '../data/site';
import { producten, categorieen, productHref, categorieHref, SHOP } from '../data/catalogus';

export function getStaticPaths() {
  const naar = new Map<string, string>();
  const zet = (oud: string, nieuw: string) => {
    const pad = oud.replace(/^\/+|\/+$/g, '');
    if (pad && !naar.has(pad)) naar.set(pad, nieuw);
  };
  // Pagina's van de oude site die nu een deel van een andere pagina zijn. De webshop zelf (overzicht, categorieen en
  // producten) staat op precies dezelfde adressen als vroeger en hoeft niet doorverwezen te worden.
  zet('maatwerk/kledingkast-op-maat', url('maatwerk/'));
  zet('maatwerk/tv-meubel-maatwerk', url('maatwerk/'));
  zet('maatwerk/voorbeelden-maatwerk-teakhout', url('maatwerk/#voorbeelden'));
  zet('maatwerk/het-proces', url('maatwerk/'));
  zet('referenties', url('over-ons/#referenties'));
  zet('collecties-overzicht', url('collecties/'));
  zet('collecties/KLRHtYBiBp5Guxp9848T9n', url('collecties/'));
  zet('leverbare-kleuren-teak', url('maatwerk/'));
  // Oude webshopcategorieen die niet meer bestaan.
  for (const [id, slug] of [['186', 'aanbiedingen'], ['231', 'gestoffeerde-meubels'], ['244', 'uitverkoop-voorraad']]) zet(`${SHOP}/${id}/${slug}`, url('webshop/'));
  // Adressen van de testversie (okt-nov 2026): bewaarde offertelijstjes en gedeelde links blijven werken.
  zet('collectie', url('webshop/'));
  for (const p of producten) zet(`product/${p.slug}`, productHref(p));
  for (const c of categorieen) zet(`collectie/${c.slug}`, categorieHref(c));
  return [...naar].map(([oud, nieuw]) => ({ params: { oud }, props: { nieuw } }));
}
const { nieuw } = Astro.props as { nieuw: string };
const doel = new URL(nieuw, absoluut('')).href;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <title>Deze pagina is verhuisd | Teakhuis</title>
    <link rel="canonical" href={doel} />
    <meta http-equiv="refresh" content={`0; url=${nieuw}`} />
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 2rem">
    <p>Deze pagina is verhuisd: <a href={nieuw}>ga verder naar de nieuwe pagina</a>.</p>
  </body>
</html>
