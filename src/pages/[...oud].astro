---
// Doorverwijzingen van de oude teakhuis.nl-adressen naar de nieuwe pagina's. GitHub Pages kent geen serverredirects,
// daarom een kleine pagina met meta refresh en canonical: Google volgt die en geeft de waarde door aan de nieuwe pagina.
import { url, absoluut } from '../data/site';
import { getCollection } from 'astro:content';
import { producten, categorieen, productHref, categorieHref, productPad, categoriePad, SHOP } from '../data/catalogus';
// Alle adressen uit de sitemap van de oude site (opgehaald 23 nov 2026, voor de livegang).
import oudeAdressen from '../data/oude-adressen.json';

export async function getStaticPaths() {
  const naar = new Map<string, string>();
  const zet = (oud: string, nieuw: string) => {
    const pad = oud.replace(/^\/+|\/+$/g, '');
    if (pad && !naar.has(pad)) naar.set(pad, nieuw);
  };
  // Pagina's van de oude site die nu een deel van een andere pagina zijn. De webshop zelf (overzicht, categorieen en
  // producten) staat op precies dezelfde adressen als vroeger en hoeft niet doorverwezen te worden.
  zet('maatwerk/kledingkast-op-maat', url('maatwerk/'));
  zet('maatwerk/tv-meubel-maatwerk', url('maatwerk/'));
  zet('maatwerk/voorbeelden-maatwerk-teakhout', url('maatwerk/#voorbeelden'));
  zet('maatwerk/het-proces', url('maatwerk/'));
  zet('referenties', url('over-ons/'));
  zet('collecties-overzicht', url('collecties/'));
  zet('collecties/KLRHtYBiBp5Guxp9848T9n', url('collecties/'));
  zet('leverbare-kleuren-teak', url('maatwerk/'));
  // Oude webshopcategorieen die niet meer bestaan.
  for (const [id, slug] of [['186', 'aanbiedingen'], ['231', 'gestoffeerde-meubels'], ['244', 'uitverkoop-voorraad']]) zet(`${SHOP}/${id}/${slug}`, url('webshop/'));
  // Adressen van de testversie (okt-nov 2026): bewaarde offertelijstjes en gedeelde links blijven werken.
  zet('collectie', url('webshop/'));
  for (const p of producten) zet(`product/${p.slug}`, productHref(p));
  for (const c of categorieen) zet(`collectie/${c.slug}`, categorieHref(c));
  // Oude zoekpagina's van de vorige site.
  const opSlug = new Map(categorieen.map((c) => [c.slug, c]));
  const cat = (slug: string) => (opSlug.get(slug) ? categorieHref(opSlug.get(slug)!) : url('webshop/'));
  zet('teakhouten-bartafel', cat('bartafels'));
  zet('teakhouten-bartafel-1', cat('bartafels'));
  zet('teakhouten-bijzettafel', cat('teak-salontafels'));
  zet('teakhouten-bijzettafel-1', cat('teak-salontafels'));
  zet('teakhouten-keukentafel', cat('teak-eettafels'));
  zet('teakhouten-keukentafel-1', cat('teak-eettafels'));
  zet('teakhouten-vitrinekast', cat('vitrinekasten'));
  zet('teakhouten-vitrinekast-1', cat('vitrinekasten'));
  zet('teaktafel-rond', cat('teak-eettafels'));

  // Pagina's van de oude site buiten de webshop (gevonden door de oude site te doorlopen, 23 nov 2026): landingspagina's,
  // blog, winkels, juridisch. Allemaal naar de pagina die er inhoudelijk het dichtst bij komt.
  const home = url(''), shop = url('webshop/');
  const overig: [string, string][] = [
    ['alle-producten', shop], ['webshop/aanbiedingen', shop], ['winkelmand', url('offerte/')],
    ['aziatische-meubelen', url('collecties/koloniale-meubelen/')], ['koloniaal-wonen', url('collecties/koloniale-meubelen/')],
    ['meubelen-van-teakhout', shop], ['mooie-teak-meubelen', shop], ['goedkope-teak-meubels', shop], ['strakke-teak-meubels', shop],
    ['teak-woninginrichting', shop], ['teak-meubelen-amsterdam', shop], ['teak-meubelen-antwerpen', shop], ['teak-meubelen-utrecht', shop],
    ['dressoir-van-teakhout', cat('dressoirs')], ['kast-van-teakhout', cat('kasten')], ['salontafel-van-teak', cat('teak-salontafels')],
    ['tafel-van-teakhout', cat('tafels')], ['teak-eettafel', cat('teak-eettafels')], ['teak-badkamermeubels', cat('badkamermeubelen')],
    ['maatwerk-teak', url('maatwerk/')], ['maatwerk/waarom-maatwerk', url('maatwerk/')],
    ['onze-winkels', url('over-ons/')], ['onze-winkels/teakhuis-dordrecht', url('over-ons/')], ['onze-winkels/teakhuis-leiderdorp', url('over-ons/')], ['onze-winkels/teakhuis-roosendaal', url('over-ons/')],
    ['waarom-teakhout', url('duurzaam/')], ['waarom-teakhout-4-voordelen-van-teakhout', url('duurzaam/')], ['waarom-teakhout-veelzijdigheid-van-teakhout', url('duurzaam/')], ['waarom-teakhout/onderhoud-teakhout', url('duurzaam/')],
    ['juridisch-menu', url('privacy/')], ['juridisch-menu/cookie-statement', url('privacy/')], ['juridisch-menu/disclaimer', url('privacy/')],
    ['juridisch-menu/leveringsvoorwaarden', url('contact/')], ['juridisch-menu/sitemap', shop],
    ['blog', home], ['blog/aynSM5xKTi4DBtf9dCkqqa', home],
    ['blog/aynSM5xKTi4DBtf9dCkqqa/74/5-tips-om-de-perfecte-thuiswerkplek-te-creeren', cat('bureaus')],
    ['blog/aynSM5xKTi4DBtf9dCkqqa/75/de-boomstamtafel-een-echte-eyecatcher', cat('teak-eettafels')],
    ['blog/aynSM5xKTi4DBtf9dCkqqa/76/tips-en-inspiratie-voor-het-aanschaffen-van-een-nieuwe-eettafel', cat('teak-eettafels')],
    ['blog/aynSM5xKTi4DBtf9dCkqqa/77/interieur-inspiratie-een-natuurlijke-look', url('collecties/')],
  ];
  overig.push([SHOP, shop]);
  for (const [oud, nieuw] of overig) zet(oud, nieuw);
  // Korte webshopadressen van de oude site (/webshop/tafels): naar die categorie, of de webshop als hij verborgen is.
  for (const oud of oudeAdressen as string[]) {
    const m = oud.match(/^webshop\/([a-z-]+)$/);
    if (m) zet(oud, cat(m[1]));
  }
  // Onderhoud-teakhout had nog twee testberichten onder zich: ook naar Duurzaam.
  for (const oud of oudeAdressen as string[]) if (oud.startsWith('waarom-teakhout/')) zet(oud, url('duurzaam/'));

  // Elk ander oud adres dat geen pagina meer heeft (product verborgen of verwijderd, categorie verborgen): door naar de
  // categorie met hetzelfde oude nummer, of het hoofdmenu erboven als die verborgen is, en anders de webshop. Zo komt
  // niemand die via Google of een oude link binnenkomt op een foutpagina.
  const bestaat = new Set([...producten.map(productPad), ...categorieen.map(categoriePad)]);
  const alleCats = await getCollection('categorieen');
  const zichtbaar = new Map(categorieen.map((c) => [c.slug, c]));
  const naarCat = (oudeId?: string) => {
    let c = alleCats.find((x) => x.data.oudeId === oudeId);
    for (let i = 0; c && i < 3; i++) {
      if (zichtbaar.has(c.id)) return categorieHref(zichtbaar.get(c.id)!);
      c = alleCats.find((x) => x.id === c!.data.hoofd);
    }
    return url('webshop/');
  };
  for (const oud of oudeAdressen as string[]) {
    if (bestaat.has(oud) || naar.has(oud)) continue;
    const m = oud.match(new RegExp(`^${SHOP}/(\\d+)(?:/|$)`));
    if (oud.startsWith(SHOP)) zet(oud, naarCat(m?.[1]));
  }
  return [...naar].map(([oud, nieuw]) => ({ params: { oud }, props: { nieuw } }));
}
const { nieuw } = Astro.props as { nieuw: string };
const doel = new URL(nieuw, absoluut('')).href;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <title>Deze pagina is verhuisd | Teakhuis</title>
    <link rel="canonical" href={doel} />
    <meta http-equiv="refresh" content={`0; url=${nieuw}`} />
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 2rem">
    <p>Deze pagina is verhuisd: <a href={nieuw}>ga verder naar de nieuwe pagina</a>.</p>
  </body>
</html>
