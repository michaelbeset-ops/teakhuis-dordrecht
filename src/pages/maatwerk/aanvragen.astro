---
// Maatwerkaanvraag: naam, adres, telefoon, e-mail, wensen, afmetingen en foto's (zoals Han vroeg, zonder kleur en
// materiaal). Foto's worden in de browser verkleind en via EmailJS (send-form) als bijlage meegestuurd. Lukt dat niet
// (geen bijlagen ingesteld of te groot), dan gaat de aanvraag zonder foto's en vragen we ze via WhatsApp na te sturen.
import Base from '../../layouts/Base.astro';
import Kop from '../../components/Kop.astro';
import Voet from '../../components/Voet.astro';
import Icoon from '../../components/Icoon.astro';
import Kruimel from '../../components/Kruimel.astro';
import { site, url, absoluut, waHoi } from '../../data/site';
import { kruimelSchema } from '../../data/seo';
const cfg = { key: site.web3formsKey, emailjs: site.emailjs, logo: absoluut('logo.png'), contact: { tel: site.tel, telHref: site.telHref, wa: site.wa, mail: site.mail }, mail: site.mail, wa: site.wa };
const kruimel: [string, string?][] = [['Maatwerk', url('maatwerk/')], ['Aanvragen']];
---
<Base title="Maatwerk aanvragen: vrijblijvend ontwerp | Teakhuis" description="Vraag vrijblijvend een teakhouten meubel op maat aan. Beschrijf je wensen, geef de maten door en voeg foto's of een schets toe." schema={[kruimelSchema(kruimel, absoluut('maatwerk/aanvragen/'))]}>
  <Kop />
  <main id="inhoud" class="pb-24 md:pb-32">
    <section class="wrap pt-6 md:pt-8">
      <Kruimel stappen={kruimel} />
      <div class="mt-10 grid grid-cols-1 gap-y-10 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-4">
          <p class="label text-blad-diep">Vrijblijvend</p>
          <h1 class="mt-4 text-4xl">Maatwerk aanvragen.</h1>
          <p class="mt-5 text-lg text-grijs">Vertel wat je zoekt. Han bekijkt je aanvraag persoonlijk en neemt contact met je op voor een vrijblijvend voorstel.</p>
          <ul class="mt-8 space-y-3 text-grijs">
            {['Geen meerprijs voor maatwerk', 'Foto, schets of AI-afbeelding: alles is goed', 'Je zit nergens aan vast'].map((t) => <li class="flex gap-3"><Icoon naam="vink" class="mt-1 h-4 w-4 flex-none text-blad-diep" />{t}</li>)}
          </ul>
          <p class="mt-8 text-sm text-grijs">Liever even bellen of appen? <a href={site.telHref} class="num font-bold text-inkt underline underline-offset-2">{site.tel}</a></p>
        </div>

        <div class="lg:col-span-8">
          <form class="rounded-md bg-wit p-5 sm:p-8 lg:p-10" data-mw-form novalidate>
            <fieldset>
              <legend class="font-kop text-2xl">Je wensen</legend>
              <label class="mt-5 block">
                <span class="text-sm font-bold">Wat voor meubel zoek je?</span>
                <textarea name="omschrijving" maxlength="3000" rows="5" required class="veld mt-1.5" placeholder="Bijvoorbeeld: een tv-meubel met drie lades en een open vak voor de versterker, strakke poten"></textarea>
              </label>
              <div class="mt-6">
                <span class="text-sm font-bold">Afmetingen in cm <span class="font-medium text-grijs">(wat je al weet)</span></span>
                <div class="mt-1.5 grid grid-cols-3 gap-2">
                  <label><span class="sr-only">Breedte in cm</span><input name="b" inputmode="numeric" maxlength="4" placeholder="Breed" class="veld num" /></label>
                  <label><span class="sr-only">Diepte in cm</span><input name="d" inputmode="numeric" maxlength="4" placeholder="Diep" class="veld num" /></label>
                  <label><span class="sr-only">Hoogte in cm</span><input name="h" inputmode="numeric" maxlength="4" placeholder="Hoog" class="veld num" /></label>
                </div>
                <label class="mt-2 block"><span class="sr-only">Andere maten of toelichting</span><input name="maten" maxlength="300" placeholder="Andere maten of toelichting, bijvoorbeeld: past in een nis van 180 cm" class="veld" /></label>
              </div>

              <div class="mt-6">
                <span class="text-sm font-bold" id="foto-kop">Foto's of een schets <span class="font-medium text-grijs">(mag leeg, max. 5)</span></span>
                <label class="mt-1.5 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-[var(--radius-md)] border-2 border-dashed border-lijn-2 bg-papier px-4 py-8 text-center transition-colors hover:border-blad-diep hover:bg-zand data-[sleep]:border-blad-diep data-[sleep]:bg-zand" data-drop>
                  <span class="grid h-12 w-12 place-items-center rounded-full bg-blad text-inkt">
                    <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="15" rx="2" /><circle cx="9" cy="10.5" r="1.8" /><path d="m3 17 5-4.5 4 3.5 3-2.5 6 5" /></svg>
                  </span>
                  <span class="font-kop text-lg font-bold">Foto's toevoegen</span>
                  <span class="text-sm text-grijs">Klik hier of sleep je foto's in dit vak</span>
                  <input type="file" accept="image/*" multiple class="sr-only" aria-labelledby="foto-kop" data-fotos />
                </label>
                <ul class="mt-3 grid grid-cols-3 gap-2 sm:grid-cols-5" data-voorbeelden></ul>
                <p class="mt-2 hidden text-sm text-[#a3301f]" data-foto-fout></p>
              </div>
            </fieldset>

            <fieldset class="mt-10 border-t border-lijn pt-8">
              <legend class="float-left w-full font-kop text-2xl">Je gegevens</legend>
              <div class="clear-left grid grid-cols-2 gap-4 pt-5">
                <label class="col-span-2 block sm:col-span-1"><span class="text-sm font-bold">Naam</span><input name="naam" autocomplete="name" required class="veld mt-1.5" /></label>
                <label class="col-span-2 block sm:col-span-1"><span class="text-sm font-bold">E-mail</span><input name="email" type="email" autocomplete="email" required class="veld mt-1.5" /></label>
                <label class="col-span-2 block sm:col-span-1"><span class="text-sm font-bold">Telefoon <span class="font-medium text-grijs">(handig)</span></span><input name="telefoon" type="tel" autocomplete="tel" class="veld mt-1.5" /></label>
                <label class="col-span-2 block sm:col-span-1"><span class="text-sm font-bold">Straat en huisnummer</span><input name="straat" autocomplete="street-address" class="veld mt-1.5" /></label>
                <label class="block"><span class="text-sm font-bold">Postcode</span><input name="postcode" autocomplete="postal-code" maxlength="7" class="veld mt-1.5 uppercase" /></label>
                <label class="block"><span class="text-sm font-bold">Plaats</span><input name="plaats" autocomplete="address-level2" class="veld mt-1.5" /></label>
                <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
              </div>
            </fieldset>

            <p class="mt-6 hidden text-sm font-bold text-[#a3301f]" role="alert" data-fout></p>
            <div class="mt-8 flex flex-col gap-3 border-t border-lijn pt-7 sm:flex-row sm:items-center">
              <button type="submit" class="knop knop-blad" data-verstuur>Aanvraag versturen<Icoon naam="pijl" /></button>
              <a href={waHoi} class="knop knop-rand"><Icoon naam="wa" />Of via WhatsApp</a>
            </div>
            <p class="mt-4 text-xs text-grijs">We gebruiken je gegevens alleen voor deze aanvraag. Lees de <a href={url('privacy/')} class="underline underline-offset-2">privacyverklaring</a>.</p>
          </form>

          <div class="rounded-md bg-wit p-6 sm:p-10" data-bedankt hidden tabindex="-1">
            <Icoon naam="vink" class="h-9 w-9 text-blad-diep" />
            <h2 class="mt-4 font-kop text-3xl">Bedankt, je aanvraag is verstuurd.</h2>
            <p class="mt-3 text-grijs">Han bekijkt je idee en neemt contact met je op voor een vrijblijvend voorstel.</p>
            <div class="mt-6 hidden rounded-[var(--radius-md)] bg-zand p-5" data-foto-na>
              <p class="font-bold">Je foto's konden niet mee met de aanvraag.</p>
              <p class="mt-1 text-sm text-grijs">Stuur ze even via WhatsApp, dan heeft Han alles bij elkaar.</p>
              <a href={waHoi} class="knop knop-blad mt-4 min-h-11 text-sm"><Icoon naam="wa" />Foto's via WhatsApp</a>
            </div>
            <a href={url('maatwerk/#voorbeelden')} class="knop knop-rand mt-8">Bekijk voorbeelden van maatwerk</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Voet />

  <script type="application/json" id="mw-cfg" set:html={JSON.stringify(cfg)} />
  <script>
    import { maatwerkHtml, maatwerkBevestigingHtml, type Contact, type Maatwerk } from '../../scripts/mail';
    import { meet } from '../../scripts/meet';

    const cfg = JSON.parse(document.getElementById('mw-cfg')!.textContent!) as { key: string; emailjs: { service: string; template: string; templateKlant: string; publicKey: string }; logo: string; contact: Contact; mail: string; wa: string };
    const form = document.querySelector<HTMLFormElement>('[data-mw-form]')!;
    const fout = form.querySelector<HTMLElement>('[data-fout]')!;
    const knop = form.querySelector<HTMLButtonElement>('[data-verstuur]')!;
    const invoer = form.querySelector<HTMLInputElement>('[data-fotos]')!;
    const drop = form.querySelector<HTMLElement>('[data-drop]')!;
    const ul = form.querySelector<HTMLUListElement>('[data-voorbeelden]')!;
    const fotoFout = form.querySelector<HTMLElement>('[data-foto-fout]')!;
    const bedankt = document.querySelector<HTMLElement>('[data-bedankt]')!;
    const MAX = 5;

    // Foto's: verkleind tot max. 1600 px (JPEG), zodat ze klein genoeg zijn om mee te sturen.
    type Foto = { blob: Blob; naam: string; url: string };
    let fotos: Foto[] = [];
    const verklein = async (f: File): Promise<Blob | null> => {
      try {
        const bmp = await createImageBitmap(f);
        const s = Math.min(1, 1600 / Math.max(bmp.width, bmp.height));
        const c = document.createElement('canvas');
        c.width = Math.round(bmp.width * s); c.height = Math.round(bmp.height * s);
        c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height);
        return await new Promise((r) => c.toBlob(r, 'image/jpeg', 0.8));
      } catch {
        return f.size < 4e6 ? f : null; // niet te lezen (bv. HEIC op een pc): het origineel als het niet te groot is
      }
    };
    const tekenFotos = () => {
      ul.replaceChildren(...fotos.map((f, i) => {
        const li = document.createElement('li');
        li.className = 'relative aspect-square overflow-hidden rounded-[var(--radius-sm)] bg-zand ring-1 ring-lijn';
        const img = document.createElement('img');
        img.src = f.url; img.alt = f.naam; img.className = 'h-full w-full object-cover';
        const weg = document.createElement('button');
        weg.type = 'button';
        weg.className = 'absolute right-1 top-1 grid h-7 w-7 place-items-center rounded-full bg-nacht/80 text-base leading-none text-wit hover:bg-nacht';
        weg.setAttribute('aria-label', `Verwijder ${f.naam}`);
        weg.textContent = '×';
        weg.addEventListener('click', () => { URL.revokeObjectURL(f.url); fotos.splice(i, 1); tekenFotos(); });
        li.append(img, weg);
        return li;
      }));
    };
    const voegFotosToe = async (lijst: FileList | File[]) => {
      fotoFout.classList.add('hidden');
      const nieuw = [...lijst].filter((f) => f.type.startsWith('image/') || /\.(heic|heif)$/i.test(f.name));
      if (fotos.length + nieuw.length > MAX) { fotoFout.textContent = `Je kunt maximaal ${MAX} foto's toevoegen.`; fotoFout.classList.remove('hidden'); }
      for (const f of nieuw.slice(0, MAX - fotos.length)) {
        const blob = await verklein(f);
        if (!blob) { fotoFout.textContent = `${f.name} kon niet worden gelezen. Stuur hem eventueel via WhatsApp.`; fotoFout.classList.remove('hidden'); continue; }
        fotos.push({ blob, naam: f.name.replace(/\.\w+$/, '') + '.jpg', url: URL.createObjectURL(blob) });
      }
      tekenFotos();
    };
    invoer.addEventListener('change', () => { if (invoer.files) voegFotosToe(invoer.files); invoer.value = ''; });
    ['dragenter', 'dragover'].forEach((t) => drop.addEventListener(t, (e) => { e.preventDefault(); drop.dataset.sleep = ''; }));
    ['dragleave', 'drop'].forEach((t) => drop.addEventListener(t, () => delete drop.dataset.sleep));
    drop.addEventListener('drop', (e) => { e.preventDefault(); if (e.dataTransfer?.files) voegFotosToe(e.dataTransfer.files); });

    form.addEventListener('input', () => { fout.classList.add('hidden'); form.querySelectorAll('[aria-invalid]').forEach((v) => v.removeAttribute('aria-invalid')); });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(form);
      const veld = (n: string) => String(f.get(n) ?? '').trim();
      const fouten: string[] = [];
      const markeer = (n: string) => form.querySelector(`[name="${n}"]`)!.setAttribute('aria-invalid', 'true');
      if (!veld('omschrijving')) { markeer('omschrijving'); fouten.push('wat voor meubel je zoekt'); }
      if (!veld('naam')) { markeer('naam'); fouten.push('je naam'); }
      if (!/^\S+@\S+\.\S+$/.test(veld('email'))) { markeer('email'); fouten.push('een geldig e-mailadres'); }
      if (fouten.length) {
        fout.textContent = `Vul nog ${fouten.join(', ').replace(/, ([^,]*)$/, ' en $1')} in.`;
        fout.classList.remove('hidden');
        (form.querySelector('[aria-invalid="true"]') as HTMLElement | null)?.focus();
        return;
      }
      if (f.get('botcheck')) return;

      const cm = (n: string) => veld(n).replace(/\D/g, '').slice(0, 4);
      const bdh = [['B', cm('b')], ['D', cm('d')], ['H', cm('h')]].filter(([, v]) => v).map(([k, v]) => `${k} ${v}`).join(' x ');
      const m: Maatwerk = {
        naam: veld('naam'), email: veld('email'), telefoon: veld('telefoon'),
        adres: [veld('straat'), [veld('postcode').toUpperCase(), veld('plaats')].filter(Boolean).join(' ')].filter(Boolean).join(', '),
        omschrijving: veld('omschrijving'),
        maten: [bdh && `${bdh} cm`, veld('maten')].filter(Boolean).join('\n'),
        fotos: fotos.length,
      };
      const onderwerp = `Maatwerkaanvraag van ${m.naam}`;
      const tekst = `Wensen:\n${m.omschrijving}${m.maten ? `\n\nAfmetingen:\n${m.maten}` : ''}\n\nNaam: ${m.naam}\nE-mail: ${m.email}\nTelefoon: ${m.telefoon}\nAdres: ${m.adres}`;
      const mailto = `mailto:${cfg.mail}?subject=${encodeURIComponent(onderwerp)}&body=${encodeURIComponent(tekst + (fotos.length ? "\n\n(Voeg je foto's als bijlage toe aan deze mail.)" : ''))}`;

      const ej = cfg.emailjs;
      const metEmailjs = Boolean(ej.service && ej.template && ej.publicKey);
      if (!metEmailjs && !cfg.key) { meet('Maatwerk via mailprogramma'); location.href = mailto; return; }

      knop.disabled = true;
      knop.textContent = 'Bezig met versturen...';
      let fotosMislukt = false;
      try {
        if (metEmailjs) {
          const stuur = async (metFotos: boolean) => {
            const d = new FormData();
            const mm = { ...m, fotos: metFotos ? fotos.length : 0 };
            Object.entries({ service_id: ej.service, template_id: ej.template, user_id: ej.publicKey, onderwerp, naam: m.naam, reply_to: m.email, inhoud: maatwerkHtml(mm, cfg.logo), tekst }).forEach(([k, v]) => d.append(k, v));
            if (metFotos) fotos.forEach((p) => d.append('fotos', p.blob, p.naam));
            const r = await fetch('https://api.emailjs.com/api/v1.0/email/send-form', { method: 'POST', body: d });
            if (!r.ok) throw new Error(await r.text());
          };
          if (fotos.length) {
            try { await stuur(true); } catch { fotosMislukt = true; await stuur(false); }
          } else await stuur(false);
          if (ej.templateKlant) {
            fetch('https://api.emailjs.com/api/v1.0/email/send', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ service_id: ej.service, template_id: ej.templateKlant, user_id: ej.publicKey, template_params: { onderwerp: 'Je maatwerkaanvraag bij Teakhuis', naam: m.naam, to_email: m.email, reply_to: cfg.mail, inhoud: maatwerkBevestigingHtml({ ...m, fotos: fotosMislukt ? 0 : m.fotos }, cfg.logo, cfg.contact) } }),
            }).catch(() => {});
          }
        } else {
          fotosMislukt = fotos.length > 0;
          const r = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ access_key: cfg.key, subject: onderwerp, from_name: 'Website Teakhuis', name: m.naam, email: m.email, replyto: m.email, phone: m.telefoon, message: tekst, botcheck: '' }),
          });
          const j = await r.json();
          if (!j.success) throw new Error(j.message);
        }
        meet('Maatwerk verstuurd');
        form.hidden = true;
        bedankt.hidden = false;
        bedankt.querySelector('[data-foto-na]')!.classList.toggle('hidden', !fotosMislukt);
        bedankt.focus();
        bedankt.scrollIntoView({ block: 'start', behavior: 'smooth' });
      } catch {
        fout.replaceChildren('Versturen lukte niet. Probeer het nog eens, of ');
        const a = document.createElement('a');
        a.href = mailto; a.className = 'underline'; a.textContent = 'stuur hem per mail';
        fout.append(a, '.');
        fout.classList.remove('hidden');
        knop.disabled = false;
        knop.textContent = 'Aanvraag versturen';
      }
    });
  </script>
</Base>
