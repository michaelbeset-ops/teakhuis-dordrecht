---
// Maatwerkpagina, op basis van de tekst van Han (nov 2026). Aanvragen gaat via een eigen formulier (maatwerk/aanvragen/).
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Kruimel from '../components/Kruimel.astro';
import Vragen from '../components/Vragen.astro';
import MaatwerkProjecten from '../components/MaatwerkProjecten.astro';
import { site, url, absoluut, waHoi, stappen } from '../data/site';
import { kruimelSchema, vragenSchema } from '../data/seo';
import tekening from '../assets/mw-kledingkast-tekening.jpg';

const aanvragen = url('maatwerk/aanvragen/');
const idee = ['Een omschrijving van je wensen', 'Een foto van een bestaand meubel', 'Een schets op papier', 'Een bouwtekening', 'Een afbeelding gemaakt met AI', 'Inspiratiefoto\'s van internet of social media'];
const waarom = ['Bijna 20 jaar ervaring met maatwerk in teak', 'Geen meerprijs voor maatwerk', 'Duurzaam Indonesisch teakhout', 'Vrijblijvend ontwerp en advies', 'Persoonlijke begeleiding, van ontwerp tot levering', 'Met de hand gemaakt door ervaren vakmensen', 'Duidelijke prijzen, zonder verrassingen'];
const vragen: [string, string][] = [
  ['Wat kost een teakhouten meubel op maat?', 'Dat hangt af van de maten, de uitvoering en het ontwerp. Voor aanpassingen aan een bestaand model rekenen we geen meerprijs. Wordt het meubel groter, dan stijgt de prijs naar verhouding mee; wordt het kleiner, dan kan hij juist lager uitvallen.'],
  ['Kan ik een foto of AI-afbeelding als voorbeeld gebruiken?', 'Ja. We werken vanaf foto\'s, schetsen, bouwtekeningen en afbeeldingen die met AI zijn gemaakt.'],
  ['Moet ik een aanbetaling doen?', 'Ja. Na je akkoord op het voorstel vragen we een aanbetaling van 20%. Het restbedrag betaal je voor of bij levering, per overschrijving of contant.'],
  ['Waar worden de meubels gemaakt?', 'Bij onze vaste meubelmakers in Indonesië. Daarna gaan ze per container naar Nederland.'],
  ['Hoe lang duurt het van bestelling tot levering?', 'Meestal ongeveer 3 tot 5 maanden. Het hangt af van de productieplanning en het transport; tijdens het offertetraject hoor je de actuele levertijd.'],
  ['Kan ik mijn meubel zelf ophalen?', 'Ja, afhalen kan in Breda. Bezorgen kan ook; de bezorgkosten hangen af van je adres en hoor je altijd vooraf.'],
];
const dienst = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Teakhouten meubels op maat',
  serviceType: 'Maatwerk meubels',
  provider: { '@id': `${absoluut('')}#organisatie` },
  areaServed: { '@type': 'Country', name: 'Nederland' },
  description: 'Teakhouten meubels op maat, met de hand gemaakt door vakmensen in Indonesië van duurzaam teak. Maatwerk zonder meerprijs.',
};
---
<Base title="Maatwerk teakhouten meubels: uniek ontwerp zonder meerprijs | Teakhuis" description="Laat je teakhouten meubel op maat maken door Teakhuis. Al bijna 20 jaar specialist in maatwerk van duurzaam Indonesisch teak. Vraag vrijblijvend een ontwerp aan." schema={[dienst, vragenSchema(vragen), kruimelSchema([['Maatwerk']], absoluut('maatwerk/'))]}>
  <Kop />
  <main id="inhoud">
    <section class="wrap pb-16 pt-6 md:pb-24 md:pt-8">
      <Kruimel stappen={[['Maatwerk']]} />
      <div class="mt-10 grid grid-cols-1 gap-y-10 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-7">
          <p class="label text-blad-diep">Maatwerk zonder meerprijs</p>
          <h1 class="mt-4 text-hero">Jouw maten. <span class="cursief">Onze vakmensen.</span></h1>
          <p class="mt-6 max-w-xl text-lg text-grijs md:text-xl">Een dressoir, tv-meubel, boekenkast, tafel, badkamermeubel of iets heel eigens: al bijna 20 jaar maken we teakhouten meubels precies op maat. Zonder standaard beperkingen, en zonder meerprijs.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={aanvragen} class="knop knop-blad">Maatwerk aanvragen<Icoon naam="pijl" /></a>
            <a href="#voorbeelden" class="knop knop-rand">Bekijk voorbeelden</a>
          </div>
        </div>
        <figure class="lg:col-span-5">
          <div class="aspect-[4/3] rounded-sm bg-wit p-5">
            <Image src={tekening} alt="Potloodtekening van een kledingkast op maat, met maten en aantekeningen voor de werkplaats" quality={78} widths={[480, 720, 1000]} sizes="(min-width: 1024px) 40vw, 100vw" loading="eager" class="tekening h-full w-full object-contain" />
          </div>
          <figcaption class="mt-3 text-xs text-grijs">Zo gaat een tekening naar de werkplaats</figcaption>
        </figure>
      </div>
    </section>

    <!-- Eerlijke prijs -->
    <section class="bg-wit py-20 md:py-28" aria-labelledby="prijs-kop">
      <div class="wrap grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-5">
          <h2 id="prijs-kop" class="text-4xl">Geen meerprijs. <span class="cursief">Wel een eerlijke prijs.</span></h2>
          <p class="mt-6 text-lg text-grijs">Voor aanpassingen aan een bestaand ontwerp rekenen we niets extra. Je betaalt alleen voor wat je krijgt:</p>
          <dl class="mt-6 divide-y divide-lijn border-y border-lijn">
            <div class="grid grid-cols-[7rem_1fr] gap-4 py-4"><dt class="font-kop text-xl">Groter</dt><dd class="text-grijs">De prijs stijgt naar verhouding mee.</dd></div>
            <div class="grid grid-cols-[7rem_1fr] gap-4 py-4"><dt class="font-kop text-xl">Kleiner</dt><dd class="text-grijs">De prijs kan juist lager uitvallen.</dd></div>
            <div class="grid grid-cols-[7rem_1fr] gap-4 py-4"><dt class="font-kop text-xl">Anders</dt><dd class="text-grijs">Andere indeling, lades of deuren: geen meerprijs voor het maatwerk zelf.</dd></div>
          </dl>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <h3 class="font-kop text-2xl">Waarom maatwerk bij Teakhuis?</h3>
          <ul class="mt-5 space-y-3.5">
            {waarom.map((t) => <li class="flex gap-3 text-lg"><Icoon naam="vink" class="mt-1.5 h-4 w-4 flex-none text-blad-diep" />{t}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- Hoe werkt maatwerk: met de aanvraagknop -->
    <section class="py-20 md:py-28" aria-labelledby="hoe-kop">
      <div class="wrap grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-5">
          <h2 id="hoe-kop" class="text-4xl">Hoe werkt maatwerk?</h2>
          <p class="mt-6 text-lg text-grijs">Het begint met jouw idee. Hoe je dat aanlevert maakt niet uit: wij kijken mee en stellen vragen tot we een goed beeld hebben. Daarna krijg je een vrijblijvend voorstel.</p>
          <a href={aanvragen} class="knop knop-blad mt-8">Maatwerk aanvragen<Icoon naam="pijl" /></a>
          <p class="mt-4 text-sm text-grijs">Of bel of app Han: <a href={site.telHref} class="num font-bold text-inkt underline underline-offset-2">{site.tel}</a></p>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="font-kop text-xl">Je idee mag van alles zijn:</p>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2">
            {idee.map((t) => <li class="flex items-center gap-3 rounded-[var(--radius-md)] bg-wit px-4 py-3.5 ring-1 ring-lijn"><Icoon naam="vink" class="h-4 w-4 flex-none text-blad-diep" />{t}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- Van idee tot levering -->
    <section class="bg-nacht py-20 text-wit md:py-28" aria-labelledby="proces-kop">
      <div class="wrap grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-4">
          <h2 id="proces-kop" class="text-4xl">Van idee tot levering.</h2>
          <p class="mt-5 max-w-sm text-as">Geen verrassingen achteraf. Je ziet eerst het voorstel en de prijs, en beslist dan.</p>
          <p class="mt-6 max-w-sm text-as"><strong class="text-wit">Levertijd:</strong> meestal ongeveer 3 tot 5 maanden.</p>
        </div>
        <ol class="lg:col-span-7 lg:col-start-6">
          {stappen.map(([t, z], i) => (
            <li class="grid grid-cols-[3rem_1fr] gap-x-4 border-t border-lijn-d py-6 last:border-b md:grid-cols-[4rem_1fr_1.3fr] md:gap-x-8">
              <span class="num font-kop text-3xl text-blad-licht">{i + 1}</span>
              <p class="font-kop text-xl leading-snug">{t}</p>
              <p class="text-as max-md:col-start-2 max-md:mt-1">{z}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Voorbeelden -->
    <section id="voorbeelden" class="scroll-mt-24 bg-wit py-20 md:py-28" aria-labelledby="proj-kop" data-voorbeelden>
      <div class="wrap">
        <div class="grid grid-cols-1 gap-y-6 lg:grid-cols-12 lg:gap-x-12">
          <h2 id="proj-kop" class="text-4xl lg:col-span-6">Eerder gemaakt.</h2>
          <p class="text-lg text-grijs lg:col-span-5 lg:col-start-8">Maatwerkprojecten van klanten: de tekening met hun maten, en het meubel dat ervan gemaakt is.</p>
        </div>
        <MaatwerkProjecten />
      </div>
    </section>

    <section class="py-20 md:py-28" aria-labelledby="vragen-kop">
      <div class="wrap grid grid-cols-1 gap-y-10 lg:grid-cols-12 lg:gap-x-12">
        <h2 id="vragen-kop" class="text-4xl lg:col-span-4">Vaak gevraagd.</h2>
        <Vragen vragen={vragen} class="lg:col-span-7 lg:col-start-6" />
      </div>
    </section>

    <section class="pb-24 md:pb-32" aria-labelledby="slot-kop">
      <div class="wrap">
        <div class="rounded-[var(--radius-xl)] bg-blad px-6 py-12 text-inkt md:px-14 md:py-16">
          <h2 id="slot-kop" class="max-w-2xl text-4xl">Heb je een idee? Wij denken graag mee.</h2>
          <p class="mt-5 max-w-xl text-lg">Een kleine aanpassing aan een bestaand model of een volledig uniek meubel: vraag vrijblijvend een ontwerp aan.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={aanvragen} class="knop bg-nacht text-wit hover:bg-inkt">Maatwerk aanvragen<Icoon naam="pijl" /></a>
            <a href={waHoi} class="knop bg-wit/70 text-inkt hover:bg-wit"><Icoon naam="wa" />Stuur een foto via WhatsApp</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Altijd zichtbare knop naar de voorbeelden (verdwijnt zodra die in beeld zijn) -->
  <a href="#voorbeelden" class="fixed right-3 z-30 flex items-center gap-2 rounded-full bg-nacht px-4 py-3 font-kop text-sm font-bold text-wit no-underline shadow-kaart transition-[opacity,transform] duration-300 bottom-[calc(4.75rem+env(safe-area-inset-bottom))] md:bottom-6 md:right-6" data-naar-voorbeelden>
    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="m3 16 5-5 4 4 3-3 6 6" /></svg>
    Bekijk voorbeelden
  </a>
  <Voet />

  <script>
    const knop = document.querySelector<HTMLElement>('[data-naar-voorbeelden]');
    const sectie = document.querySelector('[data-voorbeelden]');
    if (knop && sectie) {
      new IntersectionObserver(([e]) => {
        const weg = e.isIntersecting;
        knop.style.opacity = weg ? '0' : '';
        knop.style.transform = weg ? 'translateY(8px)' : '';
        knop.style.pointerEvents = weg ? 'none' : '';
        knop.tabIndex = weg ? -1 : 0;
      }, { rootMargin: '-20% 0px -20% 0px' }).observe(sectie);
    }
  </script>
</Base>
