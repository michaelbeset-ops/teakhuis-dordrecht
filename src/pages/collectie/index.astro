---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Kop from '../../components/Kop.astro';
import Voet from '../../components/Voet.astro';
import Kruimel from '../../components/Kruimel.astro';
import GeenFoto from '../../components/GeenFoto.astro';
import Icoon from '../../components/Icoon.astro';
import { url, absoluut } from '../../data/site';
import { groepen, producten, categorieHref, breedtes, fotoKlas, sfeerFoto, type Product, type Categorie } from '../../data/catalogus';
import { kruimelSchema } from '../../data/seo';

// Omslag per categorie: de eigen foto uit het beheer, anders liefst een sfeerfoto van een product.
const omslag = (c: Categorie, ps: Product[]) => sfeerFoto(c.foto, ps);
const aantal = (n: number) => `${n} ${n === 1 ? 'product' : 'producten'}`;
const lijstSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Collectie Teakhuis',
  itemListElement: groepen.map((g, i) => ({ '@type': 'ListItem', position: i + 1, name: g.hoofd.naam, url: absoluut(`collectie/${g.hoofd.slug}/`) })),
};
---
<Base title="Alle teakhouten meubels | Teakhuis" description={`Alle ${producten.length} teakhouten meubels van Teakhuis: eettafels, kasten, dressoirs, banken, bedden, badkamermeubels en tuinmeubelen. Vrijwel alles ook op maat, zonder meerprijs.`} schema={[lijstSchema, kruimelSchema([['Producten']], absoluut('collectie/'))]}>
  <Kop />
  <main id="inhoud">
    <section class="wrap pb-12 pt-6 md:pb-16 md:pt-8">
      <Kruimel stappen={[['Producten']]} />
      <div class="mt-10 grid grid-cols-1 gap-y-8 lg:grid-cols-12 lg:items-end lg:gap-x-12">
        <div class="lg:col-span-7">
          <h1 class="text-hero">Alle producten</h1>
          <p class="mt-5 max-w-xl text-lg text-grijs"><span class="num">{producten.length}</span> meubels en accessoires van teak, met de hand gemaakt. Vrijwel alles kan ook op jouw maat, zonder meerprijs.</p>
        </div>
        <form role="search" id="zoeken" class="lg:col-span-5" data-zoek onsubmit="return false">
          <label for="zoekveld" class="text-sm font-bold">Zoek in de collectie</label>
          <div class="relative mt-2">
            <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-grijs" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
            <input id="zoekveld" type="search" autocomplete="off" placeholder="Bijvoorbeeld Bayakayu of eettafel" class="veld pl-12" data-zoekveld />
          </div>
        </form>
      </div>
    </section>

    <section class="wrap hidden pb-20" data-resultaten aria-labelledby="zoek-kop">
      <h2 id="zoek-kop" class="border-t border-lijn-2 pt-6 font-kop text-2xl" aria-live="polite" data-zoek-kop></h2>
      <ul class="mt-6 grid grid-cols-1 gap-x-8 gap-y-1 sm:grid-cols-2 lg:grid-cols-3" data-zoek-lijst></ul>
    </section>

    <div data-overzicht>
      <!-- Hoofdcategorieen als grote tegels -->
      <section class="wrap pb-16 md:pb-24" aria-label="Categorieën">
        <ul class="grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 md:gap-x-6 lg:gap-y-14">
          {groepen.map((g, i) => {
            const f = omslag(g.hoofd, g.producten);
            return (
              <li class="min-w-0">
                <a href={categorieHref(g.hoofd)} class="product">
                  <div class="beeld aspect-[4/3]">
                    {f ? <Image src={f} alt="" quality={70} widths={breedtes(f, [320, 480, 640, 800])} sizes="(min-width: 1344px) 400px, (min-width: 768px) 31vw, 46vw" loading={i < 3 ? 'eager' : 'lazy'} class={`h-full w-full ${fotoKlas(f, 'p-4 md:p-6')}`} /> : <GeenFoto naam={g.hoofd.naam} />}
                  </div>
                  <div class="mt-4 flex items-baseline justify-between gap-3 border-b border-lijn-2 pb-3">
                    <h2 class="naam min-w-0 font-kop text-xl hyphens-auto [overflow-wrap:anywhere] sm:text-2xl md:text-3xl" lang="nl">{g.hoofd.naam}</h2>
                    <span class="num flex-none text-sm text-grijs max-sm:hidden">{g.producten.length}</span>
                  </div>
                </a>
                {g.subs.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm max-sm:hidden">
                    {g.subs.map((s) => <li><a href={categorieHref(s.cat)} class="text-grijs no-underline hover:text-inkt">{s.cat.naam}</a></li>)}
                  </ul>
                )}
              </li>
            );
          })}
        </ul>
      </section>

      <section class="bg-zand py-14 md:py-20">
        <div class="wrap flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
          <div>
            <h2 class="text-3xl">Niet gevonden wat je zoekt?</h2>
            <p class="mt-3 max-w-xl text-grijs">Bijna alles wat je hier ziet, maken we ook in jouw maat. En heb je zelf een idee of een foto, dan tekenen we het voor je uit.</p>
          </div>
          <a href={url('maatwerk/')} class="knop knop-blad flex-none">Maatwerk aanvragen<Icoon naam="pijl" /></a>
        </div>
      </section>
    </div>
  </main>
  <Voet />

  <script define:vars={{ index: url('collectie/zoek.json') }}>
    // Zoeken: de kleine index (naam, link, thumbnail, prijs) wordt pas geladen als je gaat typen.
    const veld = document.querySelector('[data-zoekveld]');
    const blok = document.querySelector('[data-resultaten]');
    const kop = document.querySelector('[data-zoek-kop]');
    const lijst = document.querySelector('[data-zoek-lijst]');
    const overzicht = document.querySelector('[data-overzicht]');
    let data = null, laden = null;
    const norm = (s) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    const haal = () => (laden ??= fetch(index).then((r) => r.json()).then((d) => (data = d.map((x) => ({ ...x, z: norm(`${x.n} ${x.c} ${x.h}`) })))));
    const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const toon = async () => {
      const q = norm(veld.value.trim());
      if (q.length < 2) { blok.classList.add('hidden'); overzicht.classList.remove('hidden'); return; }
      await haal();
      if (norm(veld.value.trim()) !== q) return;
      const woorden = q.split(/\s+/);
      const hits = data.filter((x) => woorden.every((w) => x.z.includes(w)));
      const max = 60;
      kop.textContent = hits.length ? `${hits.length} ${hits.length === 1 ? 'meubel' : 'meubels'} gevonden` : `Niets gevonden voor "${veld.value.trim()}". Probeer een ander woord, of vraag het ons: we maken het misschien op maat.`;
      lijst.innerHTML = hits.slice(0, max).map((x) => `
        <li><a href="${x.u}" class="product flex items-center gap-4 border-b border-lijn py-3">
          <span class="beeld block h-16 w-16 flex-none">${x.f ? `<img src="${x.f}" alt="" width="64" height="64" loading="lazy" class="h-full w-full object-contain p-1">` : ''}</span>
          <span class="min-w-0"><span class="naam block font-bold leading-snug">${esc(x.n)}</span>
          <span class="mt-0.5 block text-sm text-grijs"><span class="num">${esc(x.p)}</span> · ${esc(x.c)}</span></span>
        </a></li>`).join('') + (hits.length > max ? `<li class="py-3 text-sm text-grijs">en nog ${hits.length - max}, typ verder om te verfijnen</li>` : '');
      blok.classList.remove('hidden');
      overzicht.classList.add('hidden');
    };
    veld.addEventListener('focus', haal, { once: true });
    veld.addEventListener('input', toon);
    const q = new URLSearchParams(location.search).get('q');
    if (q) { veld.value = q; toon(); }
    if (location.hash === '#zoeken') veld.focus();
  </script>
</Base>
