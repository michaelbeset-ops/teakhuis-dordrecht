---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import GeenFoto from '../components/GeenFoto.astro';
import MaatwerkProjecten from '../components/MaatwerkProjecten.astro';
import { site, url, waHoi, houtkleuren, reviews } from '../data/site';
import { producten, groepen, categorieHref, productHref, eersteFoto, breedtes, prijsTekst, opWit, fotoKlas, hoofdletter } from '../data/catalogus';

import heroLive from '../assets/hero-trapezium-detail.jpg';
import productie from '../assets/productie-indonesie.jpg';
import han from '../assets/han.jpg';


// Een kaart per hoofdcategorie, met een productfoto op wit (de omslagfoto uit het beheer gaat voor).
const omslag = (g: (typeof groepen)[number]) => g.hoofd.foto ?? g.producten.map(eersteFoto).find((x) => x && opWit(x)) ?? g.producten.map(eersteFoto).find(Boolean);
const categorieKaarten = groepen.filter((g) => g.hoofd.slug !== 'onderhoudsmiddelen').map((g) => ({ g, f: omslag(g) }));

const populair = producten.filter((p) => p.uitgelicht).slice(0, 5);
const regelVan = (p: (typeof producten)[number]) => [
  p.maten.length ? `${p.maten.length} ${p.maten.length === 1 ? 'maat' : 'maten'}` : '',
  p.maatwerk ? 'ook op maat' : '',
  p.houtkleuren ? '4 houtkleuren' : p.uitvoeringen.length ? `${p.uitvoeringen.length} uitvoeringen` : '',
].filter(Boolean).join(' · ');

const stappen = [
  { icoon: 'lijst', t: 'Kies een ontwerp', z: 'Uit de collectie, of neem je eigen idee of een foto mee.' },
  { icoon: 'liniaal', t: 'Maat en houtkleur', z: 'Een standaardmaat of je eigen maten. Maatwerk kost niets extra.' },
  { icoon: 'praat', t: 'Tekening en offerte', z: 'Je krijgt een schets en een prijs. Klopt alles, dan betaal je 20% aan.' },
  { icoon: 'huis', t: 'Gemaakt en geleverd', z: 'Met de hand gemaakt in Indonesië en bij je thuis afgeleverd.' },
];

const titel = 'Teakhouten meubels op maat, zonder meerprijs | Teakhuis';
const omschrijving = 'Handgemaakte teakhouten meubels van duurzaam hout: eettafels, kasten, dressoirs, bedden en tuinmeubelen. Vrijwel alles op maat zonder meerprijs. Vraag vrijblijvend een offerte aan.';
const webSite = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.naam, url: new URL(url(''), Astro.site).href, potentialAction: { '@type': 'SearchAction', target: `${new URL(url('collectie/'), Astro.site).href}?q={zoekterm}`, 'query-input': 'required name=zoekterm' } };
---
<Base title={titel} description={omschrijving} schema={[webSite]}>
  <Kop />
  <main id="inhoud">

    <!-- 1. HERO: schermvullend, de nerf van het hout groot in beeld; de menubalk zweeft erover -->
    <section class="relative -mt-[4.75rem] flex min-h-[84svh] flex-col justify-end md:min-h-[calc(100svh-2.25rem)] overflow-hidden bg-nacht text-wit lg:-mt-[5.25rem]" aria-label="Welkom bij Teakhuis" data-hero>
      <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute inset-0 origin-top-left scale-[1.85] sm:scale-[1.7]">
          <Image src={heroLive} alt="" quality={78} widths={[640, 960, 1280, 1600, 2000, 2600]} sizes="170vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover object-[0%_0%]" />
        </div>
      </div>
      <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-nacht via-nacht/45 to-nacht/25"></div>
      <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-nacht/70 via-nacht/20 to-transparent max-lg:hidden"></div>

      <div class="wrap relative grid gap-8 pb-24 pt-32 md:pb-10 md:pt-36 lg:grid-cols-12 lg:items-end lg:gap-10 lg:pb-16">
        <div class="lg:col-span-8">
          <p class="label text-blad-licht">Teakhuis · teakhouten meubels sinds 2007</p>
          <h1 class="mt-5 max-w-[13ch] text-[clamp(2.6rem,6.4vw,6.2rem)] leading-[.95]">Teak op maat, met de hand gemaakt.</h1>
          <p class="mt-6 max-w-xl text-lg text-wit/85 md:text-xl">Duurzaam teak, direct voor jou gemaakt. Zonder winkel en voorraad, dus voordeliger. Kies een ontwerp, geef je maten door en ontvang een vrijblijvende offerte.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href={url('collectie/')} class="knop knop-blad">Kies je meubel<Icoon naam="pijl" /></a>
            <a href={url('maatwerk/')} class="knop knop-glas">Iets op maat laten maken</a>
          </div>
        </div>
        <div class="flex flex-col gap-5 lg:col-span-4 lg:items-end lg:text-right">
          <a href={waHoi} class="group flex items-center gap-3 rounded-full bg-wit/10 py-1.5 pl-1.5 pr-5 text-left no-underline ring-1 ring-wit/20 backdrop-blur-md transition-colors hover:bg-wit/20">
            <Image src={han} alt="" quality={80} widths={[112]} sizes="48px" class="h-12 w-12 flex-none rounded-full object-cover object-top ring-2 ring-blad" />
            <span><span class="block text-xs text-wit/70">Persoonlijk advies van Han, eigenaar</span><span class="num block font-kop text-lg font-extrabold leading-tight text-wit group-hover:text-blad-licht">{site.tel}</span></span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. SHOP PER CATEGORIE: rustige kaarten in dezelfde stijl als de productkaarten in de collectie -->
    <section class="wrap py-16 lg:py-24" aria-labelledby="cat-kop">
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
        <div>
          <p class="label text-blad-diep">De collectie</p>
          <h2 id="cat-kop" class="mt-3 text-4xl">Shop per categorie</h2>
        </div>
        <a href={url('collectie/')} class="knop knop-rand min-h-11 px-5 text-sm">Alle {producten.length} ontwerpen<Icoon naam="pijl" /></a>
      </div>
      <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 md:gap-x-6 lg:grid-cols-5 lg:gap-y-10">
        {categorieKaarten.map(({ g, f }, i) => (
          <li class="min-w-0">
            <a href={categorieHref(g.hoofd)} class="product group">
              <div class="beeld relative aspect-square">
                {f ? <Image src={f} alt="" quality={70} widths={breedtes(f, [240, 360, 480])} sizes="(min-width: 1024px) 240px, (min-width: 640px) 31vw, 46vw" loading={i < 5 ? 'eager' : 'lazy'} class={`h-full w-full ${fotoKlas(f, 'p-4 sm:p-6')}`} /> : <GeenFoto naam={g.hoofd.naam} />}
              </div>
              <p class="mt-3 flex flex-wrap items-baseline justify-between gap-x-2">
                <span class="naam min-w-0 font-kop text-[.88rem] font-extrabold leading-tight [font-stretch:96%] hyphens-auto [overflow-wrap:anywhere] sm:text-lg sm:[font-stretch:108%]" lang="nl">{g.hoofd.naam}</span>
                <span class="num flex-none text-sm text-grijs">{g.producten.length}</span>
              </p>
              {g.subs.length > 0 && <p class="mt-1 line-clamp-1 text-sm text-grijs">{hoofdletter(g.subs.slice(0, 3).map((x) => x.cat.naam.replace(/^Teak /i, '').toLowerCase()).join(', '))}</p>}
            </a>
          </li>
        ))}
        <li class="min-w-0">
          <a href={url('maatwerk/')} class="group block">
            <div class="flex aspect-square flex-col justify-between rounded-[var(--radius-md)] bg-nacht p-5 text-wit transition-colors group-hover:bg-nacht-2">
              <Icoon naam="liniaal" class="h-8 w-8 text-blad-licht" />
              <span class="font-kop text-lg font-extrabold leading-tight sm:text-xl">Staat het er niet tussen?</span>
            </div>
            <p class="mt-3 flex items-center justify-between gap-2 font-kop text-[.88rem] font-extrabold sm:text-lg">Maatwerk<Icoon naam="pijl" class="h-4 w-4 text-blad-diep transition-transform group-hover:translate-x-1" /></p>
            <p class="mt-1 text-sm text-grijs">Wij tekenen het voor je</p>
          </a>
        </li>
      </ul>
    </section>

    <!-- 3b. PERSOONLIJK: Han is de eigenaar; geen winkel, dus voordeliger -->
    <section class="wrap pb-20 lg:pb-28" aria-labelledby="han-kop">
      <div class="grid items-center gap-10 overflow-hidden rounded-[var(--radius-xl)] bg-nacht p-6 text-wit sm:p-10 lg:grid-cols-12 lg:gap-14 lg:p-14">
        <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center lg:col-span-4 lg:flex-col lg:items-start">
          <Image src={han} alt="Han Rietdijk, eigenaar van Teakhuis" quality={82} widths={[192]} sizes="(min-width: 1024px) 192px, 112px" class="h-36 w-28 flex-none rounded-[var(--radius-md)] object-cover object-top ring-4 ring-blad lg:h-64 lg:w-48" />
          <div>
            <p class="font-kop text-2xl font-extrabold">Han Rietdijk</p>
            <p class="text-as">Eigenaar van Teakhuis</p>
            <div class="mt-4 flex flex-wrap gap-2">
              <a href={waHoi} class="knop knop-blad min-h-11 px-4 text-sm"><Icoon naam="wa" />App Han</a>
              <a href={site.telHref} class="knop knop-glas min-h-11 px-4 text-sm"><Icoon naam="tel" /><span class="num">{site.tel}</span></a>
            </div>
          </div>
        </div>
        <div class="lg:col-span-8">
          <p class="label text-blad-licht">Persoonlijk en op bestelling</p>
          <h2 id="han-kop" class="mt-4 text-4xl">Geen winkel. <span class="cursief">Wel een vast aanspreekpunt.</span></h2>
          <p class="mt-5 max-w-2xl text-lg text-as">Teakhuis heeft geen showroom en geen voorraad meer. Je meubel wordt voor jou gemaakt, direct bij onze producenten in Indonesië. Omdat de kosten veel lager zijn, werken we voordeliger. En je hebt één aanspreekpunt: Han, van het eerste advies tot de bezorging.</p>
        </div>
      </div>
    </section>

    <!-- 4. UITGELICHT: productregels zoals afzetbak, met maten en vanaf-prijs -->
    {populair.length > 0 && (
      <section class="bg-zand py-20 lg:py-28" aria-labelledby="pop-kop">
        <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-4">
            <p class="label text-blad-diep">Uit de collectie</p>
            <h2 id="pop-kop" class="mt-4 text-4xl">Uitgelicht.</h2>
            <p class="mt-5 text-lg text-grijs">Een greep uit de collectie. Elk ontwerp kun je in je eigen maat en houtkleur laten maken.</p>
            <a href={url('collectie/')} class="knop knop-blad mt-8">Hele collectie<Icoon naam="pijl" /></a>
          </div>
          <ul class="grid gap-3 lg:col-span-8">
            {populair.map((p, i) => {
              const f = eersteFoto(p);
              return (
                <li class="rijs" style={`--d:${i * .05}s`}>
                  <a href={productHref(p)} class="group flex items-stretch overflow-hidden rounded-[var(--radius-md)] bg-wit no-underline shadow-zacht ring-1 ring-lijn transition-all hover:-translate-y-0.5 hover:shadow-kaart">
                    <div class="w-24 flex-none overflow-hidden bg-wit sm:w-36">
                      {f ? <Image src={f} alt="" quality={66} widths={breedtes(f, [160, 300])} sizes="144px" class={`h-full w-full ${fotoKlas(f, 'p-2')}`} /> : <GeenFoto naam={p.titel} />}
                    </div>
                    <div class="flex min-w-0 flex-1 flex-wrap items-center justify-between gap-x-6 gap-y-1 px-4 py-4 sm:px-6">
                      <div class="min-w-0">
                        <p class="label text-[.68rem] text-grijs">{p.categorie.naam}</p>
                        <h3 class="mt-1 font-kop text-lg font-extrabold leading-tight text-inkt group-hover:text-blad-diep sm:text-xl">{p.titel}</h3>
                        {regelVan(p) && <p class="mt-1 text-sm text-grijs">{regelVan(p)}</p>}
                      </div>
                      <p class="flex items-center gap-3"><span class="num font-kop text-lg font-extrabold text-blad-diep">{prijsTekst(p)}</span><Icoon naam="pijl" class="h-4 w-4 text-grijs transition-transform group-hover:translate-x-1 group-hover:text-blad-diep" /></p>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )}

    <!-- 5. ZO WERKT HET: donker paneel met de stappen, zoals bij afzetbak en ZBN -->
    <section class="wrap py-20 lg:py-28" aria-labelledby="werkt-kop">
      <div class="relative isolate overflow-hidden rounded-[var(--radius-xl)] bg-nacht text-wit">
        <div class="grid lg:grid-cols-12">
          <div class="p-7 sm:p-10 lg:col-span-7 lg:p-16">
            <p class="label text-blad-licht">Zo werkt het</p>
            <h2 id="werkt-kop" class="mt-4 text-4xl">Van idee tot meubel, <span class="cursief">in vier stappen.</span></h2>
            <p class="mt-5 max-w-lg text-lg text-as">Alles wordt voor jou gemaakt. Daarom begint het met een offerte, niet met afrekenen.</p>
            <ol class="mt-12 grid gap-8 sm:grid-cols-2">
              {stappen.map((s, i) => (
                <li class="flex gap-4">
                  <span class="relative grid h-14 w-14 flex-none place-items-center rounded-full bg-wit/10 text-blad-licht ring-1 ring-wit/15">
                    <Icoon naam={s.icoon} class="h-6 w-6" />
                    <span class="num absolute -right-1 -top-1 grid h-6 w-6 place-items-center rounded-full bg-blad font-kop text-xs font-extrabold text-inkt">{i + 1}</span>
                  </span>
                  <span><span class="block font-kop text-lg font-extrabold">{s.t}</span><span class="mt-1 block text-sm text-as">{s.z}</span></span>
                </li>
              ))}
            </ol>
            <div class="mt-12 flex flex-col gap-3 sm:flex-row">
              <a href={url('collectie/')} class="knop knop-blad">Begin met kiezen<Icoon naam="pijl" /></a>
              <a href={url('maatwerk/')} class="knop knop-glas">Meer over maatwerk</a>
            </div>
          </div>
          <div class="relative min-h-[18rem] lg:col-span-5">
            <Image src={productie} alt="Productie van teakhouten meubels bij onze producenten: een paneel in een lijmpers, met stapels teakhout" quality={72} widths={[480, 720, 1000]} sizes="(min-width: 1024px) 40vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
            <span aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-nacht/85 via-nacht/20 to-transparent lg:bg-gradient-to-r lg:from-nacht lg:via-nacht/30 lg:to-nacht/30"></span>
            <p class="absolute bottom-5 left-5 right-5 text-sm text-wit/85 lg:left-auto lg:text-right">Bij onze producenten in Indonesië</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. MAATWERK: van hun eigen tekening naar het meubel -->
    <section id="maatwerk" class="bg-wit py-20 lg:py-28">
      <div class="wrap">
        <div class="grid grid-cols-1 gap-y-6 lg:grid-cols-12 lg:gap-x-12">
          <div class="lg:col-span-6">
            <p class="label text-blad-diep">Maatwerk zonder meerprijs</p>
            <h2 class="mt-4 text-4xl">Eerst getekend, <span class="cursief">dan gemaakt.</span></h2>
          </div>
          <p class="text-lg text-grijs lg:col-span-5 lg:col-start-8 lg:pt-10">Elk maatwerkmeubel begint als tekening met jouw maten. Die gaat zo naar de meubelmakers. Vier projecten die we eerder maakten:</p>
        </div>
        <MaatwerkProjecten />
        <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href={url('maatwerk/')} class="knop knop-blad">Maatwerk aanvragen<Icoon naam="pijl" /></a>
          <p class="text-sm text-grijs">Of app je idee of een foto naar <a href={waHoi} class="num font-bold text-inkt underline underline-offset-2">{site.tel}</a></p>
        </div>
      </div>
    </section>

    <!-- 7. HOUTKLEUREN -->
    <section class="py-20 lg:py-28" aria-labelledby="kleur-kop">
      <div class="wrap grid grid-cols-1 gap-y-10 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-4">
          <p class="label text-blad-diep">Afwerking</p>
          <h2 id="kleur-kop" class="mt-4 text-4xl">Vier kleuren teak.</h2>
          <p class="mt-5 max-w-sm text-grijs">Elk meubel maken we in de kleur die bij jouw interieur past. Twijfel je? Kies "weet ik nog niet", dan denken we mee.</p>
        </div>
        <ul class="grid grid-cols-2 items-start gap-4 sm:grid-cols-4 lg:col-span-8">
          {houtkleuren.map((k, i) => (
            <li class="rijs overflow-hidden rounded-[var(--radius-md)] bg-wit ring-1 ring-lijn" style={`--d:${i * .05}s`}>
              <Image src={k.img} alt={`Staal teakhout in ${k.naam.toLowerCase()}`} quality={80} widths={[256]} sizes="(min-width: 640px) 200px, 45vw" class="aspect-[4/3] w-full object-cover" />
              <p class="px-4 py-3 font-kop font-extrabold">{k.naam}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 8. REVIEWS: echte reacties van klanten; de Google-review linkt naar het bedrijfsprofiel -->
    <section class="overflow-hidden bg-zand py-20 lg:py-28" aria-labelledby="ref-kop">
      <div class="wrap grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="label text-blad-diep">Ervaringen</p>
          <h2 id="ref-kop" class="mt-4 text-4xl">Wat klanten zeggen.</h2>
        </div>
        <div class="flex flex-wrap items-center gap-3 lg:col-span-5 lg:justify-end">
          <a href={site.google} target="_blank" rel="noopener" class="flex items-center gap-3 rounded-full bg-wit py-2 pl-2 pr-5 no-underline shadow-zacht ring-1 ring-lijn transition-shadow hover:shadow-kaart">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-wit ring-1 ring-lijn"><Icoon naam="g" class="h-5 w-5" /></span>
            <span class="text-sm font-bold text-inkt">Bekijk ons op Google<span class="sr-only"> (opent in een nieuw tabblad)</span></span>
          </a>
          <div class="hidden gap-2 md:flex">
            <button type="button" class="grid h-11 w-11 place-items-center rounded-full bg-wit shadow-zacht ring-1 ring-lijn hover:bg-nacht hover:text-wit" aria-label="Vorige reviews" data-slider-terug><Icoon naam="pijl" class="h-4 w-4 rotate-180" /></button>
            <button type="button" class="grid h-11 w-11 place-items-center rounded-full bg-wit shadow-zacht ring-1 ring-lijn hover:bg-nacht hover:text-wit" aria-label="Volgende reviews" data-slider-verder><Icoon naam="pijl" class="h-4 w-4" /></button>
          </div>
        </div>
      </div>
      <ul class="slider mt-10 [--inzet:max(1.25rem,calc((100vw-84rem)/2+2.5rem))] px-[var(--inzet)] [scroll-padding-left:var(--inzet)]" data-slider>
        <li class="flex w-[19rem] flex-col rounded-[var(--radius-xl)] bg-nacht p-7 text-wit sm:w-[23rem]">
          <div class="flex items-center gap-4">
            <Image src={han} alt="Han Rietdijk" quality={80} widths={[128]} sizes="64px" class="h-16 w-16 rounded-full object-cover object-top ring-2 ring-blad" />
            <div><p class="font-kop text-lg font-extrabold">Han Rietdijk</p><p class="text-sm text-as">Eigenaar van Teakhuis</p></div>
          </div>
          <p class="mt-6 flex-1 text-as">Bij Teakhuis spreek je de eigenaar zelf. Een vraag over een maat, een kleur of een levering? Bel of app gerust.</p>
          <a href={waHoi} class="knop knop-blad mt-6 self-start"><Icoon naam="wa" />App Han</a>
        </li>
        {[...reviews].sort((x, y) => Number(y.bron === 'google') - Number(x.bron === 'google')).map((r) => {
          const google = r.bron === 'google';
          const link = google ? site.google : url('over-ons/#referenties');
          return (
            <li class="flex w-[19rem] sm:w-[23rem]">
              <a href={link} {...(google ? { target: '_blank', rel: 'noopener' } : {})} class="flex w-full flex-col rounded-[var(--radius-xl)] bg-wit p-7 text-inkt no-underline shadow-zacht ring-1 ring-lijn transition-shadow hover:shadow-kaart">
                <div class="flex items-center justify-between gap-3">
                  {google
                    ? <span class="flex items-center gap-1.5 text-xs font-bold text-grijs"><Icoon naam="g" class="h-4 w-4" />Google</span>
                    : <span class="flex items-center gap-1.5 text-xs font-bold text-grijs"><svg viewBox="0 0 100 100" class="h-4 w-4" aria-hidden="true"><circle cx="50" cy="50" r="50" fill="#6aab35" /><path d="M28 52 50 34l22 18M35 47v20h30V47" fill="none" stroke="#fff" stroke-width="8" stroke-linejoin="round" stroke-linecap="round" /></svg>Teakhuis</span>}
                  {r.sterren ? <span class="flex gap-0.5 text-[#f4b400]" role="img" aria-label={`${r.sterren} van 5 sterren`}>{Array.from({ length: r.sterren }, () => <Icoon naam="ster" class="h-4 w-4" />)}</span> : <span class="text-xs font-semibold text-grijs">Referentie</span>}
                </div>
                <blockquote class="mt-5 flex-1"><p class="text-[1.05rem] leading-relaxed">“{r.tekst}”</p></blockquote>
                <div class="mt-6 flex items-center gap-3 border-t border-lijn pt-4">
                  <span class="grid h-10 w-10 flex-none place-items-center rounded-full bg-zand font-kop text-sm font-extrabold text-blad-diep">{r.naam.split(/\s+/).filter((w) => /^\p{Lu}/u.test(w)).map((w) => w[0]).join('').slice(0, 2)}</span>
                  <span class="min-w-0 text-sm"><strong class="block font-kop font-extrabold">{r.naam}</strong><span class="text-grijs">{google ? 'Review op Google' : `Referentie${r.over ? `, ${r.over}` : ''}`}</span></span>
                  <Icoon naam="pijl" class="ml-auto h-4 w-4 flex-none text-grijs" />
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- 9. OFFERTE: groen paneel zoals bij ZBN, met de drie manieren om te beginnen -->
    <section class="wrap py-20 lg:py-28" aria-labelledby="offerte-kop">
      <div class="grid overflow-hidden rounded-[var(--radius-xl)] bg-blad text-inkt shadow-kaart lg:grid-cols-12">
        <div class="p-7 sm:p-10 lg:col-span-5 lg:p-14">
          <p class="label">Vrijblijvende offerte</p>
          <h2 id="offerte-kop" class="mt-4 text-4xl">Vertel ons wat je zoekt.</h2>
          <p class="mt-5 text-lg">Kies een meubel, laat iets op maat tekenen of stuur een foto van wat je in gedachten hebt. Je krijgt een offerte met tekening en prijs.</p>
          <p class="mt-10 font-semibold">Liever direct iemand spreken?</p>
          <a href={site.telHref} class="num mt-1 inline-block font-kop text-3xl font-extrabold text-inkt no-underline hover:underline">{site.tel}</a>
        </div>
        <ul class="grid content-center gap-3 bg-wit p-5 sm:p-8 lg:col-span-7 lg:p-12">
          {[
            { href: url('collectie/'), icoon: 'lijst', t: 'Kies uit de collectie', z: 'Kies maat en houtkleur en zet het in je offerteaanvraag.' },
            { href: url('maatwerk/'), icoon: 'liniaal', t: 'Laat iets op maat maken', z: 'Geef het meubel, de maten en de kleur door. Wij tekenen het uit.' },
            { href: waHoi, icoon: 'wa', t: 'Stuur een foto via WhatsApp', z: 'Een foto of schets zegt vaak meer dan woorden.' },
          ].map((a) => (
            <li>
              <a href={a.href} class="group flex items-center gap-5 rounded-[var(--radius-md)] p-4 no-underline ring-1 ring-lijn transition-all hover:bg-zand hover:ring-lijn-2 sm:p-5">
                <span class="grid h-14 w-14 flex-none place-items-center rounded-full bg-nacht text-blad-licht"><Icoon naam={a.icoon} class="h-6 w-6" /></span>
                <span class="min-w-0 flex-1"><span class="block font-kop text-lg font-extrabold text-inkt">{a.t}</span><span class="mt-0.5 block text-sm text-grijs">{a.z}</span></span>
                <Icoon naam="pijl" class="h-5 w-5 flex-none text-inkt transition-transform group-hover:translate-x-1" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Voet />

  <script>
    // Reviewslider: pijlen schuiven één kaart op.
    const slider = document.querySelector<HTMLElement>('[data-slider]');
    if (slider) {
      const stap = () => (slider.firstElementChild as HTMLElement).offsetWidth + 20;
      document.querySelector('[data-slider-terug]')?.addEventListener('click', () => slider.scrollBy({ left: -stap(), behavior: 'smooth' }));
      document.querySelector('[data-slider-verder]')?.addEventListener('click', () => slider.scrollBy({ left: stap(), behavior: 'smooth' }));
    }
  </script>
</Base>
