---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import ProductKaart from '../components/ProductKaart.astro';
import GeenFoto from '../components/GeenFoto.astro';
import MaatwerkProjecten from '../components/MaatwerkProjecten.astro';
import { site, url, waHoi, houtkleuren, reviews } from '../data/site';
import { producten, groepen, categorieHref, productHref, eersteFoto, breedtes, prijsTekst, opWit, fotoKlas } from '../data/catalogus';

import heroFoto from '../assets/hero-trapezium-detail.jpg';
import han from '../assets/han.jpg';
import productie from '../assets/productie-indonesie.jpg';
import vikingDetail from '../assets/tuintafel-viking-detail.jpg';

// Uitgelicht in het beheer; de eerste krijgt de grote plek.
const uitgelicht = producten.filter((p) => p.uitgelicht).slice(0, 7);
const [groot, ...rest] = uitgelicht;
const grootFoto = groot ? eersteFoto(groot) : undefined;
const trapezium = producten.find((p) => p.slug === 'tuintafel-trapezium');


const titel = 'Teakhouten meubels op maat, zonder meerprijs | Teakhuis';
const omschrijving = 'Handgemaakte teakhouten meubels van duurzaam hout: eettafels, kasten, dressoirs, bedden en tuinmeubelen. Vrijwel alles op maat zonder meerprijs. Vraag vrijblijvend een offerte aan.';
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. HERO: donker, de nerf van een live-edge tafelblad groot in beeld -->
    <section class="relative isolate overflow-hidden bg-nacht text-wit">
      <div class="grid min-h-[calc(100svh-7rem)] grid-cols-1 lg:grid-cols-12">
        <div class="relative order-2 flex flex-col justify-end px-5 pb-14 pt-10 md:px-10 md:pb-16 lg:order-1 lg:col-span-6 lg:pb-20 lg:pl-[max(2.5rem,calc((100vw-84rem)/2+2.5rem))] lg:pr-12 lg:pt-24">
          <p class="label text-blad-licht">Teakhouten meubels, sinds 2007</p>
          <h1 class="mt-5 text-hero">Met de hand gemaakt. <span class="cursief text-[#e9d9bf]">Op jouw maat.</span></h1>
          <p class="mt-6 max-w-lg text-lg text-as md:text-xl">Eettafels, kasten, dressoirs en meer van duurzaam teak. Kies een ontwerp, geef je eigen maten door en ontvang een vrijblijvende offerte.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href={url('collectie/')} class="knop knop-blad">Bekijk de collectie<Icoon naam="pijl" /></a>
            <a href={url('maatwerk/')} class="knop knop-wit">Iets eigens laten maken</a>
          </div>
          <ul class="mt-12 grid max-w-xl grid-cols-1 gap-3 border-t border-lijn-d pt-6 text-sm text-as sm:grid-cols-3">
            <li class="flex items-start gap-2"><Icoon naam="liniaal" class="mt-0.5 h-4 w-4 flex-none text-blad-licht" />Maatwerk zonder meerprijs</li>
            <li class="flex items-start gap-2"><Icoon naam="blad" class="mt-0.5 h-4 w-4 flex-none text-blad-licht" />Alleen duurzaam hout</li>
            <li class="flex items-start gap-2"><Icoon naam="huis" class="mt-0.5 h-4 w-4 flex-none text-blad-licht" />Thuis geleverd</li>
          </ul>
        </div>
        <div class="relative order-1 aspect-[4/3] overflow-hidden sm:aspect-[16/10] lg:order-2 lg:col-span-6 lg:aspect-auto">
          <Image src={heroFoto} alt="Hoek van een teakhouten tafelblad met live edge en zichtbare houtnerf op een mat zwarte stalen poot" quality={78} widths={[640, 960, 1280, 1600, 2000]} sizes="(min-width: 1024px) 50vw, 100vw" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full origin-top-left scale-[2.1] object-cover object-[0%_0%] sm:scale-[1.9] lg:scale-[1.6]" />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-nacht/50 via-transparent to-transparent lg:bg-gradient-to-r lg:from-nacht/40" aria-hidden="true"></div>
          {trapezium && <a href={productHref(trapezium)} class="absolute bottom-4 right-4 rounded-sm bg-nacht/75 px-3 py-1.5 text-xs font-semibold text-wit no-underline backdrop-blur-sm hover:bg-nacht">In beeld: Tuintafel trapezium</a>}
        </div>
      </div>
    </section>

    <!-- 2. CATEGORIEEN: kies waar je naar zoekt -->
    <section class="py-20 md:py-28" aria-labelledby="cat-kop">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 id="cat-kop" class="rijs max-w-2xl text-4xl">Waar ben je <span class="cursief">naar op zoek?</span></h2>
          <a href={url('collectie/')} class="rijs link text-sm font-bold">Hele collectie</a>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-4 md:gap-x-6">
          {groepen.slice(0, 8).map((g, i) => {
            const f = g.hoofd.foto ?? g.producten.map(eersteFoto).find((x) => x && opWit(x)) ?? g.producten.map(eersteFoto).find(Boolean);
            return (
              <li class="rijs min-w-0" style={`--d:${(i % 4) * .05}s`}>
                <a href={categorieHref(g.hoofd)} class="product">
                  <div class="beeld aspect-square">
                    {f ? <Image src={f} alt="" quality={68} widths={breedtes(f, [240, 360, 480])} sizes="(min-width: 1024px) 240px, (min-width: 640px) 31vw, 46vw" class={`h-full w-full ${fotoKlas(f, 'p-4')}`} /> : <GeenFoto naam={g.hoofd.naam} />}
                  </div>
                  <p class="mt-3 flex items-baseline justify-between gap-2">
                    <span class="naam min-w-0 font-kop text-lg leading-tight hyphens-auto [overflow-wrap:anywhere] sm:text-xl" lang="nl">{g.hoofd.naam}</span>
                    <span class="num text-xs text-grijs max-sm:hidden">{g.producten.length}</span>
                  </p>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <!-- 3. ZO WERKT HET: van ontwerp naar offerte, zoals op de productpagina -->
    <section class="border-y border-lijn bg-zand py-20 md:py-28" aria-labelledby="werkt-kop">
      <div class="wrap grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-4">
          <h2 id="werkt-kop" class="rijs text-4xl">Zo vraag je een meubel aan.</h2>
          <p class="rijs mt-5 max-w-sm text-lg text-grijs" style="--d:.06s">Alles wordt voor jou gemaakt. Daarom begint het met een offerte, niet met afrekenen.</p>
        </div>
        <ol class="grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:col-span-8">
          {[
            ['Kies een ontwerp', 'Uit de collectie, of neem je eigen idee mee.'],
            ['Kies maat en houtkleur', 'Een standaardmaat of je eigen maten. Maatwerk kost niets extra.'],
            ['Ontvang je offerte', 'Met tekening en prijs. Klopt alles, dan betaal je 20% aan.'],
            ['Thuis geleverd', 'Met de hand gemaakt in Indonesië en bij je thuis afgeleverd.'],
          ].map(([t, z], i) => (
            <li class="rijs border-t-2 border-inkt pt-5" style={`--d:${i * .06}s`}>
              <span class="num font-kop text-4xl text-blad-diep">{i + 1}</span>
              <p class="mt-3 text-lg font-bold">{t}</p>
              <p class="mt-1 text-grijs">{z}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 4. UITGELICHT: een grote, zes kleine -->
    {groot && (
      <section class="py-20 md:py-28" aria-labelledby="uit-kop">
        <div class="wrap">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <h2 id="uit-kop" class="rijs text-4xl">Uit de collectie.</h2>
            <a href={url('collectie/')} class="rijs knop knop-rand">Alle {producten.length} meubels<Icoon naam="pijl" /></a>
          </div>
          <div class="mt-12 grid grid-cols-1 gap-x-6 gap-y-10 lg:grid-cols-12">
            <a href={productHref(groot)} class="product rijs lg:col-span-6">
              <div class="beeld aspect-square lg:aspect-auto lg:h-[calc(100%-5.5rem)]">
                {grootFoto ? <Image src={grootFoto} alt={groot.titel} quality={74} widths={breedtes(grootFoto, [480, 720, 960, 1200])} sizes="(min-width: 1024px) 50vw, 100vw" class={`h-full w-full ${fotoKlas(grootFoto, 'p-6 md:p-10')}`} /> : <GeenFoto naam={groot.titel} groot />}
              </div>
              <div class="mt-4 flex items-baseline justify-between gap-4">
                <div>
                  <p class="label text-blad-diep">{groot.categorie.naam}</p>
                  <h3 class="naam mt-1 text-3xl">{groot.titel}</h3>
                </div>
                <p class="num flex-none text-grijs">{prijsTekst(groot)}</p>
              </div>
            </a>
            <ul class="grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 md:gap-x-6 lg:col-span-6">
              {rest.slice(0, 6).map((p, i) => <li class="rijs" style={`--d:${(i % 3) * .06}s`}><ProductKaart p={p} /></li>)}
            </ul>
          </div>
        </div>
      </section>
    )}

    <!-- 5. MAATWERK: van hun eigen tekening naar het meubel -->
    <section id="maatwerk" class="bg-wit py-20 md:py-32">
      <div class="wrap">
        <div class="grid grid-cols-1 gap-y-6 lg:grid-cols-12 lg:gap-x-12">
          <div class="lg:col-span-6">
            <p class="rijs label text-blad-diep">Maatwerk zonder meerprijs</p>
            <h2 class="rijs mt-4 text-4xl">Eerst getekend, <span class="cursief">dan gemaakt.</span></h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-5 lg:col-start-8 lg:pt-10" style="--d:.08s">Elk maatwerkmeubel begint als tekening met jouw maten. Die gaat zo naar de meubelmakers. Vier projecten die we eerder maakten:</p>
        </div>

        <MaatwerkProjecten />
        <div class="rijs mt-12 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href={url('maatwerk/')} class="knop knop-inkt">Maatwerk aanvragen<Icoon naam="pijl" /></a>
          <p class="text-sm text-grijs">Of app je idee of een foto naar <a href={waHoi} class="num font-bold text-inkt underline underline-offset-2">{site.tel}</a></p>
        </div>
      </div>
    </section>

    <!-- 6. HOUTKLEUREN -->
    <section class="py-20 md:py-28" aria-labelledby="kleur-kop">
      <div class="wrap grid grid-cols-1 gap-y-10 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-4">
          <h2 id="kleur-kop" class="rijs text-4xl">Vier kleuren teak.</h2>
          <p class="rijs mt-5 max-w-sm text-grijs" style="--d:.06s">Elk meubel maken we in de kleur die bij jouw interieur past. Twijfel je? Kies "weet ik nog niet", dan denken we mee.</p>
        </div>
        <ul class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-4 lg:col-span-8">
          {houtkleuren.map((k, i) => (
            <li class="rijs" style={`--d:${i * .06}s`}>
              <Image src={k.img} alt={`Staal teakhout in ${k.naam.toLowerCase()}`} quality={80} widths={[256]} sizes="(min-width: 640px) 180px, 45vw" class="aspect-square w-full rounded-full object-cover shadow-[inset_0_0_0_1px_#0000001a]" />
              <p class="mt-4 text-center font-kop text-xl">{k.naam}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7. WAAROM TEAK: donker, met de nerf van de Tuintafel Viking -->
    <section class="relative isolate overflow-hidden bg-nacht text-wit">
      <div class="grid grid-cols-1 lg:grid-cols-2">
        <div class="relative min-h-[16rem] overflow-hidden sm:min-h-[22rem] lg:order-2 lg:min-h-full">
          <Image src={vikingDetail} alt="Close-up van de latten van gerecycled teak op het zwarte stalen frame van de Tuintafel Viking" quality={72} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full origin-top-left scale-[1.75] object-cover object-[0%_0%]" />
        </div>
        <div class="px-5 py-20 md:px-10 md:py-28 lg:pl-[max(2.5rem,calc((100vw-84rem)/2+2.5rem))] lg:pr-16">
          <h2 class="rijs text-4xl">Waarom <span class="cursief text-[#e9d9bf]">teak?</span></h2>
          <dl class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2">
            <div class="rijs" style="--d:.05s"><dt class="font-kop text-2xl text-blad-licht">Sterk</dt><dd class="mt-1 text-as">Teak wordt nog steeds gebruikt in de scheepsbouw. Het kan wel tegen een stootje.</dd></div>
            <div class="rijs" style="--d:.1s"><dt class="font-kop text-2xl text-blad-licht">Warm</dt><dd class="mt-1 text-as">Een strak teakhouten meubel geeft een modern interieur een gezellige sfeer.</dd></div>
            <div class="rijs" style="--d:.15s"><dt class="font-kop text-2xl text-blad-licht">Duurzaam</dt><dd class="mt-1 text-as">Gerecycled teak uit oude huizen en gebouwen op Oost-Java, en plantagehout met SVLK-certificaat.</dd></div>
            <div class="rijs" style="--d:.2s"><dt class="font-kop text-2xl text-blad-licht">Weinig onderhoud</dt><dd class="mt-1 text-as">Door de dichtheid en de natuurlijke oliën in het hout.</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- 8. OVER TEAKHUIS EN REFERENTIES -->
    <section class="py-20 md:py-32" aria-labelledby="over-kop">
      <div class="wrap grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-6">
          <h2 id="over-kop" class="rijs text-4xl">Sinds 2007 in teak. <span class="cursief">Nu online en op bestelling.</span></h2>
          <p class="rijs mt-7 max-w-xl text-lg" style="--d:.08s">We hadden showrooms, nu werken we online, per mail en telefonisch. Zo heeft onze adviseur meer tijd per klant en werken we voordeliger. Alle maatwerk is nog steeds mogelijk.</p>
          <div class="rijs mt-9 flex items-center gap-5" style="--d:.12s">
            <Image src={han} alt="Han Rietdijk aan zijn bureau met een laptop en meubeltekeningen" quality={80} widths={[160, 192]} sizes="96px" class="h-24 w-[4.5rem] flex-none rounded-sm object-cover object-top" />
            <div>
              <p class="font-kop text-xl">Han Rietdijk</p>
              <p class="text-sm text-grijs">Adviseur, bezorger en service</p>
              <a href={site.telHref} class="link num mt-1 inline-block text-sm font-bold text-blad-diep">{site.tel}</a>
            </div>
          </div>
          <a href={url('over-ons/')} class="rijs link mt-9 inline-block text-sm font-bold">Meer over Teakhuis</a>
        </div>
        <figure class="rijs lg:col-span-5 lg:col-start-8" style="--d:.1s">
          <Image src={productie} alt="Productie van teakhouten meubels: een paneel in een lijmpers, met stapels teakhout op de vloer" quality={72} widths={[480, 720, 1000]} sizes="(min-width: 1024px) 40vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover" />
          <figcaption class="mt-3 text-xs text-grijs">Teak in productie bij onze producenten in Indonesië</figcaption>
        </figure>
      </div>

      <div class="wrap mt-20 md:mt-28">
        <blockquote class="rijs max-w-4xl">
          <p class="font-kop text-3xl leading-[1.2] md:text-4xl">“{reviews[0].tekst}”</p>
          <footer class="mt-5 text-sm text-grijs"><span class="font-bold text-inkt">{reviews[0].naam}</span>, {reviews[0].bron}</footer>
        </blockquote>
        <div class="mt-14 grid gap-x-10 gap-y-10 md:grid-cols-3">
          {reviews.slice(1).map((r, i) => (
            <blockquote class="rijs border-t-2 border-inkt pt-6" style={`--d:${i * .08}s`}>
              <p class="text-lg">“{r.tekst}”</p>
              <footer class="mt-4 text-sm text-grijs"><span class="font-bold text-inkt">{r.naam}</span>, {r.bron}</footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- 9. CONTACT -->
    <section class="bg-blad py-20 text-inkt md:py-24">
      <div class="wrap grid grid-cols-1 items-end gap-y-10 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-7">
          <h2 class="rijs text-4xl">Vragen? Bel, app of mail ons.</h2>
          <p class="rijs mt-5 max-w-xl text-lg" style="--d:.08s">Over een meubel, een maat of een levering. We denken graag met je mee.</p>
        </div>
        <div class="rijs flex flex-col gap-3 sm:flex-row sm:flex-wrap lg:col-span-5 lg:justify-end" style="--d:.1s">
          <a href={waHoi} class="knop knop-inkt"><Icoon naam="wa" />WhatsApp</a>
          <a href={site.telHref} class="knop knop-rand"><Icoon naam="tel" /><span class="num">{site.tel}</span></a>
        </div>
      </div>
    </section>
  </main>
  <Voet />

</Base>
