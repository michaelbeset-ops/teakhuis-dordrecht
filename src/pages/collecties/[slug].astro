---
// Eén collectie (serie): alle meubels in dezelfde stijl, met een korte introductie en de andere collecties eronder.
import Base from '../../layouts/Base.astro';
import Kop from '../../components/Kop.astro';
import Voet from '../../components/Voet.astro';
import Kruimel from '../../components/Kruimel.astro';
import Icoon from '../../components/Icoon.astro';
import ProductKaart from '../../components/ProductKaart.astro';
import { url, absoluut } from '../../data/site';
import { collecties, collectieHref, omschrijvingHtml, platteTekst, type CollectieGroep } from '../../data/catalogus';
import { kruimelSchema, type Stap } from '../../data/seo';

export function getStaticPaths() {
  return collecties.map((g) => ({ params: { slug: g.collectie.slug }, props: { g } }));
}
const { g } = Astro.props as { g: CollectieGroep };
const { collectie: c, producten } = g;
const n = producten.length;
// De meest voorkomende soorten, hoogstens drie: "dressoirs, tv-kasten en eettafels".
const telling = new Map<string, number>();
for (const p of producten) telling.set(p.categorie.naam.toLowerCase(), (telling.get(p.categorie.naam.toLowerCase()) ?? 0) + 1);
const soorten = [...telling].sort((a, b) => b[1] - a[1]).map(([k]) => k.replace(/^teak /, ''));
const kort = soorten.slice(0, 3);
const opsomming = soorten.length > 3 ? `onder meer ${kort.join(', ')}` : kort.length > 1 ? `${kort.slice(0, -1).join(', ')} en ${kort.at(-1)}` : kort[0];
const intro = omschrijvingHtml(c.intro);
const standaard = `${n} ${n === 1 ? 'meubel' : 'meubels'} uit de collectie ${c.naam}: ${opsomming}. Allemaal met de hand gemaakt en ook op jouw maat, zonder meerprijs.`;
const beschrijving = c.intro ? platteTekst(c.intro).slice(0, 155).replace(/\s\S*$/, '') + '.' : standaard;
const zelf = absoluut(`collecties/${c.slug}/`);
const kruimel: Stap[] = [['Collecties', url('collecties/')], [c.naam]];
const anderen = collecties.filter((x) => x.collectie.slug !== c.slug);
const lijstSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Collectie ${c.naam}`,
  numberOfItems: n,
  itemListElement: producten.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: absoluut(`product/${p.slug}/`) })),
};
---
<Base title={`Collectie ${c.naam}: teakhouten meubels in één stijl | Teakhuis`} description={beschrijving} schema={[lijstSchema, kruimelSchema(kruimel, zelf)]}>
  <Kop />
  <main id="inhoud">
    <section class="wrap pb-10 pt-6 md:pt-8">
      <Kruimel stappen={kruimel} />
      <p class="label mt-10 text-blad-diep">Collectie</p>
      <h1 class="mt-3 text-hero">{c.naam}</h1>
      {intro
        ? <div class="tekst mt-5 max-w-2xl text-lg text-grijs" set:html={intro} />
        : <p class="mt-5 max-w-2xl text-lg text-grijs">{standaard}</p>}
    </section>

    <section class="wrap border-t border-lijn-2 pb-20 pt-10" aria-label={`Meubels uit de collectie ${c.naam}`}>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-10 sm:grid-cols-3 md:gap-x-6 lg:grid-cols-4 lg:gap-y-12">
        {producten.map((p, i) => <li><ProductKaart p={p} lazy={i >= 4} kop="h2" /></li>)}
      </ul>
    </section>

    <section class="bg-zand py-14 md:py-20">
      <div class="wrap">
        <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
          <div>
            <h2 class="text-3xl">Iets anders in de stijl {c.naam}?</h2>
            <p class="mt-3 max-w-xl text-grijs">Een kast, bank of tafel die er nog niet tussen staat, maken we in dezelfde stijl en op jouw maat.</p>
          </div>
          <a href={url('maatwerk/')} class="knop knop-blad flex-none">Maatwerk aanvragen<Icoon naam="pijl" /></a>
        </div>
        {anderen.length > 0 && (
          <nav aria-label="Andere collecties" class="mt-12 border-t border-lijn-2 pt-8">
            <p class="font-bold">Andere collecties</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {anderen.map((x) => <li><a href={collectieHref(x.collectie)} class="flex min-h-10 items-center rounded-full bg-wit px-4 text-sm font-bold text-inkt no-underline ring-1 ring-lijn hover:ring-inkt">{x.collectie.naam}<span class="num ml-2 font-normal text-grijs">{x.producten.length}</span></a></li>)}
            </ul>
          </nav>
        )}
      </div>
    </section>
  </main>
  <Voet />
</Base>
