---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Kop from '../../components/Kop.astro';
import Voet from '../../components/Voet.astro';
import Kruimel from '../../components/Kruimel.astro';
import Icoon from '../../components/Icoon.astro';
import GeenFoto from '../../components/GeenFoto.astro';
import ProductKaart from '../../components/ProductKaart.astro';
import MaatTekening from '../../components/MaatTekening.astro';
import { site, url, absoluut, houtkleuren, stappen, reviews } from '../../data/site';
import han from '../../assets/han.jpg';
import {
  producten, categorieHref, productHref, breedte, breedtes, euro, toonPrijs, prijsTekst, omschrijvingHtml, platteTekst, hoofdletter, fotoKlas, maatSoort, breedtesVan, houtsoortVan,
  type Product,
} from '../../data/catalogus';
import { kruimelSchema, type Stap } from '../../data/seo';

export function getStaticPaths() {
  return producten.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };

const cat = p.categorie;
const hoofd = p.hoofd;
const fotos = p.fotos;
const tekst = omschrijvingHtml(p.omschrijving);
const prijzen = toonPrijs(p);

// Verwant: eerst dezelfde soort, aangevuld met dezelfde hoofdcategorie.
const verwant = [
  ...producten.filter((x) => x.categorie.slug === cat.slug && x.slug !== p.slug),
  ...(hoofd ? producten.filter((x) => x.hoofd?.slug === hoofd.slug && x.categorie.slug !== cat.slug) : []),
].slice(0, 4);
const aantalCat = producten.filter((x) => x.categorie.slug === cat.slug).length;

// Maatkeuze: de standaardmaten uit het beheer, plus "andere maat" als het meubel op maat gemaakt kan worden.
const maten = p.maten;
const heeftMaatStap = maten.length > 0 || p.maatwerk;
// Een tekening heeft alleen zin als er maten zijn om aan te wijzen.
const soort = maten.length ? maatSoort(p) : null;
// Lange woorden ("wastafelmeubel") passen niet in de grote kop; die krijgt dan een kleinere maat.
const langeNaam = p.titel.split(/\s+/).some((w) => w.length > 11) || p.titel.length > 34;

// Sociaal bewijs bij de knop: een review over dit soort meubel als die er is, anders de Google-review. Alleen echte reviews.
const catTekst = `${cat.naam} ${hoofd?.naam ?? ''}`.toLowerCase();
const review = reviews.find((r) => r.over && catTekst.includes(r.over.toLowerCase())) ?? reviews.find((r) => r.bron === 'google') ?? reviews[0];
const initialen = (n: string) => (n.match(/\b\p{Lu}/gu) ?? [n[0]]).slice(0, 2).join('');

// Specificaties: alleen wat we zeker weten uit het product en de werkwijze van Teakhuis.
const hout = houtsoortVan(p);
const bs = breedtesVan(p);
const specs = ([
  ['Materiaal', hout === 'Overig' ? undefined : hout],
  ['Afwerking', p.houtkleuren ? 'Blank teak, thee kleur, koloniale kleur of wit' : p.uitvoeringen.length ? p.uitvoeringen.map(hoofdletter).join(', ') : undefined],
  ['Standaardmaten', maten.length ? `${maten.length} ${maten.length === 1 ? 'maat' : 'maten'}${bs.length > 1 ? `, van ${Math.min(...bs)} tot ${Math.max(...bs)} cm breed` : ''}` : undefined],
  ['Op maat', p.maatwerk ? 'Ja, zonder meerprijs' : undefined],
  ['Gemaakt', 'Met de hand, in Indonesië'],
  ['Levering', 'Bij je thuis afgeleverd'],
  ['Bestellen', 'Vrijblijvende offerte; na akkoord 20% aanbetaling'],
] as [string, string | undefined][]).filter((r): r is [string, string] => Boolean(r[1]));

// Veelgestelde vragen: de twijfels die een aanvraag tegenhouden, met antwoorden uit de werkwijze. Geen FAQ-schema: Google
// toont die sinds 2023 niet meer voor winkels, en 500 keer dezelfde vragen voegt niets toe.
const vragen: [string, string][] = [
  ...(p.maatwerk ? [['Kost een eigen maat extra?', 'Nee. Maatwerk kost bij Teakhuis niets extra. Je geeft je maten door en krijgt eerst een tekening en een prijs, voordat je iets beslist.'] as [string, string]] : []),
  ['Hoe werkt bestellen?', 'Zet het meubel in je offerteaanvraag en verstuur die. Je krijgt een schets en een prijsopgave. Klopt alles, dan betaal je 20% aan en wordt je meubel met de hand gemaakt en bij je thuis afgeleverd.'],
  ['Zit ik ergens aan vast als ik een offerte aanvraag?', 'Nee. De offerte is gratis en vrijblijvend. Je betaalt pas iets als je akkoord gaat met de tekening en de prijs.'],
  ['Kan ik het meubel ergens bekijken?', `Teakhuis heeft geen showroom meer. Daardoor zijn de kosten lager en de prijzen ook. Twijfel je over maat, kleur of uitvoering? Bel of app Han op ${site.tel}, hij denkt graag met je mee.`],
  ['Hoe lang duurt het voordat ik mijn meubel heb?', 'Elk meubel wordt voor jou gemaakt. De levertijd staat in je offerte, zodat je vooraf weet waar je aan toe bent.'],
  ...(hout !== 'Mangohout' && hout !== 'Overig' ? [['Waar komt het hout vandaan?', 'We werken met SVLK-gecertificeerd plantagehout en gerecycled teak uit oude huizen en gebouwen op Oost-Java. De meubels worden met de hand gemaakt door lokale makers.'] as [string, string]] : []),
];
// Lange maatlijsten (tot 16 maten) klappen in: eerst zes, de rest achter een knop.
const ZICHTBAAR = 6;
// Maten leesbaarder: "70x70x78/120x70x78" wordt "70 × 70 × 78 / 120 × 70 × 78". De waarde in de aanvraag blijft het origineel.
const toonMaat = (l: string) => l.replace(/\s*[xX×]\s*(?=[A-Za-z]?\d)/g, ' × ').replace(/\s*\/\s*/g, ' / ');
const lang = maten.some((m) => toonMaat(m.label).length > 20);
const kleurOpties = p.houtkleuren ? houtkleuren.map((h) => ({ naam: h.naam, img: h.img as ImageMetadata | undefined })) : p.uitvoeringen.map((u) => ({ naam: hoofdletter(u), img: undefined }));
const kleurLabel = p.houtkleuren ? 'houtkleur' : 'uitvoering';
let stap = 0;
const nr = () => ++stap;

// SEO: titel, omschrijving, deelafbeelding en Product-schema.
const omschr = platteTekst(p.omschrijving);
// Hele zinnen uit de omschrijving, tot ongeveer 110 tekens, zodat Google geen afgebroken zin toont.
const kortOmschr = (omschr.match(/[^.!?]+[.!?]+/g) ?? (omschr ? [omschr + '.'] : [])).reduce((t, z) => (t.length + z.length <= 115 || !t ? t + z : t), '').trim().replace(/!+$/, '.');
const beschrijving = p.seoOmschrijving || `${p.titel}${prijzen ? `, ${prijsTekst(p)}` : ''}. ${kortOmschr || `${cat.naam} van Teakhuis.`}${p.maatwerk ? ' Ook op maat, zonder meerprijs.' : ''} Vraag vrijblijvend een offerte aan.`;
const titel = p.seoTitel || `${p.titel}${p.maatwerk ? ' | Op maat' : ''} | Teakhuis`;
const ogFotos = await Promise.all(fotos.slice(0, 1).map((f) => getImage({ src: f, width: Math.min(1200, breedte(f)), format: 'jpg', quality: 75 })));
const zelf = absoluut(`product/${p.slug}/`);
const kruimel: Stap[] = [['Collectie', url('collectie/')], ...(hoofd ? [[hoofd.naam, categorieHref(hoofd)] as Stap] : []), [cat.naam, categorieHref(cat)], [p.titel]];
const maatPrijzen = maten.map((m) => m.prijs).filter((x): x is number => typeof x === 'number');
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.titel,
  description: omschr || beschrijving,
  sku: p.slug,
  url: zelf,
  category: [hoofd?.naam, cat.naam].filter(Boolean).join(' > '),
  material: /mango/i.test(p.titel + cat.naam) ? 'Mangohout' : 'Teakhout',
  brand: { '@type': 'Brand', name: site.naam },
  ...(ogFotos.length ? { image: ogFotos.map((f) => new URL(f.src, Astro.site).href) } : {}),
  ...(prijzen ? {
    offers: maatPrijzen.length > 1
      ? { '@type': 'AggregateOffer', priceCurrency: 'EUR', lowPrice: Math.min(...maatPrijzen), highPrice: Math.max(...maatPrijzen), offerCount: maatPrijzen.length, availability: 'https://schema.org/MadeToOrder', url: zelf, seller: { '@id': `${absoluut('')}#organisatie` } }
      : { '@type': 'Offer', priceCurrency: 'EUR', price: p.prijsVanaf, availability: 'https://schema.org/MadeToOrder', url: zelf, seller: { '@id': `${absoluut('')}#organisatie` } },
  } : {}),
};
const eersteFotoKlein = fotos[0] ? (await getImage({ src: fotos[0], width: Math.min(160, breedte(fotos[0])), format: 'webp', quality: 60 })).src : '';
const productData = { slug: p.slug, titel: p.titel, href: productHref(p), foto: eersteFotoKlein, indicatie: prijzen ? prijsTekst(p) : '', wa: site.wa };
---
<Base title={titel} description={beschrijving} ogType="product" ogImage={ogFotos[0] ? new URL(ogFotos[0].src, Astro.site).href : undefined} schema={[productSchema, kruimelSchema(kruimel, zelf)]}>
  <Kop onderbalk={false} />
  <main id="inhoud">
    <div class="wrap pt-6 md:pt-8">
      <Kruimel stappen={kruimel} />
    </div>

    <section class="wrap grid grid-cols-1 gap-y-10 pb-20 pt-6 lg:grid-cols-12 lg:gap-x-14 lg:pb-28">
      <!-- Fotogalerij: hoofdfoto, pijlen/vegen/toetsen, klik = groter -->
      <div class="min-w-0 lg:sticky lg:top-28 lg:col-span-7 lg:self-start" data-galerij>
        {fotos.length ? (
          <>
            <div class="relative aspect-square overflow-hidden rounded-sm bg-wit sm:aspect-[5/4]" role="group" aria-roledescription="fotogalerij" aria-label={`Foto's van ${p.titel}`} tabindex={fotos.length > 1 ? 0 : undefined} data-podium>
              {fotos.map((f, i) => (
                <button type="button" class={`absolute inset-0 h-full w-full cursor-zoom-in ${i ? 'hidden' : ''}`} data-dia={i} aria-label={`Foto ${i + 1} van ${fotos.length} groter bekijken`}>
                  <Image src={f} alt={i ? `${p.titel}, foto ${i + 1}` : p.titel} quality={76} widths={breedtes(f, [480, 720, 960, 1200])} sizes="(min-width: 1344px) 720px, (min-width: 1024px) 55vw, 100vw" loading={i ? 'lazy' : 'eager'} fetchpriority={i ? undefined : 'high'} class={`h-full w-full ${fotoKlas(f, 'p-4 md:p-8')}`} />
                </button>
              ))}
              {fotos.length > 1 && (
                <>
                  <button type="button" class="absolute left-3 top-1/2 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full border border-lijn bg-papier/90 text-inkt transition-colors hover:bg-inkt hover:text-wit" aria-label="Vorige foto" data-stap="-1"><Icoon naam="pijl" class="h-5 w-5 rotate-180" /></button>
                  <button type="button" class="absolute right-3 top-1/2 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full border border-lijn bg-papier/90 text-inkt transition-colors hover:bg-inkt hover:text-wit" aria-label="Volgende foto" data-stap="1"><Icoon naam="pijl" class="h-5 w-5" /></button>
                  <p class="num absolute bottom-3 right-3 rounded-sm bg-papier/90 px-2 py-0.5 text-xs font-bold" aria-live="polite" data-teller>1 / {fotos.length}</p>
                </>
              )}
            </div>
            {fotos.length > 1 && (
              <ul class="mt-3 grid grid-cols-5 gap-2 sm:grid-cols-6" aria-label="Alle foto's">
                {fotos.map((f, i) => (
                  <li>
                    <button type="button" class="block aspect-square w-full overflow-hidden rounded-sm border-2 border-transparent bg-wit transition-colors hover:border-inkt aria-current:border-blad" aria-current={i ? 'false' : 'true'} aria-label={`Toon foto ${i + 1}`} data-duim={i}>
                      <Image src={f} alt="" quality={60} widths={[Math.min(200, breedte(f))]} sizes="120px" loading="lazy" class={`h-full w-full ${fotoKlas(f, 'p-1')}`} />
                    </button>
                  </li>
                ))}
              </ul>
            )}
          </>
        ) : (
          <div class="aspect-[5/4] overflow-hidden rounded-sm"><GeenFoto naam={p.titel} groot /></div>
        )}
      </div>

      <!-- Productinfo en samenstellen -->
      <div class="min-w-0 lg:col-span-5">
        <p><a href={categorieHref(cat)} class="label text-blad-diep no-underline hover:underline">{cat.naam}</a></p>
        <h1 class={`mt-3 hyphens-auto ${langeNaam ? 'text-[clamp(1.9rem,3.2vw,2.6rem)]' : 'text-4xl'}`} lang="nl">{p.titel}</h1>
        <div class="mt-5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
          {prijzen ? (
            <>
              <p class="num font-kop text-3xl font-extrabold" data-prijs>{maten.length && maten[0].prijs ? euro(maten[0].prijs) : prijsTekst(p)}</p>
              <p class="text-sm text-grijs" data-prijs-uitleg>{maten.some((m) => m.prijs) ? 'indicatie voor de gekozen maat' : 'indicatieprijs'}</p>
            </>
          ) : (
            <p class="font-kop text-3xl font-extrabold">Prijs op aanvraag</p>
          )}
        </div>
        <p class="mt-2 text-sm text-grijs">Je krijgt eerst een vrijblijvende offerte met de precieze prijs.</p>

        <form id="samenstellen" class="mt-9 space-y-9" data-samenstellen novalidate>
          {heeftMaatStap && (
            <fieldset>
              <legend class="flex w-full items-baseline justify-between gap-3">
                <span class="font-kop text-xl"><span class="num text-blad-diep">{nr()}.</span> Kies je maat</span>
                <span class="text-xs text-grijs">in cm</span>
              </legend>
              <div class={`mt-4 grid gap-2 ${lang ? 'grid-cols-1 min-[400px]:grid-cols-2' : 'grid-cols-2 sm:grid-cols-3'}`} data-maten>
                {maten.map((m, i) => (
                  <label class={`tegel min-h-[3.4rem] px-3 py-2 ${i >= ZICHTBAAR ? 'hidden' : ''}`} data-extra={i >= ZICHTBAAR ? '' : undefined}>
                    <input type="radio" name="maat" value={m.label} data-prijs={prijzen && m.prijs ? m.prijs : ''} checked={i === 0} class="sr-only" />
                    <span class="num text-[.85rem] font-bold leading-tight">{toonMaat(m.label)}</span>
                    {prijzen && m.prijs && <span class="num text-xs text-grijs">v.a. {euro(m.prijs)}</span>}
                  </label>
                ))}
                {!maten.length && (
                  <label class="tegel min-h-[3.4rem] px-3 py-2">
                    <input type="radio" name="maat" value="Standaard, zoals op de foto" checked class="sr-only" />
                    <span class="text-sm font-bold leading-snug">Standaard</span>
                    <span class="text-xs text-grijs">zoals op de foto</span>
                  </label>
                )}
              </div>
              {maten.length > ZICHTBAAR && (
                <button type="button" class="mt-2 flex w-full items-center justify-center gap-2 rounded-[var(--radius-md)] bg-zand py-2.5 text-sm font-bold text-inkt transition-colors hover:bg-zand-2" aria-expanded="false" data-meer-maten>
                  <span data-meer-tekst>Toon alle {maten.length} maten</span>
                  <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                </button>
              )}
              {p.maatwerk && (
                <label class="mt-2 flex cursor-pointer items-center gap-3 rounded-[var(--radius-md)] border-[1.5px] border-dashed border-lijn-2 bg-wit px-4 py-3 transition-colors hover:border-inkt has-[:checked]:border-solid has-[:checked]:border-blad-diep has-[:checked]:bg-[#f3f9ee] has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-blad-diep">
                  <input type="radio" name="maat" value="anders" class="sr-only" data-eigen-maat />
                  <Icoon naam="liniaal" class="h-5 w-5 flex-none text-blad-diep" />
                  <span class="min-w-0 flex-1"><span class="block text-sm font-bold">Andere maat nodig?</span><span class="block text-xs text-grijs">Vul je eigen maten in, zonder meerprijs</span></span>
                  <Icoon naam="pijl" class="h-4 w-4 flex-none text-grijs" />
                </label>
              )}
              {p.maatwerk && (
                <div class="mt-3 rounded-[var(--radius-md)] bg-zand p-4 sm:p-5" data-maatvelden hidden>
                  <p class="text-sm font-bold">Vul je eigen maten in</p>
                  <div class="mt-3 grid grid-cols-3 gap-2">
                    {[['b', 'Breedte'], ['d', 'Diepte'], ['h', 'Hoogte']].map(([k, t]) => (
                      <label class="block">
                        <span class="text-xs font-semibold text-grijs">{t}</span>
                        <span class="relative mt-1 block">
                          <input name={k} inputmode="numeric" pattern="[0-9]*" maxlength="4" autocomplete="off" class="veld num pr-9 max-sm:px-2.5 max-sm:pr-8" aria-describedby="maat-hulp" />
                          <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-grijs max-sm:right-2">cm</span>
                        </span>
                      </label>
                    ))}
                  </div>
                  <p id="maat-hulp" class="mt-3 text-xs text-grijs">Weet je nog niet alles? Vul in wat je weet, de rest bespreken we samen.</p>
                  <p class="mt-2 hidden text-xs font-bold text-[#a3301f]" data-maat-fout role="alert">Vul minstens één maat in.</p>
                </div>
              )}
              {soort && <MaatTekening soort={soort} />}
            </fieldset>
          )}

          {kleurOpties.length > 0 && (
            <fieldset>
              <legend class="font-kop text-xl"><span class="num text-blad-diep">{nr()}.</span> Kies je {kleurLabel}</legend>
              <div class="mt-4 flex flex-wrap gap-2">
                {kleurOpties.map((k, i) => (
                  <label class={`kies ${k.img ? 'met-staal' : ''}`}>
                    <input type="radio" name="kleur" value={k.naam} checked={i === 0} class="sr-only" />
                    {k.img && <Image src={k.img} alt="" quality={70} widths={[64]} sizes="28px" class="staal object-cover" />}
                    {k.naam}
                  </label>
                ))}
                {p.houtkleuren && <label class="kies"><input type="radio" name="kleur" value="Weet ik nog niet" class="sr-only" />Weet ik nog niet</label>}
              </div>
            </fieldset>
          )}

          <fieldset>
            <legend class="font-kop text-xl"><span class="num text-blad-diep">{nr()}.</span> Aantal en wensen</legend>
            <div class="mt-4 flex flex-wrap items-start gap-3">
              <div class="flex h-[3.25rem] items-center rounded-sm border-[1.5px] border-lijn-2 bg-wit" role="group" aria-label="Aantal">
                <button type="button" class="grid h-full w-11 place-items-center text-inkt hover:text-blad-diep" aria-label="Eén minder" data-aantal="-1"><Icoon naam="min" class="h-4 w-4" /></button>
                <input name="aantal" value="1" inputmode="numeric" pattern="[0-9]*" maxlength="2" class="num h-full w-10 border-0 bg-transparent text-center font-bold focus:outline-none" aria-label="Aantal" />
                <button type="button" class="grid h-full w-11 place-items-center text-inkt hover:text-blad-diep" aria-label="Eén meer" data-aantal="1"><Icoon naam="plus" class="h-4 w-4" /></button>
              </div>
              <label class="min-w-0 flex-1 basis-56">
                <span class="sr-only">Wensen of vragen</span>
                <input name="opmerking" maxlength="300" class="veld" placeholder="Wensen? Bijv. extra lade of andere poot" />
              </label>
            </div>
          </fieldset>

          <div class="border-t border-lijn-2 pt-7">
            <div class="flex flex-col gap-3 sm:flex-row">
              <button type="submit" class="knop knop-blad flex-1"><Icoon naam="lijst" />Zet in offerteaanvraag</button>
              <a href={site.wa} class="knop knop-rand" data-wa><Icoon naam="wa" />Vraag via WhatsApp</a>
            </div>
            <p class="mt-3 flex items-start gap-2 text-sm text-grijs"><Icoon naam="vink" class="mt-0.5 h-4 w-4 flex-none text-blad-diep" />Je betaalt nu niets. Eerst een gratis tekening en prijs, daarna beslis je.</p>
            <div class="mt-4 hidden items-start gap-3 rounded-sm bg-blad/15 p-4 text-sm" role="status" data-toegevoegd>
              <Icoon naam="vink" class="mt-0.5 h-5 w-5 flex-none text-blad-diep" />
              <p class="flex-1"><strong>Staat in je offerteaanvraag.</strong> Voeg gerust meer meubels toe, je verstuurt alles in één keer. <a href={url('offerte/')} class="font-bold text-blad-diep underline underline-offset-2">Naar je aanvraag</a></p>
            </div>
          </div>
        </form>

        <!-- Persoonlijk advies: Han is eigenaar en aanspreekpunt -->
        <div class="mt-9 flex items-center gap-4 rounded-[var(--radius-xl)] bg-nacht p-4 text-wit sm:p-5">
          <Image src={han} alt="Han Rietdijk, eigenaar van Teakhuis" quality={80} widths={[128]} sizes="56px" class="h-14 w-14 flex-none rounded-full object-cover object-top ring-2 ring-blad" />
          <div class="min-w-0 flex-1">
            <p class="font-kop text-[.95rem] font-extrabold leading-tight">Twijfel je over maat of kleur?</p>
            <p class="mt-0.5 text-sm text-as">Han Rietdijk, eigenaar, denkt graag met je mee.</p>
          </div>
          <div class="flex flex-none gap-2">
            <a href={`${site.wa}?text=${encodeURIComponent(`Hallo Han, ik heb een vraag over ${p.titel}.`)}`} class="grid h-11 w-11 place-items-center rounded-full bg-blad text-inkt hover:bg-blad-licht" aria-label="App Han via WhatsApp"><Icoon naam="wa" class="h-5 w-5" /></a>
            <a href={site.telHref} class="grid h-11 w-11 place-items-center rounded-full bg-wit/10 text-wit ring-1 ring-wit/25 hover:bg-wit hover:text-inkt" aria-label={`Bel Han: ${site.tel}`}><Icoon naam="tel" class="h-5 w-5" /></a>
          </div>
        </div>

        <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <li class="flex items-start gap-2"><span class="mt-0.5 grid h-5 w-5 flex-none place-items-center rounded-full bg-blad text-inkt"><Icoon naam="vink" class="h-3 w-3" /></span><span><strong>Vrijblijvende offerte</strong>, eerst tekening en prijs</span></li>
          <li class="flex items-start gap-2"><span class="mt-0.5 grid h-5 w-5 flex-none place-items-center rounded-full bg-blad text-inkt"><Icoon naam="vink" class="h-3 w-3" /></span><span><strong>Geen showroom</strong>, dus voordeliger</span></li>
          <li class="flex items-start gap-2"><span class="mt-0.5 grid h-5 w-5 flex-none place-items-center rounded-full bg-blad text-inkt"><Icoon naam="vink" class="h-3 w-3" /></span><span><strong>Met de hand gemaakt</strong> in Indonesië</span></li>
          <li class="flex items-start gap-2"><span class="mt-0.5 grid h-5 w-5 flex-none place-items-center rounded-full bg-blad text-inkt"><Icoon naam="vink" class="h-3 w-3" /></span><span><strong>Thuis geleverd</strong></span></li>
        </ul>

        {review && (
          <figure class="mt-7 rounded-[var(--radius-xl)] bg-wit p-5 ring-1 ring-lijn">
            <div class="flex items-center justify-between gap-3 text-xs font-bold text-grijs">
              {review.bron === 'google'
                ? <span class="flex items-center gap-1.5"><svg viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true"><path fill="#4285F4" d="M22.6 12.2c0-.8-.1-1.5-.2-2.2H12v4.2h5.9a5 5 0 0 1-2.2 3.3v2.7h3.6c2.1-1.9 3.3-4.8 3.3-8Z"/><path fill="#34A853" d="M12 23c3 0 5.5-1 7.3-2.7l-3.6-2.8c-1 .7-2.2 1.1-3.7 1.1-2.9 0-5.3-1.9-6.2-4.5H2.1v2.8A11 11 0 0 0 12 23Z"/><path fill="#FBBC05" d="M5.8 14.1a6.6 6.6 0 0 1 0-4.2V7.1H2.1a11 11 0 0 0 0 9.8l3.7-2.8Z"/><path fill="#EA4335" d="M12 5.4c1.6 0 3.1.6 4.2 1.7l3.2-3.2A11 11 0 0 0 2.1 7.1l3.7 2.8C6.7 7.3 9.1 5.4 12 5.4Z"/></svg>Review op Google</span>
                : <span>Ervaring van een klant</span>}
              {review.sterren ? <span class="text-[#f4b400]" aria-label={`${review.sterren} van 5 sterren`}>{'★'.repeat(review.sterren)}</span> : null}
            </div>
            <blockquote class="mt-3 text-[.95rem] leading-relaxed text-inkt">“{review.tekst}”</blockquote>
            <figcaption class="mt-4 flex items-center gap-3 border-t border-lijn pt-4 text-sm">
              <span class="grid h-9 w-9 flex-none place-items-center rounded-full bg-zand text-xs font-extrabold text-blad-diep">{initialen(review.naam)}</span>
              <span class="min-w-0 flex-1"><span class="block font-bold">{review.naam}</span>{review.over && <span class="block text-xs text-grijs">Over een {review.over}</span>}</span>
              {review.bron === 'google' && <a href={site.google} class="text-xs font-bold text-blad-diep underline underline-offset-2" rel="noopener">Bekijk op Google</a>}
            </figcaption>
          </figure>
        )}
      </div>
    </section>

    <!-- Alles over het meubel: omschrijving links, specificaties en vragen rechts -->
    <section class="wrap grid grid-cols-1 gap-y-12 border-t border-lijn-2 py-14 lg:grid-cols-12 lg:gap-x-14 lg:py-20" aria-label="Over dit meubel">
      <div class="min-w-0 lg:col-span-7">
        {tekst && (
          <div>
            <h2 class="font-kop text-3xl">Over dit meubel</h2>
            <div class="tekst mt-4 text-grijs [overflow-wrap:anywhere]" set:html={tekst} />
          </div>
        )}
        {!tekst && <p class="text-grijs">Vragen over dit meubel? Bel of app Han op <a href={site.telHref} class="num font-bold text-inkt underline underline-offset-2">{site.tel}</a>.</p>}
      </div>
      <div class="min-w-0 lg:col-span-5">
        <div>
          <h2 class="font-kop text-2xl">Specificaties</h2>
          <dl class="mt-4 divide-y divide-lijn text-sm">
            {specs.map(([k, v]) => (
              <div class="grid grid-cols-[8.5rem_1fr] gap-3 py-2.5">
                <dt class="text-grijs">{k}</dt>
                <dd class="font-semibold text-inkt">{v}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="mt-10">
          <h2 class="font-kop text-2xl">Veelgestelde vragen</h2>
          <div class="mt-3 divide-y divide-lijn">
            {vragen.map(([q, a]) => (
              <details class="group py-1">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3 font-bold [&::-webkit-details-marker]:hidden">
                  {q}
                  <span class="grid h-7 w-7 flex-none place-items-center rounded-full ring-1 ring-lijn-2 transition-transform group-open:rotate-45" aria-hidden="true"><Icoon naam="plus" class="h-3.5 w-3.5" /></span>
                </summary>
                <p class="pb-4 text-sm leading-relaxed text-grijs">{a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Zo werkt het: de vijf stappen van Teakhuis, compact -->
    <section class="bg-nacht py-16 text-wit md:py-20" aria-labelledby="zo-kop">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 id="zo-kop" class="text-3xl">Zo komt je meubel <span class="cursief text-blad-licht">bij je thuis</span>.</h2>
          <a href={url('maatwerk/')} class="link link-licht text-sm font-bold">Meer over maatwerk</a>
        </div>
        <ol class="mt-10 grid gap-x-6 gap-y-6 sm:grid-cols-2 lg:grid-cols-5">
          {stappen.map(([t, z], i) => (
            <li class="border-t border-lijn-d pt-5">
              <span class="num font-kop text-xl text-blad-licht">0{i + 1}</span>
              <p class="mt-2 font-bold">{t}</p>
              <p class="mt-1 text-sm text-as">{z}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {verwant.length > 0 && (
      <section class="py-16 md:py-24" aria-labelledby="verwant">
        <div class="wrap">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 id="verwant" class="text-3xl">Misschien ook mooi</h2>
            {aantalCat > 1 && <a href={categorieHref(cat)} class="link text-sm font-bold">Alle {cat.naam.toLowerCase()} ({aantalCat})</a>}
          </div>
          <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 md:gap-x-6 lg:grid-cols-4">
            {verwant.map((x) => <li><ProductKaart p={x} /></li>)}
          </ul>
        </div>
      </section>
    )}
  </main>
  <Voet />

  <!-- Mobiel: prijs en offerteknop altijd binnen bereik -->
  <div class="fixed inset-x-0 bottom-0 z-30 flex items-center gap-3 border-t border-lijn bg-wit/95 p-2 pl-4 pb-[max(.5rem,env(safe-area-inset-bottom))] backdrop-blur-sm md:hidden" data-balk>
    <div class="min-w-0 flex-1">
      <p class="truncate text-xs text-grijs">{p.titel}</p>
      <p class="num font-kop text-base font-extrabold leading-tight" data-balk-prijs>{prijzen ? (maten.length && maten[0].prijs ? euro(maten[0].prijs) : prijsTekst(p)) : 'Prijs op aanvraag'}</p>
    </div>
    <button type="submit" form="samenstellen" class="knop knop-blad min-h-11 px-5 text-sm" data-balk-knop><Icoon naam="lijst" />In offerte</button>
    <a href={url('offerte/')} class="knop knop-blad min-h-11 px-5 text-sm" hidden data-balk-klaar><Icoon naam="vink" />Bekijk offerte</a>
  </div>

  {fotos.length > 0 && (
    <dialog class="m-0 h-dvh max-h-none w-screen max-w-none bg-wit p-0 backdrop:bg-inkt/80" aria-label={`Foto's van ${p.titel}, groot`} data-groot>
      <div class="relative flex h-full w-full items-center justify-center p-4 md:p-12" data-groot-vlak>
        <img src="" alt={p.titel} class="max-h-full max-w-full object-contain" data-groot-img />
        <button type="button" class="absolute right-3 top-3 grid h-12 w-12 place-items-center rounded-full bg-zand text-inkt transition-colors hover:bg-inkt hover:text-wit" aria-label="Sluiten" data-sluit><Icoon naam="kruis" class="h-6 w-6" /></button>
        {fotos.length > 1 && (
          <>
            <button type="button" class="absolute left-3 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full bg-zand text-inkt transition-colors hover:bg-inkt hover:text-wit" aria-label="Vorige foto" data-stap="-1"><Icoon naam="pijl" class="h-5 w-5 rotate-180" /></button>
            <button type="button" class="absolute right-3 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full bg-zand text-inkt transition-colors hover:bg-inkt hover:text-wit" aria-label="Volgende foto" data-stap="1"><Icoon naam="pijl" class="h-5 w-5" /></button>
          </>
        )}
      </div>
    </dialog>
  )}

  <script type="application/json" id="product-data" set:html={JSON.stringify(productData).replace(/</g, '\\u003c')} />
  <script>
    import { voegToe, regelTekst, type Regel } from '../../scripts/offerte';
    import { meet } from '../../scripts/meet';

    // Galerij: één foto tegelijk, pijlen, duimnagels, toetsen en vegen; klik opent hem groot.
    const gal = document.querySelector<HTMLElement>('[data-galerij]');
    const podium = gal?.querySelector<HTMLElement>('[data-podium]');
    const groot = document.querySelector<HTMLDialogElement>('[data-groot]');
    if (gal && podium) {
      const dias = [...podium.querySelectorAll<HTMLButtonElement>('[data-dia]')];
      const duimen = [...gal.querySelectorAll<HTMLButtonElement>('[data-duim]')];
      const teller = podium.querySelector('[data-teller]');
      const grootImg = groot?.querySelector<HTMLImageElement>('[data-groot-img]');
      let nu = 0;
      const grootste = (img: HTMLImageElement) => (img.srcset ? img.srcset.split(',').at(-1)!.trim().split(' ')[0] : img.src);
      const zet = (i: number) => {
        nu = (i + dias.length) % dias.length;
        dias.forEach((d, j) => d.classList.toggle('hidden', j !== nu));
        duimen.forEach((d, j) => d.setAttribute('aria-current', String(j === nu)));
        if (teller) teller.textContent = `${nu + 1} / ${dias.length}`;
        if (groot?.open && grootImg) grootImg.src = grootste(dias[nu].querySelector('img')!);
      };
      const veeg = (el: HTMLElement) => {
        let x0: number | null = null;
        el.addEventListener('pointerdown', (e) => { x0 = e.clientX; });
        el.addEventListener('pointerup', (e) => {
          if (x0 === null) return;
          const dx = e.clientX - x0; x0 = null;
          if (Math.abs(dx) > 40 && dias.length > 1) { zet(nu + (dx < 0 ? 1 : -1)); el.dataset.geveegd = '1'; setTimeout(() => delete el.dataset.geveegd, 50); }
        });
      };
      podium.querySelectorAll<HTMLElement>('[data-stap]').forEach((b) => b.addEventListener('click', () => zet(nu + Number(b.dataset.stap))));
      duimen.forEach((b, i) => b.addEventListener('click', () => zet(i)));
      podium.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') zet(nu + 1); if (e.key === 'ArrowLeft') zet(nu - 1); });
      veeg(podium);
      if (groot && grootImg) {
        dias.forEach((d) => d.addEventListener('click', () => {
          if (podium.dataset.geveegd) return;
          grootImg.src = grootste(d.querySelector('img')!);
          groot.showModal();
        }));
        groot.querySelectorAll<HTMLElement>('[data-stap]').forEach((b) => b.addEventListener('click', () => zet(nu + Number(b.dataset.stap))));
        groot.querySelector('[data-sluit]')!.addEventListener('click', () => groot.close());
        groot.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') zet(nu + 1); if (e.key === 'ArrowLeft') zet(nu - 1); });
        groot.addEventListener('click', (e) => { if (e.target === groot.querySelector('[data-groot-vlak]')) groot.close(); });
        groot.addEventListener('close', () => dias[nu].focus());
        veeg(groot);
      }
    }

    // Samenstellen: maat (standaard of eigen), kleur, aantal en wensen. Prijs en WhatsApp-bericht volgen de keuze.
    const d = JSON.parse(document.getElementById('product-data')!.textContent!) as { slug: string; titel: string; href: string; foto: string; indicatie: string; wa: string };
    const form = document.querySelector<HTMLFormElement>('[data-samenstellen]');
    if (form) {
      const prijsEl = document.querySelector('[data-prijs]');
      const uitleg = document.querySelector('[data-prijs-uitleg]');
      const velden = form.querySelector<HTMLElement>('[data-maatvelden]');
      const fout = form.querySelector<HTMLElement>('[data-maat-fout]');
      const wa = form.querySelector<HTMLAnchorElement>('[data-wa]')!;
      const klaar = form.querySelector<HTMLElement>('[data-toegevoegd]')!;
      const aantalVeld = form.querySelector<HTMLInputElement>('[name="aantal"]')!;
      const euro = (n: number) => { const [e, c] = n.toFixed(2).split('.'); return `€ ${e.replace(/\B(?=(\d{3})+(?!\d))/g, '.')},${c === '00' ? '-' : c}`; };
      const startPrijs = prijsEl?.textContent ?? '';
      const startUitleg = uitleg?.textContent ?? '';
      const cm = (v: FormDataEntryValue | null) => String(v ?? '').replace(/\D/g, '').slice(0, 4);
      // Maattekening: breedte, diepte en hoogte uit een maatlabel als "B200 x D100 x H78", "h=70cm br=70cm d=13cm" of "120x80cm h=105cm".
      const tekening = form.querySelectorAll<HTMLElement>('[data-mt]');
      const leesMaat = (s: string) => {
        const zoek = (re: RegExp) => s.match(re)?.[1];
        let b = zoek(/\b(?:b|br|breedte)\s*[=:]?\s*(?:ca\.?\s*)?(\d{2,4})/i);
        let d = zoek(/\b(?:d|diepte)\s*[=:]?\s*(\d{2,4})/i);
        const h = zoek(/\b(?:h|hoogte)\s*[=:]?\s*(\d{2,4})/i);
        const xy = s.match(/(\d{2,4})\s*[x×]\s*(\d{2,4})/);
        if (!b && xy) { b = xy[1]; d ??= xy[2]; }
        return { b, d, h };
      };

      const keuze = (): Omit<Regel, 'id'> | null => {
        const f = new FormData(form);
        const maat = f.get('maat') as string | null;
        let eigenMaat: string | undefined;
        if (maat === 'anders') {
          const m = [['B', cm(f.get('b'))], ['D', cm(f.get('d'))], ['H', cm(f.get('h'))]].filter(([, v]) => v);
          if (!m.length) return null;
          eigenMaat = m.map(([k, v]) => `${k} ${v}`).join(' x ') + ' cm';
        }
        const aantal = Math.max(1, Math.min(99, parseInt(String(f.get('aantal'))) || 1));
        return {
          slug: d.slug, titel: d.titel, href: d.href, foto: d.foto || undefined,
          maat: maat && maat !== 'anders' ? maat : undefined, eigenMaat,
          kleur: (f.get('kleur') as string) || undefined,
          aantal, opmerking: String(f.get('opmerking') ?? '').trim().slice(0, 300) || undefined,
          indicatie: (() => {
            const pr = Number(form.querySelector<HTMLInputElement>('[name="maat"]:checked')?.dataset.prijs);
            return pr ? `v.a. ${euro(pr)}` : d.indicatie || undefined;
          })(),
        };
      };

      const werk = () => {
        const gekozen = form.querySelector<HTMLInputElement>('[name="maat"]:checked');
        const eigen = gekozen?.value === 'anders';
        if (velden) velden.hidden = !eigen;
        if (prijsEl && gekozen) {
          const pr = Number(gekozen.dataset.prijs);
          if (eigen) { prijsEl.textContent = startPrijs.startsWith('v.a.') || !startPrijs ? startPrijs : `v.a. ${startPrijs}`; if (uitleg) uitleg.textContent = 'je eigen maat, zonder meerprijs'; }
          else if (pr) { prijsEl.textContent = euro(pr); if (uitleg) uitleg.textContent = startUitleg; }
          const balkPrijs = document.querySelector('[data-balk-prijs]');
          if (balkPrijs) balkPrijs.textContent = prijsEl.textContent;
        }
        if (tekening && gekozen) {
          const f = new FormData(form);
          const m = eigen ? { b: cm(f.get('b')), d: cm(f.get('d')), h: cm(f.get('h')) } : leesMaat(gekozen.value);
          tekening.forEach((el) => { const v = m[el.dataset.mt as 'b' | 'd' | 'h']; el.textContent = v ? `${v} cm` : '-'; });
          const leegTekst = form.querySelector<HTMLElement>('[data-mt-leeg]');
          if (leegTekst) {
            const niets = !m.b && !m.d && !m.h;
            leegTekst.hidden = !niets;
            leegTekst.textContent = eigen ? 'Vul hierboven je maten in.' : 'De precieze maten staan in de omschrijving of in je offerte.';
          }
        }
        const k = keuze();
        const regel = k ? { ...k, id: '' } : { slug: d.slug, titel: d.titel, href: d.href, aantal: 1, id: '' };
        wa.href = `${d.wa}?text=${encodeURIComponent(`Hallo Teakhuis, ik heb interesse in:\n${regelTekst(regel as Regel)}\nKunnen jullie een offerte maken?`)}`;
      };

      form.addEventListener('change', werk);
      form.addEventListener('input', () => { if (fout) fout.classList.add('hidden'); klaar.classList.add('hidden'); klaar.classList.remove('flex'); werk(); });
      form.querySelectorAll<HTMLButtonElement>('[data-aantal]').forEach((b) => b.addEventListener('click', () => {
        aantalVeld.value = String(Math.max(1, Math.min(99, (parseInt(aantalVeld.value) || 1) + Number(b.dataset.aantal))));
        werk();
      }));
      const meer = form.querySelector<HTMLButtonElement>('[data-meer-maten]');
      meer?.addEventListener('click', () => {
        const open = meer.getAttribute('aria-expanded') !== 'true';
        meer.setAttribute('aria-expanded', String(open));
        form.querySelectorAll<HTMLElement>('[data-extra]').forEach((el) => el.classList.toggle('hidden', !open));
        meer.querySelector('[data-meer-tekst]')!.textContent = open ? 'Minder maten tonen' : `Toon alle ${form.querySelectorAll('[name="maat"]:not([value="anders"])').length} maten`;
        meer.querySelector('svg')!.style.transform = open ? 'rotate(180deg)' : '';
      });
      // Bij een eigen maat meteen naar het eerste maatveld.
      form.querySelector('[data-eigen-maat]')?.addEventListener('change', () => setTimeout(() => form.querySelector<HTMLInputElement>('[name="b"]')?.focus(), 30));
      // Nog eens op "Andere maat" klikken klapt hem weer in en zet de laatst gekozen standaardmaat terug.
      const eigen = form.querySelector<HTMLInputElement>('[data-eigen-maat]');
      if (eigen) {
        let vorige = form.querySelector<HTMLInputElement>('[name="maat"]:checked:not([data-eigen-maat])');
        let wasAan = false;
        form.querySelectorAll<HTMLInputElement>('[name="maat"]:not([data-eigen-maat])').forEach((r) => r.addEventListener('change', () => { vorige = r; }));
        const label = eigen.closest('label')!;
        label.addEventListener('pointerdown', () => { wasAan = eigen.checked; });
        label.addEventListener('keydown', (e) => { if (e.key === ' ' || e.key === 'Enter') wasAan = eigen.checked; });
        label.addEventListener('click', (e) => {
          if (!wasAan) return;
          e.preventDefault();
          wasAan = false;
          eigen.checked = false;
          const terug = vorige ?? form.querySelector<HTMLInputElement>('[name="maat"]:not([data-eigen-maat])');
          if (terug) terug.checked = true;
          werk();
        });
      }

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const k = keuze();
        if (!k) {
          fout?.classList.remove('hidden');
          form.querySelector<HTMLInputElement>('[name="b"]')?.focus();
          return;
        }
        voegToe(k);
        meet('In offerte');
        klaar.classList.remove('hidden');
        klaar.classList.add('flex');
        document.querySelector<HTMLElement>('[data-balk-knop]')!.hidden = true;
        document.querySelector<HTMLElement>('[data-balk-klaar]')!.hidden = false;
      });
      werk();
    }
  </script>
</Base>
