---
// Over ons: het verhaal van Teakhuis Dordrecht. Basis is de tekst die Han aanleverde (mail 5 nov 2026, "Copilot Over ons"),
// ingekort en in de je-vorm van de site. Alle foto's zijn van Han, de showroom- en pandfoto's komen uit 2016.
// De tijdlijn is het hart van de pagina: je scrolt door de jaren, foto en jaartal lopen mee (zie het script onderaan).
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import InfoHero from '../components/InfoHero.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Kruimel from '../components/Kruimel.astro';
import ReviewKaart from '../components/ReviewKaart.astro';
import Vragen from '../components/Vragen.astro';
import { site, url, absoluut, waHoi, reviews } from '../data/site';
import { kruimelSchema, vragenSchema } from '../data/seo';
import han from '../assets/han.jpg';
import heroFoto from '../assets/overons-hero.jpg';
import pandDordrecht from '../assets/overons-pand-dordrecht.jpg';
import pandLeiderdorp from '../assets/overons-pand-leiderdorp.jpg';
import eettafel from '../assets/overons-eettafel-detail.jpg';
import werkplaats from '../assets/overons-werkplaats-indonesie.jpg';
import hemelbed from '../assets/categorieen/slaapkamer-hemelbed.jpg';
import woonkamer from '../assets/hero-woonkamer.jpg';

const titel = 'Geschiedenis van Teakhuis Dordrecht | Sinds 2007 specialist in teakhout';
const omschrijving = 'Lees het verhaal van Teakhuis Dordrecht. Sinds 2007 specialist in maatwerk teakhouten meubels, duurzaam Indonesisch teakhout en persoonlijke service in Nederland en België.';

const cijfers: [string, string][] = [
  ['2007', 'Eerste showroom, aan de Mijlweg in Dordrecht'],
  ['1.000 m²', 'Zo groot was die eerste showroom'],
  ['3', 'Vestigingen in West-Nederland in 2016'],
  ['Duizenden', 'Maatwerk meubels in Nederland en België'],
];

const hoofdstukken = [
  { id: '2007', jaar: '2007', kop: 'De start aan de Mijlweg', foto: pandDordrecht, pos: 'object-[50%_50%]', alt: 'Het pand van Teakhuis aan de Mijlweg in Dordrecht, met op de ramen Teakmeubelen voor uw hele huis, maatwerk zonder meerprijs', bij: 'Het pand aan de Mijlweg in Dordrecht',
    tekst: ['In juli 2007 opent Teakhuis een showroom van 1.000 m² aan de Mijlweg in Dordrecht. Met teakhouten meubels en antieke Chinese meubelen.', 'Vanaf de eerste dag kun je een ontwerp laten aanpassen aan je eigen wensen, zonder meerprijs. Dat was toen uitzonderlijk, en het werd een groot succes.'] },
  { id: '2009', jaar: '2009–2013', kop: 'Sterk door moeilijke jaren', foto: eettafel, pos: 'object-[45%_55%]', alt: 'Teakhouten eettafel met een gestoffeerde bank en stoelen in de showroom', bij: 'In de showroom',
    tekst: ['Voor veel bedrijven in de meubelbranche zijn dit zware jaren. Teakhuis komt er goed doorheen, dankzij de focus op kwaliteit, service en meubels die je nergens anders vindt.'] },
  { id: '2014', jaar: '2014', kop: 'Een tweede vestiging in Leiderdorp', foto: pandLeiderdorp, pos: 'object-[50%_50%]', alt: 'De ingang van Teakhuis op het Meubelplein Leiderdorp, met teakhouten tuinmeubelen voor de deur', bij: 'Op het Meubelplein Leiderdorp',
    tekst: ['Als de markt herstelt, opent Teakhuis een vestiging op het Meubelplein in Leiderdorp.', 'De collectie groeit met houten meubels uit India. Nieuw gemaakt, en gemaakt van antieke deuren. Alles zelf uitgezocht, ingekocht en geïmporteerd.'] },
  { id: '2016', jaar: '2016', kop: 'Drie locaties', foto: hemelbed, pos: 'object-[40%_50%]', alt: 'Teakhouten hemelbed met witte doeken en een nachtkastje in de showroom', bij: 'Showroom, 2016',
    tekst: ['In Roosendaal komt er een winkel met een groot magazijn bij. Nu zijn er drie grote locaties in West-Nederland om meubels te bekijken en op maat te bestellen.', 'Met een eigen bezorgdienst, meubelmakers, ontwerpers en verkopers doet Teakhuis alles in eigen beheer, door vakmensen.'] },
  { id: '2018', jaar: '2018–2019', kop: 'Terug naar de kern', foto: woonkamer, pos: 'object-[55%_60%]', alt: 'Woonkamer in de showroom met een teakhouten salontafel en een wandkast', bij: 'In de showroom',
    tekst: ['Door een tekort aan goed personeel in de branche wordt de druk op de medewerkers te groot. Han besluit Leiderdorp en Roosendaal te sluiten.', 'Een jaar later volgt Dordrecht, door veranderingen op de meubelboulevard. Achteraf blijkt dat de stap naar een nieuwe manier van werken.'] },
  { id: '2020', jaar: 'Sinds 2020', kop: 'Online, en direct met de makers', foto: werkplaats, pos: 'object-[50%_55%]', alt: 'Grote werkplaats met werkbanken, stapels teakhout en meubelmakers aan het werk', bij: 'In de werkplaats in Indonesië',
    tekst: ['Tijdens de zoektocht naar een nieuwe locatie komt corona. Met de website, telefonisch advies en de eigen bezorgbus blijft Teakhuis gewoon bereikbaar. Klanten blijken geen showroom nodig te hebben.', 'Zonder winkels zijn de kosten veel lager. Zelfs toen hout en containertransport hard duurder werden, bleven de prijzen gelijk. En Han heeft meer tijd om de meubelmakers in Indonesië te begeleiden en de kwaliteit te controleren.'] },
];

const voordelen = ['Hoogwaardige kwaliteit', 'Duurzaam Indonesisch teakhout', 'Persoonlijke begeleiding', 'Maatwerk zonder standaard meerprijs', 'Scherpe prijzen door lage kosten'];

const vragen: [string, string][] = [
  ['Wanneer is Teakhuis Dordrecht opgericht?', 'Teakhuis Dordrecht opende zijn deuren in juli 2007 aan de Mijlweg in Dordrecht.'],
  ['Waar stond de eerste showroom van Teakhuis Dordrecht?', 'De eerste showroom stond aan de Mijlweg in Dordrecht en was ongeveer 1.000 m² groot.'],
  ['Waar komen de meubels van Teakhuis vandaan?', 'De teakhouten meubels worden met de hand gemaakt door gespecialiseerde meubelmakers in Indonesië. Vroeger importeerde Teakhuis ook unieke meubels uit India.'],
  ['Biedt Teakhuis nog steeds maatwerk aan?', 'Ja, maatwerk is nog altijd de kern van het bedrijf. Je kunt een meubel helemaal laten aanpassen aan je eigen wensen, zonder standaard meerprijs.'],
  ['Waarom heeft Teakhuis geen showroom meer?', 'Na het sluiten van de vestigingen in 2018 en 2019 is gekozen voor een efficiëntere manier van werken. Advies, ontwerp en verkoop gaan online en telefonisch. Zo ligt de focus helemaal op kwaliteit, service en scherpe prijzen.'],
];

const pagina = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: titel,
  description: omschrijving,
  inLanguage: 'nl-NL',
  url: absoluut('over-ons/'),
  about: { '@id': `${absoluut('')}#organisatie` },
};
---
<Base title={titel} description={omschrijving} schema={[pagina, vragenSchema(vragen), kruimelSchema([['Over ons']], absoluut('over-ons/'))]}>
  <Kop />
  <main id="inhoud">

    <!-- HERO: volledig foto, de showroom zoals klanten hem kenden -->
    <InfoHero foto={heroFoto} pos="object-[60%_55%]" label="Over Teakhuis Dordrecht" titel="Sinds 2007 gespecialiseerd in teak" id="over-kop">
      <p class="mt-5 max-w-xl text-lg text-wit/85">Van een showroom van 1.000 m² in Dordrecht naar een bedrijf zonder winkel, met dezelfde aandacht voor elk meubel. Dit is het verhaal.</p>
      <a href="#tijdlijn" class="mt-7 inline-flex items-center gap-3 font-kop text-sm font-bold text-wit no-underline">
        <span class="grid h-11 w-11 place-items-center rounded-full ring-1 ring-wit/40 transition-colors hover:bg-wit/10"><Icoon naam="pijl" class="h-4 w-4 rotate-90" /></span>
        Lees het verhaal
      </a>
    </InfoHero>

    <!-- Intro met de feiten uit Hans tekst -->
    <section class="wrap py-16 md:py-24">
      <Kruimel stappen={[['Over ons']]} />
      <div class="mt-12 grid grid-cols-1 gap-y-8 lg:mt-16 lg:grid-cols-12 lg:items-end lg:gap-x-12">
        <!-- Twee tinten: de eerste helft is het begin, de tweede helft waar het naartoe groeide -->
        <p class="font-kop text-[clamp(1.7rem,2.4vw+.9rem,3.1rem)] font-semibold leading-[1.12] tracking-[-.02em] [font-stretch:100%] lg:col-span-8">
          Wat begon als een showroom in Dordrecht, <span class="text-grijs/80">groeide uit tot een bekende naam in Nederland en België voor maatwerk meubels van duurzaam teakhout.</span>
        </p>
        <div class="lg:col-span-3 lg:col-start-10 lg:pb-2">
          <p class="text-grijs">Vakmanschap, persoonlijke service en maatwerk zonder meerprijs. Daar draait het om, al vanaf de eerste dag.</p>
          <a href="#tijdlijn" class="mt-5 inline-flex items-center gap-2 font-kop text-sm font-bold text-inkt underline decoration-blad decoration-2 underline-offset-[6px] hover:text-blad-diep">Naar de tijdlijn<Icoon naam="pijl" class="h-4 w-4 rotate-90" /></a>
        </div>
      </div>

      <!-- Feiten als één rustige strook, gescheiden door dunne lijnen in plaats van losse blokjes -->
      <dl class="mt-16 grid grid-cols-1 border-t border-lijn-2 sm:grid-cols-2 lg:mt-20 lg:grid-cols-4">
        {cijfers.map(([c, t], i) => (
          <div class:list={['flex items-baseline justify-between gap-6 border-b border-lijn py-6 sm:block sm:py-8 lg:border-b-0 lg:px-6 lg:first:pl-0 lg:last:pr-0', i % 2 === 1 && 'sm:border-l sm:pl-8', i > 0 && 'lg:border-l', i === 2 && "lg:pl-6"]}>
            <dt class="num whitespace-nowrap font-kop text-[clamp(1.75rem,1.5vw+1rem,2.75rem)] font-extrabold leading-none tracking-[-.03em]">{c}</dt>
            <dd class="max-w-[14rem] text-right text-sm text-grijs sm:mt-4 sm:text-left">{t}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- TIJDLIJN -->
    <section id="tijdlijn" class="bg-wit pb-20 md:pb-28" aria-labelledby="tijdlijn-kop" data-tijdlijn>
      <div class="wrap pt-20 md:pt-28">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="label text-blad-diep">Tijdlijn</p>
            <h2 id="tijdlijn-kop" class="mt-3 text-4xl">Bijna twintig jaar Teakhuis.</h2>
          </div>
          <p class="max-w-sm text-grijs">Scroll door de jaren, of kies een jaartal.</p>
        </div>
      </div>

      <!-- Jaartallen: blijven bovenaan staan tijdens het scrollen en laten zien waar je bent -->
      <nav class="tl-nav sticky top-[4.6rem] z-20 mt-10 border-y border-lijn bg-wit/95 backdrop-blur-sm lg:top-[5.4rem]" aria-label="Jaartallen">
        <ol class="wrap flex gap-1 overflow-x-auto py-2.5 [scrollbar-width:none]">
          {hoofdstukken.map((h) => (
            <li class="flex-none"><a href={`#j-${h.id}`} class="tl-jaar num block whitespace-nowrap rounded-full px-4 py-2 font-kop text-sm font-bold no-underline" data-tl-link={h.id}>{h.jaar}</a></li>
          ))}
        </ol>
      </nav>

      <div class="wrap mt-12 grid grid-cols-1 lg:mt-16 lg:grid-cols-12 lg:gap-x-12">
        <!-- Foto die meeloopt (alleen breed scherm). Op mobiel staat de foto bij elk hoofdstuk zelf. -->
        <div class="max-lg:hidden lg:col-span-6">
          <div class="sticky top-[10.5rem] h-[calc(100svh-12.5rem)] max-h-[44rem] overflow-hidden rounded-[var(--radius-md)] bg-zand">
            {hoofdstukken.map((h, i) => (
              <figure class:list={['tl-foto absolute inset-0 m-0', i === 0 && 'is-aan']} data-tl-foto={h.id}>
                <Image src={h.foto} alt={h.alt} quality={76} widths={[640, 960, 1280]} sizes="(min-width: 1344px) 620px, 46vw" loading="lazy" class={`h-full w-full object-cover ${h.pos}`} />
                <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-nacht/85 via-nacht/40 to-transparent px-7 pb-6 pt-24 text-wit">
                  <span class="num block font-kop text-[clamp(3rem,5.5vw,5.5rem)] font-extrabold leading-none tracking-tight">{h.jaar}</span>
                  <span class="mt-2 block text-sm text-wit/80">{h.bij}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>

        <!-- De hoofdstukken, met een lijn die zich vult terwijl je scrolt -->
        <ol class="tl-lijst relative lg:col-span-5 lg:col-start-8" data-tl-lijst>
          <span aria-hidden="true" class="absolute bottom-3 left-[7px] top-3 w-0.5 bg-lijn"></span>
          <span aria-hidden="true" class="tl-vul absolute bottom-3 left-[7px] top-3 w-0.5 origin-top bg-blad"></span>
          {hoofdstukken.map((h) => (
            <li id={`j-${h.id}`} class="tl-stap relative scroll-mt-[9.5rem] pb-16 pl-10 last:pb-0 lg:flex lg:min-h-[62svh] lg:flex-col lg:justify-center lg:pb-0 lg:scroll-mt-[11rem]" data-tl-stap={h.id}>
              <span aria-hidden="true" class="tl-punt absolute left-0 top-1.5 h-4 w-4 rounded-full border-2 border-lijn-2 bg-wit lg:top-1/2 lg:-mt-2"></span>
              <div>
                <p class="num font-kop text-lg font-extrabold text-blad-diep">{h.jaar}</p>
                <h3 class="mt-2 text-3xl">{h.kop}</h3>
                <div class="mt-4 space-y-4 text-lg text-grijs">
                  {h.tekst.map((t) => <p>{t}</p>)}
                </div>
                <figure class="mt-7 lg:hidden">
                  <Image src={h.foto} alt={h.alt} quality={74} widths={[400, 640, 900]} sizes="(min-width: 640px) 80vw, 88vw" loading="lazy" class={`aspect-[4/3] w-full rounded-[var(--radius-md)] object-cover ${h.pos}`} />
                  <figcaption class="mt-2.5 text-xs text-grijs">{h.bij}</figcaption>
                </figure>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Hoe het nu werkt: Han als aanspreekpunt -->
    <section class="bg-nacht py-20 text-wit md:py-28" aria-labelledby="nu-kop">
      <div class="wrap grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:items-center lg:gap-x-12">
        <figure class="lg:col-span-4">
          <Image src={han} alt="Han Rietdijk, eigenaar van Teakhuis" quality={80} widths={[360, 540, 720]} sizes="(min-width: 1024px) 30vw, 70vw" class="aspect-[4/5] w-full max-w-[20rem] rounded-[var(--radius-md)] object-cover object-[50%_20%]" />
        </figure>
        <div class="lg:col-span-7 lg:col-start-6">
          <p class="label text-blad-licht">Teakhuis nu</p>
          <h2 id="nu-kop" class="mt-3 text-4xl">Eén aanspreekpunt, van idee tot bezorging.</h2>
          <p class="mt-6 max-w-2xl text-lg text-as">Han Rietdijk is eigenaar, adviseur en bezorger. Hij werkt rechtstreeks met de meubelmakers in Indonesië en gaat twee keer per jaar zelf langs om de productie te controleren. Jij krijgt advies op maat, met foto's en tekeningen, gebaseerd op bijna twintig jaar ervaring en tienduizenden klanten die je voorgingen.</p>
          <ul class="mt-8 max-w-xl">
            {voordelen.map((v) => <li class="flex items-center gap-3 border-t border-lijn-d py-3.5"><Icoon naam="vink" class="h-4 w-4 flex-none text-blad-licht" />{v}</li>)}
          </ul>
          <div class="mt-10 flex flex-col gap-3 sm:flex-row">
            <a href={waHoi} class="knop knop-blad"><Icoon naam="wa" />App Han</a>
            <a href={site.telHref} class="knop knop-wit"><span class="num">{site.tel}</span></a>
          </div>
        </div>
      </div>
    </section>

    <section id="referenties" class="py-20 md:py-28" aria-labelledby="ref-kop">
      <div class="wrap">
        <div class="grid grid-cols-1 gap-y-6 lg:grid-cols-12 lg:items-end lg:gap-x-12">
          <h2 id="ref-kop" class="text-4xl lg:col-span-6">Wat klanten zeggen.</h2>
          <p class="text-lg text-grijs lg:col-span-5 lg:col-start-8">Een tafel, tv-meubel, dressoir of boekenkast, of een helemaal eigen ontwerp. Maatwerk, kwaliteit en persoonlijke aandacht, net als in 2007.</p>
        </div>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {reviews.map((r) => <li class="flex"><ReviewKaart review={r} class="w-full" /></li>)}
        </ul>
        <div class="mt-12 flex flex-col gap-3 sm:flex-row">
          <a href={url('webshop/')} class="knop knop-blad">Bekijk de collectie<Icoon naam="pijl" /></a>
          <a href={url('maatwerk/')} class="knop knop-rand">Meubel op maat</a>
        </div>
      </div>
    </section>

    <section class="bg-wit py-20 md:py-28" aria-labelledby="vragen-kop">
      <div class="wrap grid grid-cols-1 gap-y-10 lg:grid-cols-12 lg:gap-x-12">
        <h2 id="vragen-kop" class="text-4xl lg:col-span-4">Vaak gevraagd.</h2>
        <Vragen vragen={vragen} class="lg:col-span-7 lg:col-start-6" />
      </div>
    </section>
  </main>
  <Voet />

  <script>
    // Tijdlijn: het hoofdstuk dat het midden van het scherm passeert is actief. Dat bepaalt de foto links, het
    // gemarkeerde jaartal bovenin en hoe ver de groene lijn gevuld is. Zonder JavaScript is alles gewoon leesbaar.
    const tl = document.querySelector<HTMLElement>('[data-tijdlijn]');
    if (tl) {
      tl.classList.add('tl-js');
      const stappen = [...tl.querySelectorAll<HTMLElement>('[data-tl-stap]')];
      const fotos = [...tl.querySelectorAll<HTMLElement>('[data-tl-foto]')];
      const links = [...tl.querySelectorAll<HTMLElement>('[data-tl-link]')];
      const lijst = tl.querySelector<HTMLElement>('[data-tl-lijst]')!;
      const navLijst = tl.querySelector<HTMLElement>('.tl-nav ol');

      const zet = (id: string) => {
        stappen.forEach((s) => s.classList.toggle('is-aan', s.dataset.tlStap === id));
        fotos.forEach((f) => f.classList.toggle('is-aan', f.dataset.tlFoto === id));
        links.forEach((l) => {
          const aan = l.dataset.tlLink === id;
          l.classList.toggle('is-aan', aan);
          if (aan) { l.setAttribute('aria-current', 'step'); } else { l.removeAttribute('aria-current'); }
          // Op mobiel past niet elk jaartal in beeld: schuif het actieve jaartal in zicht, zonder de pagina te verspringen.
          if (aan && navLijst) navLijst.scrollTo({ left: l.offsetLeft - navLijst.clientWidth / 2 + l.clientWidth / 2, behavior: 'smooth' });
        });
      };

      const io = new IntersectionObserver((items) => {
        items.forEach((it) => { if (it.isIntersecting) zet((it.target as HTMLElement).dataset.tlStap!); });
      }, { rootMargin: '-45% 0px -50% 0px' });
      stappen.forEach((s) => io.observe(s));
      zet(stappen[0].dataset.tlStap!);

      let wacht = false;
      const vul = () => {
        wacht = false;
        const r = lijst.getBoundingClientRect();
        const v = Math.min(1, Math.max(0, (innerHeight * 0.5 - r.top) / r.height));
        tl.style.setProperty('--tl-voortgang', v.toFixed(3));
      };
      addEventListener('scroll', () => { if (!wacht) { wacht = true; requestAnimationFrame(vul); } }, { passive: true });
      addEventListener('resize', vul);
      vul();
    }
  </script>
</Base>

<style is:global>
  /* Jaartallen bovenin: het actieve jaar staat donker gevuld. */
  .tl-jaar { color: var(--color-grijs); transition: background-color .3s var(--ease-zacht), color .3s var(--ease-zacht); }
  .tl-jaar:hover { color: var(--color-inkt); background: var(--color-zand); }
  .tl-jaar.is-aan { background: var(--color-inkt); color: var(--color-papier); }

  /* De groene lijn groeit mee met het scrollen. */
  .tl-vul { transform: scaleY(var(--tl-voortgang, 0)); }
  .tl-punt { transition: background-color .35s var(--ease-zacht), border-color .35s var(--ease-zacht), transform .35s var(--ease-zacht); }
  .tl-stap.is-aan .tl-punt { background: var(--color-blad); border-color: var(--color-blad); transform: scale(1.25); }

  /* Op breed scherm vallen de andere hoofdstukken wat terug, zodat je oog bij het actieve jaar blijft. */
  @media (min-width: 1024px) {
    .tl-js .tl-stap > div { opacity: .32; transition: opacity .5s var(--ease-zacht); }
    .tl-js .tl-stap.is-aan > div { opacity: 1; }
  }

  /* Foto's links vloeien in elkaar over, met een heel lichte zoom. */
  .tl-foto { opacity: 0; transition: opacity .8s var(--ease-zacht); }
  .tl-foto.is-aan { opacity: 1; }
  .tl-foto img { transform: scale(1.04); transition: transform 1.6s var(--ease-zacht); }
  .tl-foto.is-aan img { transform: scale(1); }

  @media (prefers-reduced-motion: reduce) {
    .tl-foto img, .tl-foto.is-aan img { transform: none; }
  }
</style>
