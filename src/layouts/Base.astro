---
import '../styles/global.css';
import kopUrl from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import sansUrl from '@fontsource-variable/mulish/files/mulish-latin-wght-normal.woff2?url';
import { site, url, absoluut } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Absolute URL van de deelafbeelding; standaard de algemene og.jpg. */
  ogImage?: string;
  ogType?: 'website' | 'product';
  /** Extra structured data (JSON-LD), bijvoorbeeld Product of BreadcrumbList. */
  schema?: object[];
  noindex?: boolean;
}
const { title, description, ogImage, ogType = 'website', schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;

// Organisatie op elke pagina: geen winkeladres (geen showroom meer), wel telefoon, mail en sociale profielen.
const organisatie = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${absoluut('')}#organisatie`,
  name: site.bv,
  alternateName: site.naam,
  url: absoluut(''),
  logo: absoluut('logo.png'),
  email: site.mail,
  telephone: site.telHref.replace('tel:', ''),
  foundingDate: '2007',
  sameAs: [site.facebook, site.instagram, site.pinterest].filter(Boolean),
  contactPoint: { '@type': 'ContactPoint', telephone: site.telHref.replace('tel:', ''), email: site.mail, contactType: 'customer service', availableLanguage: 'Dutch' },
};
const jsonld = [organisatie, ...schema];
const robots = noindex || site.voorstel ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!site.voorstel && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="apple-touch-icon" href={url('logo.png')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <link rel="preload" as="font" type="font/woff2" href={kopUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={sansUrl} crossorigin />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage ?? absoluut('og.jpg')} />
    {!ogImage && <meta property="og:image:width" content="1200" />}
    {!ogImage && <meta property="og:image:height" content="630" />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.naam} />
    <meta name="twitter:card" content="summary_large_image" />
    {!site.voorstel && <script type="application/ld+json" set:html={JSON.stringify(jsonld.length === 1 ? jsonld[0] : jsonld).replace(/</g, '\\u003c')} />}
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="min-h-dvh pb-14 md:pb-0">
    {site.voorstel && (
      <div class="relative z-50 bg-inkt text-wit">
        <p class="wrap py-2 text-xs font-medium leading-snug" style="font-family: system-ui, sans-serif">
          Ontwerpvoorstel van Sitefront voor {site.naam}. Dit is niet de officiële website.{" "}
          <a href="https://www.sitefront.nl" class="font-bold text-blad-licht underline underline-offset-2">sitefront.nl</a>
        </p>
      </div>
    )}
    <a href="#inhoud" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-sm focus:bg-wit focus:px-4 focus:py-2 focus:text-inkt">Naar de inhoud</a>
    <slot />
    <script>
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -6% 0px' });
      document.querySelectorAll('.rijs').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
